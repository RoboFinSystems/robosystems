    {
      "@id": "rs-gaap:BankOverdrafts",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:N023514b1a66d4756a00c367b25ebb0b2"
        },
        {
          "@id": "_:Na356a8e654bb4bd5a2e916ddeb33f6a7"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Carrying value as of the balance sheet date of payments made in excess of existing cash balances, which will be honored by the bank but reflected as a loan to the entity. Overdrafts generally have a very short time frame for correction or repayment and are therefore more similar to short-term bank financing than trade financing."
        }
