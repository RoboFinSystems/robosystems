      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Interest income derived from securities purchased under agreements to resell. The difference in the price at which the institution buys the securities and resells the securities represents interest for the use of the funds by the other party. Most repurchase and sale agreements involve obligations of the federal government or its agencies, but other financial instruments, such as commercial paper, banker's acceptances and negotiable certificates of deposits are sometimes used in such transactions."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
