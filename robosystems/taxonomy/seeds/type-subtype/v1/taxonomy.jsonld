    {
      "@id": "rs-gaap:PaymentsToAcquireMortgageServicingRightsMSR",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:N316b5b7dfc3e41a3b65568cc78df41a9"
        },
        {
          "@id": "_:N361ae23ecd494852a824f60d96b3b095"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The cash outflow to obtain servicing rights, which contractually entitle the servicer to receive fees and ancillary revenues for performing billing, collection, disbursement and recordkeeping services in connection with a mortgage portfolio. Rights may be obtained via (1) acquisition or assumption of a servicing obligation that does not relate to financial assets of the servicer or its consolidated affiliates; or (2) by originating mortgage loans and then (a) transferring the loans to a Variable Interest Entity (VIE) in a transaction that meets the necessary transfer and classification requirements, or (b) transferring the loans in a transaction that meets the requirements for sale accounting."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Payments to Acquire Mortgage Servicing Rights (MSR)"
        }
