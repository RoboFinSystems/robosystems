    {
      "@id": "rs-gaap:RegulatoryAssetsCurrent",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:N0e893d5ac1a34a7ba121d02f8c195e61"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Carrying amount as of the balance sheet date of capitalized costs of regulated entities that are expected to be recovered through revenue sources within one year or the normal operating cycle, if longer. Such costs are capitalized if they meet both of the following criteria: a. It is probable that future revenue in an amount at least equal to the capitalized cost will result from inclusion of that cost in allowable costs for rate-making purposes. b. Based on available evidence, the future revenue will be provided to permit recovery of the previously incurred cost rather than to provide for expected levels of similar future costs. If the revenue will be provided through an automatic rate-adjustment clause, this criterion requires that the regulator's intent clearly be to permit recovery of the previously incurred cost."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Regulatory Assets, Current"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/balance": [
        {
          "@value": "debit"
        }
      ],
      "https://robosystems.ai/vocab/classification": [
        {
          "@value": "asset"
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/periodType": [
        {
          "@value": "instant"
        }
      ],
