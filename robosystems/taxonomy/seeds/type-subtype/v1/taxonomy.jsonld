      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of a decommissioning liability associated with a legal obligation that a firm incurs when it constructs or operates an asset that must eventually be withdrawn from active service. This may include operating assets such as nuclear power plants or shipping vessels."
