    {
      "@id": "rs-gaap:ExtendedProductWarrantyAccrualCurrent",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:Ncad7fa9e73df48e0ab04b702914620e7"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount at end of the reporting period of the aggregate extended product warranty liability that is expected to be paid within one year of the balance sheet date or normal operating cycle, if longer. Does not include the balance for the standard product warranty liability."
        }
      ],
