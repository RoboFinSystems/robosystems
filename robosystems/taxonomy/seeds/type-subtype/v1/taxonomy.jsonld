        {
          "@id": "_:Nf7efa8b2775f455287bc325d883f3fd4"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The adjustment to expense previously capitalized costs of drilling exploratory wells when proved reserves are not found or when the entity obtains information that raises substantial doubt about the economic or operational viability of the project."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Exploration Abandonment and Impairment Expense"
        }
      ],
