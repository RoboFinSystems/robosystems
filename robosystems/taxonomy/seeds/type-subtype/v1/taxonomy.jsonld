        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Sum of the carrying values as of the balance sheet date of (a) interest payable on all forms of debt, including trade payables, that has been incurred, and (b) dividends declared but unpaid on equity securities issued by the entity and outstanding (also includes dividends collected on behalf of another owner of securities that are being held by the entity). Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer)."
        }
      ],
