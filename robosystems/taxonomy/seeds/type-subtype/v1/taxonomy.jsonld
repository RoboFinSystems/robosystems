    {
      "@id": "rs-gaap:BusinessDevelopment",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:N676f1f2c182a479a8e578c2d14f52b76"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Business development involves the development of products and services, their delivery, design and their implementation. Business development includes a number of techniques designed to grow an economic enterprise. Such techniques include, but are not limited to, assessments of marketing opportunities and target markets, intelligence gathering on customers and competitors, generating leads for possible sales, follow-up sales activity, formal proposal writing and business model design. Business development involves evaluating a business and then realizing its full potential, using such tools as marketing, sales, information management and customer service."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Business Development"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/balance": [
        {
          "@value": "debit"
        }
      ],
      "https://robosystems.ai/vocab/classification": [
        {
          "@value": "outflow"
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/periodType": [
        {
          "@value": "duration"
        }
      ],
      "https://robosystems.ai/vocab/source": [
        {
          "@value": "rs-gaap"
        }
      ],
      "https://robosystems.ai/vocab/substitutionGroup": [
        {
          "@id": "xbrli:item"
        }
      ]
    },
    {
      "@id": "rs-gaap:BusinessExitCosts1",
