      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Broker-dealers often use other brokers to execute trades on their behalf. The trading broker-dealer becomes a customer of the executing broker-dealer and pays a floor brokerage fee. Such fees are paid periodically either directly to the executing broker-dealer or through a clearing house."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
