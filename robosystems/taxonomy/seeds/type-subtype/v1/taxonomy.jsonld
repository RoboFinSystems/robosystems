    {
      "@id": "rs-gaap:ExplorationAbandonmentAndImpairmentExpense",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:N329e26bc561a4be7b580eb626ca95f6c"
        },
        {
          "@id": "_:N7d23c3cbbe38444ba35702a3ffe0484a"
