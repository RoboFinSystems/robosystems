    {
      "@id": "rs-gaap:RecoveryStrandedCosts",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:N141276535fef480aacf33a8a7e71f6ac"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from billings to utility customers to recover what are also referred to as stranded assets or stranded investments. These are assets that formerly regulated utilities with monopolies on local service are allowed to recover during their transition to deregulated suppliers in competitive markets. Essentially, these investments are sunk costs, made by utilities under the old regulated system, which might not be recovered in a truly competitive marketplace. However, since they were valid investments at the time, the utilities are allowed to recover these costs from customers (for example, an investment in electrical generation assets that may not be recouped if customers are now allowed to purchase electricity from another utility)."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Recovery Stranded Costs"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
