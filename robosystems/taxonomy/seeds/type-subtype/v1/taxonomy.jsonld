        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The amount of excise and sales taxes included in sales and revenues, which are then deducted as a cost of sales. Includes excise taxes, which are applied to specific types of transactions or items (such as gasoline or alcohol); and sales, use and value added taxes, which are applied to a broad class of revenue-producing transactions involving a wide range of goods and services."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Excise and Sales Taxes"
