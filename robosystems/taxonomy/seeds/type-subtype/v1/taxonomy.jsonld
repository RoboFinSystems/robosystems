      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of expenses associated with exit or disposal activities pursuant to an authorized plan. Includes, but is not limited to, one-time termination benefits, termination of an operating lease or other contract, consolidating or closing facilities, and relocating employees, and termination benefits associated with an ongoing benefit arrangement. Excludes expenses associated with special or contractual termination benefits, a discontinued operation or an asset retirement obligation."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Business Exit Costs"
        }
      ],
