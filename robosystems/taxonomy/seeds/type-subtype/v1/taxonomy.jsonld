    {
      "@id": "rs-gaap:ConstructionLoan",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:Nff67e1054443437c8bb861ec9c742d0c"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "This element represents the carrying value of a short-term real estate loan to finance building costs. The funds are disbursed as needed or in accordance with a prearranged plan; generally, a portion of the funds is disbursed at inception and the remainder as construction progresses. The money is repaid on completion of the project, usually from the proceeds of a mortgage loan. The rate is normally higher than the prime rate, and there is usually an origination fee. The effective yield on these loans tends to be high, and the lender has a security interest in the real property. Note that there are separate concepts for the current and noncurrent portions of long-term construction loans."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Construction Loan"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/balance": [
        {
          "@value": "credit"
        }
      ],
      "https://robosystems.ai/vocab/classification": [
        {
          "@value": "liability"
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/source": [
        {
          "@value": "rs-gaap"
        }
      ],
      "https://robosystems.ai/vocab/substitutionGroup": [
        {
          "@id": "xbrli:item"
        }
      ]
    },
    {
      "@id": "rs-gaap:ConstructionLoanNoncurrent",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:N6d3905259c6d4d2b808d11395017fb49"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "This element represents the noncurrent portion of a long-term real estate loan to finance building costs. The funds are disbursed as needed or in accordance with a prearranged plan; generally, a portion of the funds is disbursed at inception and the remainder as construction progresses. The money is repaid on completion of the project (generally one to seven years), usually from the proceeds of a mortgage loan. The rate is normally higher than the prime rate, and there is usually an origination fee. The effective yield on these loans tends to be high, and the lender has a security interest in the real property."
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Long-term Construction Loan, Noncurrent"
        }
      ],
