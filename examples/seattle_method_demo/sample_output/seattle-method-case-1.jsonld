et_id\": \"fs_01KSTPTS1G8REDBQAXHWE7DNBZ\", \"id\": \"fact_01KSTPTS1NDGB0QV2HCVDMCDNW\", \"period_end\": \"2024-03-31\", \"period_start\": \"2024-01-01\", \"period_type\": \"instant\", \"unit\": \"USD\", \"value\": 2400.0}, {\"element_id\": \"0fc9ab7e-c5ce-5277-9530-344cc127fe26\", \"element_name\": \"Assets, Current\", \"element_qname\": \"rs-gaap:AssetsCurrent\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01KSTPTS1G8REDBQAXHWE7DNBZ\", \"id\": \"fact_01KSTPTS1NDGB0QV2HCVDMCDNX\", \"period_end\": \"2024-03-31\", \"period_start\": \"2024-01-01\", \"period_type\": \"instant\", \"unit\": \"USD\", \"value\": 13550.0}, {\"element_id\": \"841cedeb-4cb0-532a-b0bd-c34846a13a8c\", \"element_name\": \"Assets, Noncurrent\", \"element_qname\": \"rs-gaap:AssetsNoncurrent\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01KSTPTS1G8REDBQAXHWE7DNBZ\", \"id\": \"fact_01KSTPTS1NDGB0QV2HCVDMCDNY\", \"period_end\": \"2024-03-31\", \"period_start\": \"2024-01-01\", \"period_type\": \"instant\", \"unit\": \"USD\", \"value\": 900.0}, {\"element_id\": \"30b2801e-e682-5298-82e6-3670e1d508f1\", \"element_name\": \"Liabilities and Equity\", \"element_qname\": \"rs-gaap:LiabilitiesAndStockholdersEquity\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01KSTPTS1G8REDBQAXHWE7DNBZ\", \"id\": \"fact_01KSTPTS1NDGB0QV2HCVDMCDP3\", \"period_end\": \"2024-03-31\", \"period_start\": \"2024-01-01\", \"period_type\": \"instant\", \"unit\": \"USD\", \"value\": 14450.0}, {\"element_id\": \"e3796201-9899-5b7b-9477-659550ba8e68\", \"element_name\": \"StockholdersEquity\", \"element_qname\": \"rs-gaap:StockholdersEquity\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01KSTPTS1G8REDBQAXHWE7DNBZ\", \"id\": \"fact_01KSTPTS1NDGB0QV2HCVDMCDP5\", \"period_end\": \"2024-03-31\", \"period_start\": \"2024-01-01\", \"period_type\": \"instant\", \"unit\": \"USD\", \"value\": 12050.0}], \"id\": \"b6dfb8d2-8ee9-5597-9a3b-8aeee625ff0d\", \"information_model\": {\"concept_arrangement\": \"arithmetic\", \"member_arrangement\": \"whole_part\"}, \"name\": \"rs-gaap \\u2014 Balance Sheet \\u2014 Classified\", \"rules\": [{\"id\": \"0fe05383-73b9-5d45-82b8-87ed45103f8d\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$AssetsCurrent = ($CashCashEquivalentsAndShortTermInvestments + $ReceivablesNetCurrent + $InventoryNetOfAllowancesCustomerAdvancesAndProgressBillings + $PrepaidExpenseCurrent + $RestrictedCashAndInvestmentsCurrent + $OtherAssetsCurrent)\", \"rule_message\": \"Calculation rollup: rs-gaap:AssetsCurrent = \\u03a3 rs-gaap current-asset leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"0fc9ab7e-c5ce-5277-9530-344cc127fe26\"}, \"rule_variables\": [{\"variable_name\": \"AssetsCurrent\", \"variable_qname\": \"rs-gaap:AssetsCurrent\"}, {\"variable_name\": \"CashCashEquivalentsAndShortTermInvestments\", \"variable_qname\": \"rs-gaap:CashCashEquivalentsAndShortTermInvestments\"}, {\"variable_name\": \"ReceivablesNetCurrent\", \"variable_qname\": \"rs-gaap:ReceivablesNetCurrent\"}, {\"variable_name\": \"InventoryNetOfAllowancesCustomerAdvancesAndProgressBillings\", \"variable_qname\": \"rs-gaap:InventoryNetOfAllowancesCustomerAdvancesAndProgressBillings\"}, {\"variable_name\": \"PrepaidExpenseCurrent\", \"variable_qname\": \"rs-gaap:PrepaidExpenseCurrent\"}, {\"variable_name\": \"RestrictedCashAndInvestmentsCurrent\", \"variable_qname\": \"rs-gaap:RestrictedCashAndInvestmentsCurrent\"}, {\"variable_name\": \"OtherAssetsCurrent\", \"variable_qname\": \"rs-gaap:OtherAssetsCurrent\"}]}, {\"id\": \"17e0664f-13a1-52bf-82a0-14b9ab2c23a7\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$LiabilitiesCurrent = ($AccountsPayableAndAccruedLiabilitiesCurrent + $DebtCurrent + $DeferredRevenueCurrent + $FinanceLeaseLiabilityCurrent + $OtherLiabilitiesCurrent)\", \"rule_message\": \"Calc