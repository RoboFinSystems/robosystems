2014 Multi-step\", \"rules\": [{\"id\": \"046e4f9b-1b4b-5288-a850-7375a746d858\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$Revenues = ($SalesRevenueNet + $RevenueFromContractWithCustomerExcludingAssessedTax + $OtherSalesRevenueNet)\", \"rule_message\": \"Calculation rollup: rs-gaap:Revenues = \\u03a3 rs-gaap revenue leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"b26a6cd4-072f-5bf2-b5d3-ebf928150d6c\"}, \"rule_variables\": [{\"variable_name\": \"Revenues\", \"variable_qname\": \"rs-gaap:Revenues\"}, {\"variable_name\": \"SalesRevenueNet\", \"variable_qname\": \"rs-gaap:SalesRevenueNet\"}, {\"variable_name\": \"RevenueFromContractWithCustomerExcludingAssessedTax\", \"variable_qname\": \"rs-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"}, {\"variable_name\": \"OtherSalesRevenueNet\", \"variable_qname\": \"rs-gaap:OtherSalesRevenueNet\"}]}, {\"id\": \"3562e6a7-70dd-544f-9828-cc9cbbcca802\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$IncomeLossFromContinuingOperations = ($IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest - $IncomeTaxExpenseBenefit)\", \"rule_message\": \"Calculation rollup: rs-gaap:IncomeLossFromContinuingOperations = PreTax \\u2212 IncomeTaxExpenseBenefit\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"d60cabda-7060-5aff-ac98-96371606a738\"}, \"rule_variables\": [{\"variable_name\": \"IncomeLossFromContinuingOperations\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperations\"}, {\"variable_name\": \"IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\"}, {\"variable_name\": \"IncomeTaxExpenseBenefit\", \"variable_qname\": \"rs-gaap:IncomeTaxExpenseBenefit\"}]}, {\"id\": \"4fdf61ff-ec5d-5cb2-8bcd-aa584ad2e768\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NetIncomeLoss = ($IncomeLossFromContinuingOperations + $IncomeLossFromDiscontinuedOperationsNetOfTax)\", \"rule_message\": \"Calculation rollup: rs-gaap:NetIncomeLoss = ContinuingOps + DiscontinuedOps\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"27a05717-2370-51c2-a924-db5cbcb48219\"}, \"rule_variables\": [{\"variable_name\": \"NetIncomeLoss\", \"variable_qname\": \"rs-gaap:NetIncomeLoss\"}, {\"variable_name\": \"IncomeLossFromContinuingOperations\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperations\"}, {\"variable_name\": \"IncomeLossFromDiscontinuedOperationsNetOfTax\", \"variable_qname\": \"rs-gaap:IncomeLossFromDiscontinuedOperationsNetOfTax\"}]}, {\"id\": \"88fc21c3-fc0b-5260-a21e-1795409583c6\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$CostOfRevenue = ($CostOfGoodsSold + $CostOfGoodsSoldExcludingDepreciationDepletionAndAmortization + $OtherCostOfOperatingRevenue)\", \"rule_message\": \"Calculation rollup: rs-gaap:CostOfRevenue = \\u03a3 rs-gaap COGS leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"12ab7417-5324-55d6-946e-2456adba47c5\"}, \"rule_variables\": [{\"variable_name\": \"CostOfRevenue\", \"variable_qname\": \"rs-gaap:CostOfRevenue\"}, {\"variable_name\": \"CostOfGoodsSold\", \"variable_qname\": \"rs-gaap:CostOfGoodsSold\"}, {\"variable_name\": \"CostOfGoodsSoldExcludingDepreciationDepletionAndAmortization\", \"variable_qname\": \"rs-gaap:CostOfGoodsSoldExcludingDepreciationDepletionAndAmortization\"}, {\"variable_name\": \"OtherCostOfOperatingRevenue\", \"variable_qname\": \"rs-gaap:OtherCostOfOperatingRevenue\"}]}, {\"id\": \"91fdb039-2159-57e2-8132-8df360fb3ea5\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest = ($OperatingIncomeLoss + $NonoperatingIncomeExpense)\", \"rule_message\": \"Calculation rollup: rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxes... = OperatingIncomeLoss + NonoperatingIncomeExpense \\u2212 InterestExpense\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"6b0b414f-0c76-54f0-8e51-cf53db59ca24\"}, \"rule_variables\": [{\"variable_name\": \"IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\"}, {\"variable_name\": \"OperatingIncomeLoss\", \"variable_qname\": \"rs-gaap:OperatingIncomeLoss\"}, {\"variable_name\": \"NonoperatingIncomeExpense\", \"variable_qname\": \"rs-gaap:NonoperatingIncomeExpense\"}]}, {\"id\": \"9e6a9650-1c9d-5134-87a8-01b7b010f172\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NonoperatingIncomeExpense = ($InvestmentIncomeInterest - $InterestExpense + $GainLossOnDispositionOfAssets + $OtherNonoperatingIncomeExpense)\", \"rule_message\": \"Calculation rollup: rs-gaap:NonoperatingIncomeExpense = \\u03a3 rs-gaap nonoperating leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"45aae2c2-fa56-50c9-b381-df8079e7d33a\"}, \"rule_variables\": [{\"variable_name\": \"NonoperatingIncomeExpense\", \"variable_qname\": \"rs-gaap:NonoperatingIncomeExpens