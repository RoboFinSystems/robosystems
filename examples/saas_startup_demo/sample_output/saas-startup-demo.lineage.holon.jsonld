        {
          "@id": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/fact/fact_01M8AB2EQVV1V23EM5JBBXK082",
          "@type": "rs:Fact",
          "decimals": "2",
          "element": "rs-gaap:Assets",
          "entity": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/entity/entity_kg1a1d0c09e514a19adf0f",
          "factSet": "https://robosystems.ai/factset/fs_01M8AB2ENF8E3Q2MVWB764GBGG",
          "factType": "numeric",
          "internalId": "fact_01M8AB2EQVV1V23EM5JBBXK082",
          "numericValue": "2897577.38",
          "period": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/period/p_2",
          "prov:wasAttributedTo": {
            "@id": "rollup:calculation"
          },
          "rs:sourceKind": "rollup",
          "structure": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/structure/b6dfb8d2-8ee9-5597-9a3b-8aeee625ff0d",
          "unit": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/unit/u_USD"
        },
        {
          "@id": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/fact/fact_01M8AB2ER5N79YS1NARMV5MDJK",
          "@type": "rs:Fact",
          "element": "cadence:RevenueRecognitionPolicyTextBlock",
          "entity": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/entity/entity_kg1a1d0c09e514a19adf0f",
          "factSet": "https://robosystems.ai/factset/fs_01M8AB2ER3MWK9KVB8W1PC3PT0",
          "factType": "nonnumeric",
          "internalId": "fact_01M8AB2ER5N79YS1NARMV5MDJK",
          "language": "en",
          "period": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/period/p_3",
          "stringValue": "<h1>Revenue Recognition Policy — Cadence Labs, Inc.</h1>\n<h2>Standard</h2>\n<p>Revenue is recognized under ASC 606 as the performance obligation is satisfied.</p>\n<h2>Subscriptions (annual, prepaid)</h2>\n<ul>\n<li>Customers sign annual contracts and pay the full year up front.</li>\n<li>Cash collected is recorded as <strong>Deferred Revenue (2300)</strong>, a current liability.</li>\n<li>Revenue is recognized <strong>ratably</strong> over the 12-month term: DR Deferred Revenue / CR Subscription Revenue (4000) each month.</li>\n<li>The deferred-revenue balance equals contracts billed but not yet delivered. It is a source of working-capital &quot;float&quot; — cash in hand that finances operations but is owed as future service.</li>\n</ul>\n<h2>Professional Services</h2>\n<ul>\n<li>Onboarding/implementation is billed net-30 and recognized as delivered: DR AR (1100) / CR Professional Services (4100).</li>\n</ul>\n<h2>Why it matters for runway</h2>\n<p>Because subscriptions are prepaid, cash collected can exceed revenue recognized while the business grows — softening the cash burn. That float is a liability, not equity. When assessing how long the company can operate, subtract deferred revenue from cash before dividing by the burn.</p>",
          "structure": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/structure/struct_01M8AB1Q2MATN21Z6KD8G06V62"
        },
        {
          "@id": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/fact/fact_01M8AB2ER5N79YS1NARMV5MDJM",
          "@type": "rs:Fact",
          "element": "cadence:OperatingExpensePolicyTextBlock",
          "entity": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/entity/entity_kg1a1d0c09e514a19adf0f",
          "factSet": "https://robosystems.ai/factset/fs_01M8AB2ER3MWK9KVB8W1PC3PT0",
          "factType": "nonnumeric",
          "internalId": "fact_01M8AB2ER5N79YS1NARMV5MDJM",
          "language": "en",
          "period": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/period/p_3",
          "stringValue": "<h1>Operating Expense &amp; Burn Policy — Cadence Labs, Inc.</h1>\n<h2>Expense classification (by function)</h2>\n<p>| Function | Account | Includes |\n|---|---|---|\n| Cost of Revenue | 5000 | Cloud hosting, customer support |\n| Research &amp; Development | 6000 | Engineering salaries, product development |\n| Sales &amp; Marketing | 6100 | Sales team, commissions, advertising |\n| General &amp; Administrative | 6200 / 6300 / 6400 | Admin, finance, legal, rent, software tools |</p>\n<p>R&amp;D is expensed as incurred (no internal-use software capitalization in this policy).</p>\n<h2>Depreciation &amp; Prepaids</h2>\n<p>Straight-line. Equipment over 36 months; the office build-out over 60 months (DR Depreciation Expense 7000 / CR Accumulated Depreciation 1350). Annual tooling and insurance are capitalized as prepaids and amortized over 12 months.</p>\n<h2>Burn &amp; runway</h2>\n<ul>\n<li><strong>Monthly operating burn</strong> ≈ operating loss + non-cash addbacks (depreciation/amortization), adjusted for working-capital movements.</li>\n<li><strong>Runway</strong> = cash ÷ net monthly burn. Report it net of deferred revenue: the prepayment float inflates the cash balance with obligations owed as service.</li>\n</ul>",
          "structure": "https://robosystems.ai/report/rpt_01M8AB2E3W2P6PHV0SKSJH89XR/structure/struct_01M8AB1Q2MATN21Z6KD8G06V62"
        },
