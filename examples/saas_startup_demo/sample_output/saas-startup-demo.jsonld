    {
      "@id": "https://robosystems.ai/report/rpt_01M2KXY66YF1FNESV2RZ8QTBAH/ib/struct_01M2KXX1DN5QGMR6PS2NC4CYTH",
      "@type": "rs:InformationBlock",
      "blockType": "regulatory_disclosure",
      "envelopeJson": {
        "@type": "https://robosystems.ai/datatype/v1/InformationBlockEnvelopeJSON",
        "@value": "{\"artifact\": {\"mechanics\": {\"kind\": \"statement_renderer\", \"period_comparisons\": 1, \"rollup_root_element_ids\": []}, \"topic\": \"Significant accounting policies \\u2014 ASC 606 revenue recognition for annual prepaid subscriptions, and operating-expense/burn policy \\u2014 bound from the company's policy documents.\"}, \"block_type\": \"regulatory_disclosure\", \"category\": \"Reporting\", \"connections\": [{\"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W90\", \"id\": \"assoc_01M2KXX1DQGT20AJN10S326CTA\", \"order_value\": 1.0, \"to_element_id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W91\"}, {\"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W90\", \"id\": \"assoc_01M2KXX1DQGT20AJN10S326CTB\", \"order_value\": 2.0, \"to_element_id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W92\"}], \"dimensions\": [], \"display_name\": \"Significant Accounting Policies\", \"elements\": [{\"balance_type\": \"debit\", \"element_type\": \"abstract\", \"id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W90\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Significant Accounting Policies\", \"period_type\": \"duration\", \"qname\": \"cadence:SignificantAccountingPoliciesAbstract\"}, {\"balance_type\": \"debit\", \"element_type\": \"concept\", \"id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W91\", \"is_abstract\": false, \"is_monetary\": false, \"item_type\": \"text_block\", \"name\": \"Revenue Recognition Policy\", \"period_type\": \"duration\", \"qname\": \"cadence:RevenueRecognitionPolicyTextBlock\"}, {\"balance_type\": \"debit\", \"element_type\": \"concept\", \"id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W92\", \"is_abstract\": false, \"is_monetary\": false, \"item_type\": \"text_block\", \"name\": \"Operating Expense and Burn Policy\", \"period_type\": \"duration\", \"qname\": \"cadence:OperatingExpensePolicyTextBlock\"}], \"fact_set\": {\"entity_id\": \"entity_kg1a09d9856b5538c95a28\", \"factset_type\": \"report\", \"id\": \"fs_01M2KXY6A6ETA0W1ST5B7MEQN1\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"provenance\": {\"asserted_by\": \"user_01M2ESGM33C6DPTPQJPZ4VTSVE\", \"content_hash\": \"96ffa73b3137a2a9b524e23b8a6c29bde2a276eaf39feb66b9ad90dedff6dfd2\", \"document_id\": \"doc_01M2KXWXBPATT2JCC7R1PCMA1V\", \"origin\": \"document\", \"section_id\": null}, \"report_id\": \"rpt_01M2KXY66YF1FNESV2RZ8QTBAH\", \"structure_id\": \"struct_01M2KXX1DN5QGMR6PS2NC4CYTH\"}, \"facts\": [{\"content_type\": \"text/markdown\", \"element_id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W91\", \"element_name\": \"Revenue Recognition Policy\", \"element_qname\": \"cadence:RevenueRecognitionPolicyTextBlock\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY6A6ETA0W1ST5B7MEQN1\", \"fact_type\": \"Nonnumeric\", \"id\": \"fact_01M2KXY6A8QXX13PB0HSJG63TZ\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"text_value\": \"# Revenue Recognition Policy \\u2014 Cadence Labs, Inc.\\n\\n## Standard\\nRevenue is recognized under ASC 606 as the performance obligation is satisfied.\\n\\n## Subscriptions (annual, prepaid)\\n- Customers sign annual contracts and pay the full year up front.\\n- Cash collected is recorded as **Deferred Revenue (2300)**, a current liability.\\n- Revenue is recognized **ratably** over the 12-month term: DR Deferred Revenue / CR Subscription Revenue (4000) each month.\\n- The deferred-revenue balance equals contracts billed but not yet delivered. It is a source of working-capital \\\"float\\\" \\u2014 cash in hand that finances operations but is owed as future service.\\n\\n## Professional Services\\n- Onboarding/implementation is billed net-30 and recognized as delivered: DR AR (1100) / CR Professional Services (4100).\\n\\n## Why it matters for runway\\nBecause subscriptions are prepaid, cash collected can exceed revenue recognized while the business grows \\u2014 softening the cash burn. That float is a liability, not equity. When assessing how long the company can operate, subtract deferred revenue from cash before dividing by the burn.\", \"unit\": \"USD\"}, {\"content_type\": \"text/markdown\", \"element_id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W92\", \"element_name\": \"Operating Expense and Burn Policy\", \"element_qname\": \"cadence:OperatingExpensePolicyTextBlock\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY6A6ETA0W1ST5B7MEQN1\", \"fact_type\": \"Nonnumeric\", \"id\": \"fact_01M2KXY6A8QXX13PB0HSJG63V0\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"text_value\": \"# Operating Expense & Burn Policy \\u2014 Cadence Labs, Inc.\\n\\n## Expense classification (by function)\\n| Function | Account | Includes |\\n|---|---|---|\\n| Cost of Revenue | 5000 | Cloud hosting, customer support |\\n| Research & Development | 6000 | Engineering salaries, product development |\\n| Sales & Marketing | 6100 | Sales team, commissions, advertising |\\n| General & Administrative | 6200 / 6300 / 6400 | Admin, finance, legal, rent, software tools |\\n\\nR&D is expensed as incurred (no internal-use software capitalization in this policy).\\n\\n## Depreciation & Prepaids\\nStraight-line. Equipment over 36 months; the office build-out over 60 months (DR Depreciation Expense 7000 / CR Accumulated Depreciation 1350). Annual tooling and insurance are capitalized as prepaids and amortized over 12 months.\\n\\n## Burn & runway\\n- **Monthly operating burn** \\u2248 operating loss + non-cash addbacks (depreciation/amortization), adjusted for working-capital movements.\\n- **Runway** = cash \\u00f7 net monthly burn. Report it net of deferred revenue: the prepayment float inflates the cash balance with obligations owed as service.\", \"unit\": \"USD\"}], \"id\": \"struct_01M2KXX1DN5QGMR6PS2NC4CYTH\", \"information_model\": {\"concept_arrangement\": \"text_block\", \"member_arrangement\": \"whole_part\"}, \"name\": \"Significant Accounting Policies\", \"rules\": [{\"id\": \"rule_01M2KXX1DSQ59S1YP7AN1XVD0M\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"NoCycles\", \"rule_expression\": \"\", \"rule_message\": \"The structure must contain no cycles.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M2KXX1DN5QGMR6PS2NC4CYTH\"}, \"rule_variables\": []}, {\"id\": \"rule_01M2KXX1DSQ59S1YP7AN1XVD0N\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"NoOrphanArcs\", \"rule_expression\": \"\", \"rule_message\": \"Every arc endpoint must reference a declared element.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M2KXX1DN5QGMR6PS2NC4CYTH\"}, \"rule_variables\": []}, {\"id\": \"rule_01M2KXX1DSQ59S1YP7AN1XVD0P\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"ParentBeforeChild\", \"rule_expression\": \"\", \"rule_message\": \"Parent elements must precede their children in ordering.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M2KXX1DN5QGMR6PS2NC4CYTH\"}, \"rule_variables\": []}], \"taxonomy_id\": \"tax_01M2KXX1DF8Q8474BMF508G9T9\", \"taxonomy_name\": \"Cadence Policy Notes\", \"verification_results\": [], \"view\": {\"rendering\": {\"periods\": [{\"end\": \"2026-08-31\", \"start\": \"2025-09-01\"}], \"rows\": [{\"depth\": 0, \"element_id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W91\", \"element_name\": \"Revenue Recognition Policy\", \"element_qname\": \"cadence:RevenueRecognitionPolicyTextBlock\", \"is_subtotal\": false, \"text_value\": \"# Revenue Recognition Policy \\u2014 Cadence Labs, Inc.\\n\\n## Standard\\nRevenue is recognized under ASC 606 as the performance obligation is satisfied.\\n\\n## Subscriptions (annual, prepaid)\\n- Customers sign annual contracts and pay the full year up front.\\n- Cash collected is recorded as **Deferred Revenue (2300)**, a current liability.\\n- Revenue is recognized **ratably** over the 12-month term: DR Deferred Revenue / CR Subscription Revenue (4000) each month.\\n- The deferred-revenue balance equals contracts billed but not yet delivered. It is a source of working-capital \\\"float\\\" \\u2014 cash in hand that finances operations but is owed as future service.\\n\\n## Professional Services\\n- Onboarding/implementation is billed net-30 and recognized as delivered: DR AR (1100) / CR Professional Services (4100).\\n\\n## Why it matters for runway\\nBecause subscriptions are prepaid, cash collected can exceed revenue recognized while the business grows \\u2014 softening the cash burn. That float is a liability, not equity. When assessing how long the company can operate, subtract deferred revenue from cash before dividing by the burn.\", \"values\": []}, {\"depth\": 0, \"element_id\": \"elem_01M2KXX1DGWVDRQG4JRGY42W92\", \"element_name\": \"Operating Expense and Burn Policy\", \"element_qname\": \"cadence:OperatingExpensePolicyTextBlock\", \"is_subtotal\": false, \"text_value\": \"# Operating Expense & Burn Policy \\u2014 Cadence Labs, Inc.\\n\\n## Expense classification (by function)\\n| Function | Account | Includes |\\n|---|---|---|\\n| Cost of Revenue | 5000 | Cloud hosting, customer support |\\n| Research & Development | 6000 | Engineering salaries, product development |\\n| Sales & Marketing | 6100 | Sales team, commissions, advertising |\\n| General & Administrative | 6200 / 6300 / 6400 | Admin, finance, legal, rent, software tools |\\n\\nR&D is expensed as incurred (no internal-use software capitalization in this policy).\\n\\n## Depreciation & Prepaids\\nStraight-line. Equipment over 36 months; the office build-out over 60 months (DR Depreciation Expense 7000 / CR Accumulated Depreciation 1350). Annual tooling and insurance are capitalized as prepaids and amortized over 12 months.\\n\\n## Burn & runway\\n- **Monthly operating burn** \\u2248 operating loss + non-cash addbacks (depreciation/amortization), adjusted for working-capital movements.\\n- **Runway** = cash \\u00f7 net monthly burn. Report it net of deferred revenue: the prepayment float inflates the cash balance with obligations owed as service.\", \"values\": []}], \"unmapped_count\": 0}}}"
      },
