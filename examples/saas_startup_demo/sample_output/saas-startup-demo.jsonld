me\": \"rs-gaap:IncreaseDecreaseInAccountsReceivable\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBE\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DAM\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": -4800.0}, {\"element_id\": \"a3227fb2-202b-51db-9574-4e60db03c04f\", \"element_name\": \"Increase (Decrease) in Other Operating Assets and Liabilities, Net\", \"element_qname\": \"rs-gaap:IncreaseDecreaseInOtherOperatingCapitalNet\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBE\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DAN\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 191977.59}, {\"element_id\": \"353f790f-1ed1-5b91-880d-8029b4b687cf\", \"element_name\": \"Cash and Cash Equivalents, Period Increase (Decrease)\", \"element_qname\": \"rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBE\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DAP\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": -853622.97}, {\"element_id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\", \"element_name\": \"Cash Provided by (Used in) Operating Activity, Including Discontinued Operation\", \"element_qname\": \"rs-gaap:NetCashProvidedByUsedInOperatingActivities\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBE\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DB6\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": -853622.97}, {\"element_id\": \"353f790f-1ed1-5b91-880d-8029b4b687cf\", \"element_name\": \"Cash and Cash Equivalents, Period Increase (Decrease)\", \"element_qname\": \"rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBE\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DB7\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 2557799.8}, {\"element_id\": \"811f1cf5-836c-575f-9f3f-cd7fa477e4e5\", \"element_name\": \"Cash Provided by (Used in) Financing Activity, Including Discontinued Operation\", \"element_qname\": \"rs-gaap:NetCashProvidedByUsedInFinancingActivities\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBE\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DBQ\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 2835000.0}, {\"element_id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\", \"element_name\": \"Cash Provided by (Used in) Operating Activity, Including Discontinued Operation\", \"element_qname\": \"rs-gaap:NetCashProvidedByUsedInOperatingActivities\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBE\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DBR\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": -197200.2}, {\"element_id\": \"69b82be1-1145-5686-8613-31da9eb04a72\", \"element_name\": \"Cash Provided by (Used in) Investing Activity, Including Discontinued Operation\", \"element_qname\": \"rs-gaap:NetCashProvidedByUsedInInvestingActivities\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBE\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DBS\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": -80000.0}], \"id\": \"5473639a-2dac-56a6-b9e5-38480ea38bc1\", \"information_model\": {\"concept_arrangement\": \"arithmetic\", \"member_arrangement\": \"whole_part\"}, \"name\": \"rs-gaap \\u2014 Cash Flow Statement \\u2014 Indirect\", \"rules\": [{\"id\": \"4fdf61ff-ec5d-5cb2-8bcd-aa584ad2e768\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NetIncomeLoss = ($IncomeLossFromContinuingOperations + $IncomeLossFromDiscontinuedOperationsNetOfTax)\", \"rule_message\": \"Calculation rollup: rs-gaap:NetIncomeLoss = ContinuingOps + DiscontinuedOps\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"27a05717-2370-51c2-a924-db5cbcb48219\"}, \"rule_variables\": [{\"variable_name\": \"NetIncomeLoss\", \"variable_qname\": \"rs-gaap:NetIncomeLoss\"}, {\"variable_name\": \"IncomeLossFromContinuingOperations\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperations\"}, {\"variable_name\": \"IncomeLossFromDiscontinuedOperationsNetOfTax\", \"variable_qname\": \"rs-gaap:IncomeLossFromDiscontinuedOperationsNetOfTax\"}]}, {\"id\": \"a38a8265-449b-5f0b-87e9-c5512b7af76c\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NetCashProvidedByUsedInOperatingActivities = ($NetIncomeLoss + $DepreciationDepletionAndAmortization + $IncreaseDecreaseInAccountsReceivable + $IncreaseDecreaseInInventories + $IncreaseDecreaseInPrepaidExpense + $IncreaseDecreaseInAccountsPayableAndAccruedLiabilities + $IncreaseDecreaseInOtherOperatingCapitalNet + $IncreaseDecreaseInAccruedLiabilities + $IncreaseDecreaseInAccruedIncomeTaxesPayable)\", \"rule_message\": \"Calculation rollup: rs-gaap:NetCashProvidedByUsedInOperatingActivities = NetIncomeLoss + DDA + \\u03a3 working-capital deltas (indirect method)\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\":