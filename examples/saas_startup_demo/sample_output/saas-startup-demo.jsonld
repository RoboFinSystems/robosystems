      "period": "https://robosystems.ai/report/rpt_01M24C76KA4JA8TYCEM4D6FJDE/period/p_3",
      "structure": "https://robosystems.ai/report/rpt_01M24C76KA4JA8TYCEM4D6FJDE/structure/struct_01M24C6EEPWYZFN9TP7X0P8B0S",
