      "element": "rs-gaap:RevenueFromContractWithCustomerExcludingAssessedTax",
      "entity": "https://robosystems.ai/report/rpt_01M24C76KA4JA8TYCEM4D6FJDE/entity/entity_kg1a088c2fe99f456c3869",
      "factSet": "https://robosystems.ai/factset/fs_01M24C76MR2N142HS8T2VF9C12",
