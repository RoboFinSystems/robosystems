erations before Income Taxes, Noncontrolling Interest\", \"element_qname\": \"rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXY69MTZ6FEAVX0TJV0BBD\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2KXY69YWAZXXXZ3CBHF4DBP\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": -203866.86}], \"id\": \"47cd6544-03d1-5bc1-8c28-31c0cfa450f9\", \"information_model\": {\"concept_arrangement\": \"arithmetic\", \"member_arrangement\": \"whole_part\"}, \"name\": \"rs-gaap \\u2014 Income Statement \\u2014 Multi-step\", \"rules\": [{\"id\": \"046e4f9b-1b4b-5288-a850-7375a746d858\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$Revenues = ($RevenueFromContractWithCustomerExcludingAssessedTax)\", \"rule_message\": \"Calculation rollup: rs-gaap:Revenues = \\u03a3 rs-gaap revenue leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"b26a6cd4-072f-5bf2-b5d3-ebf928150d6c\"}, \"rule_variables\": [{\"variable_name\": \"Revenues\", \"variable_qname\": \"rs-gaap:Revenues\"}, {\"variable_name\": \"RevenueFromContractWithCustomerExcludingAssessedTax\", \"variable_qname\": \"rs-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"}]}, {\"id\": \"3562e6a7-70dd-544f-9828-cc9cbbcca802\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$IncomeLossFromContinuingOperations = ($IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest - $IncomeTaxExpenseBenefit)\", \"rule_message\": \"Calculation rollup: rs-gaap:IncomeLossFromContinuingOperations = PreTax \\u2212 IncomeTaxExpenseBenefit\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\