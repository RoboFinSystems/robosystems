l + $MembersEquity)\", \"rule_message\": \"Calculation rollup: rs-gaap:StockholdersEquity = \\u03a3 rs-gaap equity leaves (Treasury weight=-1)\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"e3796201-9899-5b7b-9477-659550ba8e68\"}, \"rule_variables\": [{\"variable_name\": \"StockholdersEquity\", \"variable_qname\": \"rs-gaap:StockholdersEquity\"}, {\"variable_name\": \"CommonStockValue\", \"variable_qname\": \"rs-gaap:CommonStockValue\"}, {\"variable_name\": \"PreferredStockValue\", \"variable_qname\": \"rs-gaap:PreferredStockValue\"}, {\"variable_name\": \"AdditionalPaidInCapital\", \"variable_qname\": \"rs-gaap:AdditionalPaidInCapital\"}, {\"variable_name\": \"RetainedEarningsAccumulatedDeficit\", \"variable_qname\": \"rs-gaap:RetainedEarningsAccumulatedDeficit\"}, {\"variable_name\": \"AccumulatedOtherComprehensiveIncomeLossNetOfTax\", \"variable_qname\": \"rs-gaap:AccumulatedOtherComprehensiveIncomeLossNetOfTax\"}, {\"variable_name\": \"TreasuryStockValue\", \"variable_qname\": \"rs-gaap:TreasuryStockValue\"}, {\"variable_name\": \"PartnersCapital\", \"variable_qname\": \"rs-gaap:PartnersCapital\"}, {\"variable_name\": \"MembersEquity\", \"variable_qname\": \"rs-gaap:MembersEquity\"}]}], \"taxonomy_id\": \"cf7178a0-e2d4-58df-995a-2f0233d15466\", \"taxonomy_name\": \"rs-gaap-presentation v1\", \"verification_results\": [{\"evaluated_at\": \"2026-09-10T00:20:58.925476\", \"fact_set_id\": \"fs_01M24B0VC0T58WW67WBZ393W6K\", \"id\": \"vr_01M24B0VDDF8E13Z2J0DKQX4A1\", \"message\": \"subtotal reported but none of its rollup children are present here\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"rule_id\": \"f46bcda0-fff5-5abd-b5f2-71e26eccfc52\", \"status\": \"skipped\", \"structure_id\": \"0b179e5c-5f02-506d-b8d5-860cb10c7694\"}, {\"evaluated_at\": \"2026-09-10T00:20:58.925466\", \"fact_set_id\": \"fs_01M24B0VC0T58WW67WBZ393W6K\", \