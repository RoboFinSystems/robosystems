    {
      "@id": "https://robosystems.ai/report/rpt_01M1ZK1ZWEZ2Z01E1GX55PXWKH/ib/struct_01M1ZK1D4P6AVPB56A512ACZDX",
      "@type": "rs:InformationBlock",
      "blockType": "regulatory_disclosure",
      "envelopeJson": {
        "@type": "https://robosystems.ai/datatype/v1/InformationBlockEnvelopeJSON",
        "@value": "{\"artifact\": {\"mechanics\": {\"kind\": \"statement_renderer\", \"period_comparisons\": 1, \"rollup_root_element_ids\": []}, \"topic\": \"Significant accounting policies \\u2014 ASC 606 revenue recognition for annual prepaid subscriptions, and operating-expense/burn policy \\u2014 bound from the company's policy documents.\"}, \"block_type\": \"regulatory_disclosure\", \"category\": \"Reporting\", \"connections\": [{\"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJG\", \"id\": \"assoc_01M1ZK1D4QR5CYNFNPGFKYZG7X\", \"order_value\": 1.0, \"to_element_id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJH\"}, {\"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJG\", \"id\": \"assoc_01M1ZK1D4QR5CYNFNPGFKYZG7Y\", \"order_value\": 2.0, \"to_element_id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJJ\"}], \"dimensions\": [], \"display_name\": \"Significant Accounting Policies\", \"elements\": [{\"balance_type\": \"debit\", \"element_type\": \"abstract\", \"id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJG\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Significant Accounting Policies\", \"period_type\": \"duration\", \"qname\": \"cadence:SignificantAccountingPoliciesAbstract\"}, {\"balance_type\": \"debit\", \"element_type\": \"concept\", \"id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJH\", \"is_abstract\": false, \"is_monetary\": false, \"item_type\": \"text_block\", \"name\": \"Revenue Recognition Policy\", \"period_type\": \"duration\", \"qname\": \"cadence:RevenueRecognitionPolicyTextBlock\"}, {\"balance_type\": \"debit\", \"element_type\": \"concept\", \"id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJJ\", \"is_abstract\": false, \"is_monetary\": false, \"item_type\": \"text_block\", \"name\": \"Operating Expense and Burn Policy\", \"period_type\": \"duration\", \"qname\": \"cadence:OperatingExpensePolicyTextBlock\"}], \"fact_set\": {\"entity_id\": \"entity_kg1a07f28ad2b28bf365b8\", \"factset_type\": \"report\", \"id\": \"fs_01M1ZK1ZYA9Q7JQ3NRQWQQG78W\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"provenance\": {\"asserted_by\": \"user_01M1T5FEKJQS4DF8RB4FT4J3B5\", \"content_hash\": \"96ffa73b3137a2a9b524e23b8a6c29bde2a276eaf39feb66b9ad90dedff6dfd2\", \"document_id\": \"doc_01M1ZK1CN1XFJV6NS87RPR3MVR\", \"origin\": \"document\", \"section_id\": null}, \"report_id\": \"rpt_01M1ZK1ZWEZ2Z01E1GX55PXWKH\", \"structure_id\": \"struct_01M1ZK1D4P6AVPB56A512ACZDX\"}, \"facts\": [{\"content_type\": \"text/markdown\", \"element_id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJH\", \"element_name\": \"Revenue Recognition Policy\", \"element_qname\": \"cadence:RevenueRecognitionPolicyTextBlock\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M1ZK1ZYA9Q7JQ3NRQWQQG78W\", \"fact_type\": \"Nonnumeric\", \"id\": \"fact_01M1ZK1ZYBG1NFB3B7XXDZM3CJ\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"text_value\": \"# Revenue Recognition Policy \\u2014 Cadence Labs, Inc.\\n\\n## Standard\\nRevenue is recognized under ASC 606 as the performance obligation is satisfied.\\n\\n## Subscriptions (annual, prepaid)\\n- Customers sign annual contracts and pay the full year up front.\\n- Cash collected is recorded as **Deferred Revenue (2300)**, a current liability.\\n- Revenue is recognized **ratably** over the 12-month term: DR Deferred Revenue / CR Subscription Revenue (4000) each month.\\n- The deferred-revenue balance equals contracts billed but not yet delivered. It is a source of working-capital \\\"float\\\" \\u2014 cash in hand that finances operations but is owed as future service.\\n\\n## Professional Services\\n- Onboarding/implementation is billed net-30 and recognized as delivered: DR AR (1100) / CR Professional Services (4100).\\n\\n## Why it matters for runway\\nBecause subscriptions are prepaid, cash collected can exceed revenue recognized while the business grows \\u2014 softening the cash burn. That float is a liability, not equity. When assessing how long the company can operate, subtract deferred revenue from cash before dividing by the burn.\", \"unit\": \"USD\"}, {\"content_type\": \"text/markdown\", \"element_id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJJ\", \"element_name\": \"Operating Expense and Burn Policy\", \"element_qname\": \"cadence:OperatingExpensePolicyTextBlock\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M1ZK1ZYA9Q7JQ3NRQWQQG78W\", \"fact_type\": \"Nonnumeric\", \"id\": \"fact_01M1ZK1ZYBG1NFB3B7XXDZM3CK\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"text_value\": \"# Operating Expense & Burn Policy \\u2014 Cadence Labs, Inc.\\n\\n## Expense classification (by function)\\n| Function | Account | Includes |\\n|---|---|---|\\n| Cost of Revenue | 5000 | Cloud hosting, customer support |\\n| Research & Development | 6000 | Engineering salaries, product development |\\n| Sales & Marketing | 6100 | Sales team, commissions, advertising |\\n| General & Administrative | 6200 / 6300 / 6400 | Admin, finance, legal, rent, software tools |\\n\\nR&D is expensed as incurred (no internal-use software capitalization in this policy).\\n\\n## Depreciation & Prepaids\\nStraight-line. Equipment over 36 months; the office build-out over 60 months (DR Depreciation Expense 7000 / CR Accumulated Depreciation 1350). Annual tooling and insurance are capitalized as prepaids and amortized over 12 months.\\n\\n## Burn & runway\\n- **Monthly operating burn** \\u2248 operating loss + non-cash addbacks (depreciation/amortization), adjusted for working-capital movements.\\n- **Runway** = cash \\u00f7 net monthly burn. Report it net of deferred revenue: the prepayment float inflates the cash balance with obligations owed as service.\", \"unit\": \"USD\"}], \"id\": \"struct_01M1ZK1D4P6AVPB56A512ACZDX\", \"information_model\": {\"concept_arrangement\": \"text_block\", \"member_arrangement\": \"whole_part\"}, \"name\": \"Significant Accounting Policies\", \"rules\": [{\"id\": \"rule_01M1ZK1D4R9W2EXWS8T8YMRTXH\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"NoCycles\", \"rule_expression\": \"\", \"rule_message\": \"The structure must contain no cycles.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M1ZK1D4P6AVPB56A512ACZDX\"}, \"rule_variables\": []}, {\"id\": \"rule_01M1ZK1D4R9W2EXWS8T8YMRTXJ\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"NoOrphanArcs\", \"rule_expression\": \"\", \"rule_message\": \"Every arc endpoint must reference a declared element.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M1ZK1D4P6AVPB56A512ACZDX\"}, \"rule_variables\": []}, {\"id\": \"rule_01M1ZK1D4R9W2EXWS8T8YMRTXK\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"ParentBeforeChild\", \"rule_expression\": \"\", \"rule_message\": \"Parent elements must precede their children in ordering.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M1ZK1D4P6AVPB56A512ACZDX\"}, \"rule_variables\": []}], \"taxonomy_id\": \"tax_01M1ZK1D4MNABVQYFX38KYK5K0\", \"taxonomy_name\": \"Cadence Policy Notes\", \"verification_results\": [], \"view\": {\"rendering\": {\"periods\": [{\"end\": \"2026-08-31\", \"start\": \"2025-09-01\"}], \"rows\": [{\"depth\": 0, \"element_id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJH\", \"element_name\": \"Revenue Recognition Policy\", \"element_qname\": \"cadence:RevenueRecognitionPolicyTextBlock\", \"is_subtotal\": false, \"text_value\": \"# Revenue Recognition Policy \\u2014 Cadence Labs, Inc.\\n\\n## Standard\\nRevenue is recognized under ASC 606 as the performance obligation is satisfied.\\n\\n## Subscriptions (annual, prepaid)\\n- Customers sign annual contracts and pay the full year up front.\\n- Cash collected is recorded as **Deferred Revenue (2300)**, a current liability.\\n- Revenue is recognized **ratably** over the 12-month term: DR Deferred Revenue / CR Subscription Revenue (4000) each month.\\n- The deferred-revenue balance equals contracts billed but not yet delivered. It is a source of working-capital \\\"float\\\" \\u2014 cash in hand that finances operations but is owed as future service.\\n\\n## Professional Services\\n- Onboarding/implementation is billed net-30 and recognized as delivered: DR AR (1100) / CR Professional Services (4100).\\n\\n## Why it matters for runway\\nBecause subscriptions are prepaid, cash collected can exceed revenue recognized while the business grows \\u2014 softening the cash burn. That float is a liability, not equity. When assessing how long the company can operate, subtract deferred revenue from cash before dividing by the burn.\", \"values\": []}, {\"depth\": 0, \"element_id\": \"elem_01M1ZK1D4NHKY2JQV7B0JFCKJJ\", \"element_name\": \"Operating Expense and Burn Policy\", \"element_qname\": \"cadence:OperatingExpensePolicyTextBlock\", \"is_subtotal\": false, \"text_value\": \"# Operating Expense & Burn Policy \\u2014 Cadence Labs, Inc.\\n\\n## Expense classification (by function)\\n| Function | Account | Includes |\\n|---|---|---|\\n| Cost of Revenue | 5000 | Cloud hosting, customer support |\\n| Research & Development | 6000 | Engineering salaries, product development |\\n| Sales & Marketing | 6100 | Sales team, commissions, advertising |\\n| General & Administrative | 6200 / 6300 / 6400 | Admin, finance, legal, rent, software tools |\\n\\nR&D is expensed as incurred (no internal-use software capitalization in this policy).\\n\\n## Depreciation & Prepaids\\nStraight-line. Equipment over 36 months; the office build-out over 60 months (DR Depreciation Expense 7000 / CR Accumulated Depreciation 1350). Annual tooling and insurance are capitalized as prepaids and amortized over 12 months.\\n\\n## Burn & runway\\n- **Monthly operating burn** \\u2248 operating loss + non-cash addbacks (depreciation/amortization), adjusted for working-capital movements.\\n- **Runway** = cash \\u00f7 net monthly burn. Report it net of deferred revenue: the prepayment float inflates the cash balance with obligations owed as service.\", \"values\": []}], \"unmapped_count\": 0}}}"
      },
