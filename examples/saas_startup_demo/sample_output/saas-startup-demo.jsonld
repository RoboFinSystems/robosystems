y (Used in) Operating Activity, Including Discontinued Operation\", \"element_qname\": \"rs-gaap:NetCashProvidedByUsedInOperatingActivities\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M24B0VC0T58WW67WBZ393W6J\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M24B0VC4H142D4ZWAFCGQE01\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": -197200.2}, {\"element_id\": \"353f790f-1ed1-5b91-880d-8029b4b687cf\", \"element_name\": \"Cash and Cash Equivalents, Period Increase (Decrease)\", \"element_qname\": \"rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M24B0VC0T58WW67WBZ393W6J\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M24B0VC4H142D4ZWAFCGQE02\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 2557799.8}, {\"element_id\": \"811f1cf5-836c-575f-9f3f-cd7fa477e4e5\", \"element_name\": \"Cash Provided by (Used in) Financing Activity, Including Discontinued Operation\", \"element_qname\": \"rs-gaap:NetCashProvidedByUsedInFinancingActivities\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M24B0VC0T58WW67WBZ393W6J\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M24B0VC4H142D4ZWAFCGQE03\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 2835000.0}, {\"element_id\": \"69b82be1-1145-5686-8613-31da9eb04a72\", \"element_name\": \"Cash Provided by (Used in) Investing Activity, Including Discontinued Operation\", \"element_qname\": \"rs-gaap:NetCashProvidedByUsedInInvestingActivities\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M24B0VC0T58WW67WBZ393W6J\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M24B0VC4H142D4ZWAFCGQE05\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": -80000.0}], \"id\": \"5473639a-2dac-56a6-b9e5-38480ea38bc1\", \"information_model\": {\"concept_arrangement\": \"arithmetic\", \"member_arrangement\": \"whole_part\"}, \"name\": \"rs-gaap \\u2014 Cash Flow Statement \\u2014 Indirect\", \"rules\": [{\"id\": \"4fdf61ff-ec5d-5cb2-8bcd-aa584ad2e768\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NetIncomeLoss = ($IncomeLossFromContinuingOperations + $IncomeLossFromDiscontinuedOperationsNetOfTax)\", \"rule_message\": \"Calculation rollup: rs-gaap:NetIncomeLoss = ContinuingOps + DiscontinuedOps\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"27a05717-2370-51c2-a924-db5cbcb48219\"}, \"rule_variables\": [{\"variable_name\": \"NetIncomeLoss\", \"variable_qname\": \"rs-gaap:NetIncomeLoss\"}, {\"variable_name\": \"IncomeLossFromContinuingOperations\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperations\"}, {\"variable_name\": \"IncomeLossFromDiscontinuedOperationsNetOfTax\", \"variable_qname\": \"rs-gaap:IncomeLossFromDiscontinuedOperationsNetOfTax\"}]}, {\"id\": \"a38a8265-449b-5f0b-87e9-c5512b7af76c\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NetCashProvidedByUsedInOperatingActivities = ($NetIncomeLoss + $DepreciationDepletionAndAmortization + $IncreaseDecreaseInAccountsReceivable + $IncreaseDecreaseInInventories + $IncreaseDecreaseInPrepaidExpense + $IncreaseDecreaseInAccountsPayableAndAccruedLiabilities + $IncreaseDecreaseInOtherOperatingCapitalNet + $IncreaseDecreaseInAccruedLiabilities + $IncreaseDecreaseInAccruedIncomeTaxesPayable)\", \"rule_message\": \"Calculation rollup: rs-gaap:NetCashProvidedByUsedInOperatingActivities = NetIncomeLoss + DDA + \\u03a3 working-capital deltas (indirect method)\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\"}, \"rule_variables\": [{\"variable_name\": \"NetCashProvidedByUsedInOperatingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInOperatingActivities\"}, {\"variable_name\": \"NetIncomeLoss\", \"variable_qname\": \"rs-gaap:NetIncomeLoss\"}, {\"variable_name\": \"DepreciationDepletionAndAmortization\", \"variable_qname\": \"rs-gaap:DepreciationDepletionAndAmortization\"}, {\"variable_name\": \"IncreaseDecreaseInAccountsReceivable\", \"variable_qname\": \"rs-gaap:IncreaseDecreaseInAccountsReceivable\"}, {\"variable_name\": \"IncreaseDecreaseInInventories\", \"variable_qname\": \"rs-gaap:IncreaseDecreaseInInventories\"}, {\"variable_name\": \"IncreaseDecreaseInPrepaidExpense\", \"variable_qname\": \"rs-gaap:IncreaseDecreaseInPrepaidExpense\"}, {\"variable_name\": \"IncreaseDecreaseInAccountsPayableAndAccruedLiabilities\", \"variable_qname\": \"rs-gaap:IncreaseDecreaseInAccountsPayableAndAccruedLiabilities\"}, {\"variable_name\": \"IncreaseDecreaseInOtherOperatingCapitalNet\", \"variable_qname\": \"rs-gaap:IncreaseDecreaseInOtherOperatingCapitalNet\"}, {\"variable_name\": \"IncreaseDecreaseInAccruedLiabilities\", \"variable_qname\": \"rs-gaap:IncreaseDecreaseInAccruedLiabilities\"}, {\"variable_name\": \"IncreaseDecreaseInAccruedIncomeTaxesPayable\", \"variable_qname\": \"rs-gaap:IncreaseDecreaseInAccruedIncomeTaxesPayable\"}]}, {\"id\": \"a9a20115-13a0-5511-8a6e-396596ccb2a9\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$CashAndCashEquivalentsPeriodIncreaseDecrease = ($NetCashProvidedByUsedInOperatingActivities + $NetCashProvidedByUsedInInvestingActivities + $NetCashProvidedByUsedInFinancingActivities + $EffectOfExchangeRateOnCash)\", \"rule_message\": \"Calculation rollup: rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease = Op + Inv + Fin + Exchange\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"353f790f-1ed1-5b91-880d-8029b4b687cf\"}, \"rule_variables\": [{\"variable_name\": \"CashAndCashEquivalentsPeriodIncreaseDecrease\", \"variable_qname\": \"rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease\"}, {\"variable_name\": \"NetCashProvidedByUsedInOperatingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInOperatingActivities\"}, {\"variable_name\": \"NetCashProvidedByUsedInInvestingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInInvestingActivities\"}, {\"variable_name\": \"NetCashProvidedByUsedInFinancingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInFinancingActivities\"}, {\"variable_name\": \"EffectOfExchangeRateOnCash\", \"variable_qname\": \"rs-gaap:EffectOfExchangeRateOnCash\"}]}, {\"id\": \"b20105e5-8a56-59c8-9092-028b61168338\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NetCashProvidedByUsedInInvestingActivities = ($PaymentsToAcquirePropertyPlantAndEquipment + $ProceedsFromSaleOfPropertyPlantAndEquipment + $PaymentsToAcquireInvestments + $ProceedsFromSaleMaturityAndCollectionsOfInvestments + $PaymentsToAcquireIntangibleAssets + $ProceedsFromSaleOfIntangibleAssets)\", \"rule_message\": \"Calculation rollup: rs-gaap:NetCashProvidedByUsedInInvestingActivities = \\u03a3 Investing leaves (each pre-signed: outflows negative, proceeds positive)\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"69b82be1-1145-5686-8613-31da9eb04a72\"}, \"rule_variables\": [{\"variable_name\": \"NetCashProvidedByUsedInInvestingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInInvestingActivities\"}, {\"variable_name\": \"PaymentsToAcquirePropertyPlantAndEquipment\", \"variable_qname\": \"rs-gaap:PaymentsToAcquirePropertyPlantAndEquipment\"}, {\"variable_name\": \"ProceedsFromSaleOfPr