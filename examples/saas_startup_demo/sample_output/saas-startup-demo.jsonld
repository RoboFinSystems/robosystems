        "@value": "{\"artifact\": {\"mechanics\": {\"kind\": \"statement_renderer\", \"period_comparisons\": 1, \"rollup_root_element_ids\": []}}, \"block_type\": \"cash_flow_statement\", \"category\": \"Reporting\", \"connections\": [{\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"811f1cf5-836c-575f-9f3f-cd7fa477e4e5\", \"id\": \"b30a54de-3386-5a05-bbc6-7c815acc71d4\", \"order_value\": 30340.0, \"to_element_id\": \"d5420297-3894-53c5-8499-00d5cd096c6a\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\", \"id\": \"978d0ba3-b8a3-5691-9fdc-24a7cfbf936c\", \"order_value\": 30160.0, \"to_element_id\": \"dc7408c9-cba5-5697-8254-32ac46485214\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"69b82be1-1145-5686-8613-31da9eb04a72\", \"id\": \"ab347b03-42fb-5d38-a6d5-43acc81c5d83\", \"order_value\": 30230.0, \"to_element_id\": \"7b583473-c66a-52ca-a999-200db98332b5\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"353f790f-1ed1-5b91-880d-8029b4b687cf\", \"id\": \"4b3fb214-07c1-5947-bff2-614eca4e17d1\", \"order_value\": 30100.0, \"to_element_id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\", \"id\": \"306e5d8b-4f31-5437-904d-dbb4eaa5d33d\", \"order_value\": 30190.0, \"to_element_id\": \"a64c15d0-988b-5110-8d04-dd3da12da445\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"cla