, \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"353f790f-1ed1-5b91-880d-8029b4b687cf\"}, \"rule_variables\": [{\"variable_name\": \"CashAndCashEquivalentsPeriodIncreaseDecrease\", \"variable_qname\": \"rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease\"}, {\"variable_name\": \"NetCashProvidedByUsedInOperatingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInOperatingActivities\"}, {\"variable_name\": \"NetCashProvidedByUsedInInvestingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInInvestingActivities\"}, {\"variable_name\": \"NetCashProvidedByUsedInFinancingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInFinancingActivities\"}, {\"variable_name\": \"EffectOfExchangeRateOnCash\", \"variable_qname\": \"rs-gaap:EffectOfExchangeRateOnCash\"}]}, {\"id\": \"b20105e5-8a56-59c8-9092-028b61168338\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NetCashProvidedByUsedInInvestingActivities = ($PaymentsToAcquirePropertyPlantAndEquipment + $ProceedsFromSaleOfPropertyPlantAndEquipment + $PaymentsToAcquireInvestments + $ProceedsFromSaleMaturityAndCollectionsOfInvestments + $PaymentsToAcquireIntangibleAssets + $ProceedsFromSaleOfIntangibleAssets)\", \"rule_message\": \"Calculation rollup: rs-gaap:NetCashProvidedByUsedInInvestingActivities = \\u03a3 Investing leaves (each pre-signed: outflows negative, proceeds positive)\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"69b82be1-1145-5686-8613-31da9eb04a72\"}, \"rule_variables\": [{\"variable_name\": \"NetCashProvidedByUsedInInvestingActivities\", \"variable_qname\": \"rs-gaap:NetCashProvidedByUsedInInvestingActivities\"}, {\"variable_name\": \"PaymentsToAcquirePropertyPlantAndEquipment\", \"variable_qname\": \"rs-gaap:PaymentsToAcquirePropertyPlantAndEquipment\"}, {\"variable_name\": \"ProceedsFromSaleOfPr