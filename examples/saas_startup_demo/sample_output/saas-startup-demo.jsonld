    {
      "@id": "https://robosystems.ai/report/rpt_01M2KXY66YF1FNESV2RZ8QTBAH/ib/struct_01M2KXWT8N5K75J2PQVR0HE4Q6",
      "@type": "rs:InformationBlock",
      "blockType": "regulatory_disclosure",
