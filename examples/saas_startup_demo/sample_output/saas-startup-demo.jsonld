    },
    {
      "@id": "https://robosystems.ai/report/rpt_01M24C76KA4JA8TYCEM4D6FJDE/ib/0b179e5c-5f02-506d-b8d5-860cb10c7694",
      "@type": "rs:InformationBlock",
      "blockType": "equity_statement",
