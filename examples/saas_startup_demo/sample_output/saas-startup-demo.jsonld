b48219\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Net Income (Loss) Attributable to Parent\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:NetIncomeLoss\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PaymentsForRepurchaseOfCommonStock\", \"documentation\": \"The cash outflow to reacquire common stock during the period.\", \"element_type\": \"concept\", \"id\": \"d5420297-3894-53c5-8499-00d5cd096c6a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Payments for Repurchase of Common Stock\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:PaymentsForRepurchaseOfCommonStock\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PaymentsOfDividends\", \"documentation\": \"Cash outflow in the form of capital distributions and dividends to common shareholders, preferred shareholders and noncontrolling interests.\", \"element_type\": \"concept\", \"id\": \"2c1770d4-5f7d-5081-9e1b-59bc87d25efc\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Payments of Dividends\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:PaymentsOfDividends\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:OtherComprehensiveIncomeLossNetOfTax\", \"documentation\": \"Amount after tax and reclassification adjustments of other comprehensive income (loss).\", \"element_type\": \"concept\", \"id\": \"3a26f076-d6ea-55b2-a2a9-c02059a383f9\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Other Comprehensive Income (Loss), Net of Tax\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:OtherComprehensiveIncomeLossNetOfTax\"}], \"fact_set\": {\"entity_id\": \"entity_kg1a088afc574ad2254a54\", \"factset_type\": \"report\", \"id\": \"fs_01M24B0VC0T58WW67WBZ393W6K\", \"period_end\": \"2026-08-31\", \"period_start\": \"2024-09-01\", \"provenance\": {\"arc_type\": null, \"mapping_id\": \"struct_01M24AZP4NE4DYFQX5C3NDKWQC\", \"origin\": \"pivot\", \"period\": \"2024-09-01/2026-08-31\", \"posting_filter\": null}, \"report_id\": \"