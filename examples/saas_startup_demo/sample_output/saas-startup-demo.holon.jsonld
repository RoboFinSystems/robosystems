          "element": "rs-gaap:AssetsCurrent",
          "entity": "https://robosystems.ai/report/rpt_01M5Z8B1DCY95F0FGG8EDP42E3/entity/entity_kg1a166518e7de879915d1",
          "factSet": "https://robosystems.ai/factset/fs_01M5Z8B1X1HNBTH4S54A2V1TAQ",
          "factType": "numeric",
          "internalId": "fact_01M5Z8B1XEB4QAWVSZ03VN09P4",
          "numericValue": "2847021.82",
          "period": "https://robosystems.ai/report/rpt_01M5Z8B1DCY95F0FGG8EDP42E3/period/p_2",
          "prov:wasAttributedTo": {
