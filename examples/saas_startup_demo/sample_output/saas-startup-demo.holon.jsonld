          "@id": "https://robosystems.ai/report/rpt_01M5Z8B1DCY95F0FGG8EDP42E3/ib/0b179e5c-5f02-506d-b8d5-860cb10c7694",
          "@type": "rs:InformationBlock",
          "blockType": "equity_statement",
          "factSet": "https://robosystems.ai/factset/fs_01M5Z8B1X1HNBTH4S54A2V1TAT",
