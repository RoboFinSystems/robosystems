          "rs:sourceKind": "rollup",
          "structure": "https://robosystems.ai/report/rpt_01M5Z8B1DCY95F0FGG8EDP42E3/structure/b6dfb8d2-8ee9-5597-9a3b-8aeee625ff0d",
