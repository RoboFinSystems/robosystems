        {
          "@id": "https://robosystems.ai/report/rpt_01M8AAZ9CFT4F3851M1A6RFDJ1/fact/fact_01M8AAZ9SNNZABXMB30B4N8HBH",
          "@type": "rs:Fact",
          "decimals": "2",
          "element": "rs-gaap:AssetsCurrent",
          "entity": "https://robosystems.ai/report/rpt_01M8AAZ9CFT4F3851M1A6RFDJ1/entity/entity_kg1a1dcdf2e3ba9d804f7d",
          "factSet": "https://robosystems.ai/factset/fs_01M8AAZ9RSTVKME08TTMP68VR9",
          "factType": "numeric",
          "internalId": "fact_01M8AAZ9SNNZABXMB30B4N8HBH",
          "numericValue": "98987.74",
          "period": "https://robosystems.ai/report/rpt_01M8AAZ9CFT4F3851M1A6RFDJ1/period/p_2",
          "prov:wasAttributedTo": {
            "@id": "rollup:calculation"
          },
          "rs:sourceKind": "rollup",
          "structure": "https://robosystems.ai/report/rpt_01M8AAZ9CFT4F3851M1A6RFDJ1/structure/b6dfb8d2-8ee9-5597-9a3b-8aeee625ff0d",
