        {
          "@id": "https://robosystems.ai/report/rpt_01KY5P1WBF2PECGK2RYHQ8A2GZ/fact/fact_01KY5P1WDMHNRWJHWWGDGTGXRX",
          "@type": "rs:Fact",
          "decimals": "INF",
          "element": "rs-gaap:OperatingIncomeLoss",
          "entity": "https://robosystems.ai/report/rpt_01KY5P1WBF2PECGK2RYHQ8A2GZ/entity/entity_kg19f8b605f6fa6d94e569",
          "factSet": "https://robosystems.ai/factset/fs_01KY5P1WD7ZRDCGDMNEDBZWXN9",
          "factType": "numeric",
          "internalId": "fact_01KY5P1WDMHNRWJHWWGDGTGXRX",
          "numericValue": "159242.83000000007",
          "period": "https://robosystems.ai/report/rpt_01KY5P1WBF2PECGK2RYHQ8A2GZ/period/p_3",
          "structure": "https://robosystems.ai/report/rpt_01KY5P1WBF2PECGK2RYHQ8A2GZ/structure/47cd6544-03d1-5bc1-8c28-31c0cfa450f9",
