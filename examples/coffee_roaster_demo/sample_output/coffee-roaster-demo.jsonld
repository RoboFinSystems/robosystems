estmentsCurrent\"}, {\"variable_name\": \"OtherAssetsCurrent\", \"variable_qname\": \"rs-gaap:OtherAssetsCurrent\"}]}, {\"id\": \"17e0664f-13a1-52bf-82a0-14b9ab2c23a7\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$LiabilitiesCurrent = ($AccountsPayableCurrent + $AccruedLiabilitiesCurrent + $DebtCurrent + $LongTermDebtCurrent + $DeferredRevenueCurrent + $FinanceLeaseLiabilityCurrent + $OtherLiabilitiesCurrent)\", \"rule_message\": \"Calculation rollup: rs-gaap:LiabilitiesCurrent = \\u03a3 rs-gaap current-liability leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"efb036ff-3f30-5deb-bee9-1af4cd4b9800\"}, \"rule_variables\": [{\"variable_name\": \"LiabilitiesCurrent\", \"variable_qname\": \"rs-gaap:LiabilitiesCurrent\"}, {\"variable_name\": \"AccountsPayableCurrent\", \"variable_qname\": \"rs-gaap:AccountsPayableCurrent\"}, {\"variable_name\": \"AccruedLiabilitiesCurrent\", \"variable_qname\": \"rs-gaap:AccruedLiabilitiesCurrent\"}, {\"variable_name\": \"DebtCurrent\", \"variable_qname\": \"rs-gaap:DebtCurrent\"}, {\"variable_name\": \"LongTermDebtCurrent\", \"variable_qname\": \"rs-gaap:LongTermDebtCurrent\"}, {\"variable_name\": \"DeferredRevenueCurrent\", \"variable_qname\": \"rs-gaap:DeferredRevenueCurrent\"}, {\"variable_name\": \"FinanceLeaseLiabilityCurrent\", \"variable_qname\": \"rs-gaap:FinanceLeaseLiabilityCurrent\"}, {\"variable_name\": \"OtherLiabilitiesCurrent\", \"variable_qname\": \"rs-gaap:OtherLiabilitiesCurrent\"}]}, {\"id\": \"2b4be3c5-8271-5498-982b-2e4c71e99037\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$LiabilitiesAndStockholdersEquity = ($Liabilities + $StockholdersEquity)\", \"rule_message\": \"Calculation rollup: rs-gaap:LiabilitiesAndStockholdersEquity = rs-gaap:Liabilities + rs-gaap:StockholdersEquity\", \"rule_origin\": \"native\", \"rule_pa