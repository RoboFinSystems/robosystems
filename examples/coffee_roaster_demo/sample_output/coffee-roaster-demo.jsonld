cumentation\": \"The portion of profit or loss for the period, net of income taxes, which is attributable to the parent.\", \"element_type\": \"concept\", \"id\": \"27a05717-2370-51c2-a924-db5cbcb48219\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Net Income (Loss) Attributable to Parent\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:NetIncomeLoss\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:ForeignCurrencyTransactionGainLossBeforeTax\", \"documentation\": \"Amount, before tax, of realized and unrealized gain (loss) from foreign currency transaction.\", \"element_type\": \"concept\", \"id\": \"25358afd-06b2-5816-b584-079fd10ec526\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Gain (Loss), Foreign Currency Transaction, before Tax\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:ForeignCurrencyTransactionGainLossBeforeTax\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:OtherCostAndExpenseOperating\", \"documentation\": \"The total amount of other operating cost and expense items that are associated with the entity's normal revenue producing operation.\", \"element_type\": \"concept\", \"id\": \"e8cce0e4-1096-5bcd-800f-92827dbffbac\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Other Cost and Expense, Operating\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:OtherCostAndExpenseOperating\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:OperatingIncomeLoss\", \"documentation\": \"The net result for the period of deducting operating expenses from operating revenues.\", \"element_type\": \"concept\", \"id\": \"16780828-0201-5609-b572-fbe3ebfcb177\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Operating Income (Loss)\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:OperatingIncomeLoss\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:GeneralAndAdministrativeExpense\", \"documentation\": \"The aggregate total of expenses of managing and administering the affairs of an entity, including affiliates of the reporting entity, which are not directly or indirectly associated with the manufacture, sale or creation of a product or product line.\", \"element_type\": \"concept\", \"id\": \"f92ba8cb-7ae2-5d40-9d15-9a94e9e3aed4\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"General and Administrative Expense\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:GeneralAndAdministrativeExpense\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:InvestmentIncomeInterest\", \"documentation\": \"Amount before accretion (amortization) of purchase discount (premium) of interest income on nonoperating securities.\", \"element_type\": \"concept\", \"id\": \"bb3b54c2-a75f-5cb7-ae13-11a61284cd51\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Investment Income, Interest\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:InvestmentIncomeInterest\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:RestructuringCharges\", \"documentation\": \"Amount of expenses associated with exit or disposal activities pursuant to an authorized plan. Excludes expenses related to a discontinued operation or an asset retirement obligation.\", \"element_type\": \"concept\", \"id\": \"9ee4ee56-4ed2-598b-a28b-136d98c58619\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Restructuring Charges\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:RestructuringCharges\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:NonoperatingIncomeExpense\", \"documentation\": \"The aggregate amount of income or expense from ancillary business-related activities (that is to say, excluding major activities considered part of the normal operations of the business).\", \"element_type\": \"concept\", \"id\": \"45aae2c2-fa56-50c9-b381-df8079e7d33a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Nonoperating Income (Expense)\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:NonoperatingIncomeExpense\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:CostOfRevenue\", \"documentation\": \"The aggregate cost of goods produced and sold and services rendered during the reporting period.\", \"element_type\": \"concept\", \"id\": \"12ab7417-5324-55d6-946e-2456adba47c5\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Cost of Revenue\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:CostOfRevenue\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:GrossProfit\", \"documentation\": \"Aggregate revenue less cost of goods and services sold or operating expenses directly attributable to the revenue generation activity.\", \"element_type\": \"concept\", \"id\": \"a92b3181-9fe7-543c-81d9-13ebd12bbefa\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Gross Profit\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:GrossProfit\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:AssetImpairmentCharges\", \"documentation\": \"Amount of impairment loss for asset. Includes, but is not limited to, tangible and intangible assets and goodwill.\", \"element_type\": \"concept\", \"id\": \"e497f0bb-07b7-59bf-9978-25f0a7f40860\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Asset Impairment Charges\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:AssetImpairmentCharges\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:IncomeLossFromDiscontinuedOperationsNetOfTax\", \"documentation\": \"Amount after tax of income (loss) from a discontinued operation including the portion attributable to the noncontrolling interest. Includes, but is not limited to, the income (loss) from operations during the phase-out period, gain (loss) on disposal, gain (loss) for reversal of write-down (write-down) to fair value, less cost to sell, and adjustments to a prior period gain (loss) on disposal.\", \"element_type\": \"concept\", \"id\": \"c9a10e3b-45c9-5339-94fa-5f7396adce5a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Income (Loss) from Discontinued Operations, Net of Tax, Including Portion Attributable to Noncontrolling Interest\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncomeLossFromDiscontinuedOperationsNetOfTax\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:OtherCostOfOperatingRevenue\", \"documentation\": \"Other costs incurred during the reporting period related to other revenue generating activities.\", \"element_type\": \"concept\", \"id\": \"c8b45a1f-9fb5-51a7-99f8-ee9668bc7be3\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Other Cost of Operating Revenue\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:OtherCostOfOperatingRevenue\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:IncomeStatementAbstract\", \"element_type\": \"abstract\", \"id\": \"d7cd9a37-1b85-50af-afd2-0c7cdc81e7e0\", \"is_abstract\": true, \"is_monetary\": false, \"name\": \"Income Statement [Abstract]\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncomeStatementAbstract\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:InterestExpense\", \"documentation\": \"Amount of interest expense classified as operating and nonoperating. Includes, but is not limited to, cost of borrowing accounted for as interest expense.\", \"element_type\": \"concept\", \"id\": \"890e4f8c-8fed-57e2-96fd-e70455201b11\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Interest Expense, Operating and Nonoperating\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:InterestExpense\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:SellingAndMarketingExpense\", \"documentation\": \"The aggregate total amount of expenses directly related to the marketing or selling of products or services.\", \"element_type\": \"concept\", \"id\": \"4757162f-73d0-5c6e-949e-ed2cafb2a64f\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Selling and Marketing Expense\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:SellingAndMarketingExpense\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:IncomeTaxExpenseBenefit\", \"documentation\": \"Amount of current income tax expense (benefit) and deferred income tax expense (benefit) pertaining to continuing operations.\", \"element_type\": \"concept\", \"id\": \"d629316b-5674-58d9-afcd-b7e7fd34232d\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Income Tax Expense (Benefit)\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncomeTaxExpenseBenefit\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\", \"documentation\": \"Amount, excluding tax collected from customer, of revenue from satisfaction of performance obligation by transferring promised good or service to customer. Tax collected from customer is tax assessed by governmental authority that is both imposed on and concurrent with specific revenue-producing transaction, including, but not limited to, sales, use, value added and excise.\", \"element_type\": \"concept\", \"id\": \"37252918-4301-50e2-8d7e-cf2c76986d15\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Revenue from Contract with Customer, Excluding Assessed Tax\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:GainLossOnDispositionOfAssets\", \"documentation\": \"Amount of gain (loss) on sale or disposal of property, plant and equipment assets, excluding oil and gas property and timber property.\", \"element_type\": \"concept\", \"id\": \"0c205f3a-9e4e-5b26-bc92-5b5977f37b46\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Gain (Loss) on Disposition of Property Plant Equipment, Excluding Oil and Gas Property and Timber Property\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:GainLossOnDispositionOfAssets\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:Revenues\", \"documentation\": \"Amount of revenue recognized from goods sold, services rendered, insurance premiums, or other activities that constitute an earning process. Includes, but is not limited to, investment and interest income before deduction of interest expense when recognized as a component of revenue, and sales and trading gain (loss).\", \"element_type\": \"concept\", \"id\": \"b26a6cd4-072f-5bf2-b5d3-ebf928150d6c\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Revenues\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:Revenues\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:IncomeLossFromContinuingOperations\", \"documentation\": \"Amount after tax of income (loss) from continuing operations attributable to the parent.\", \"element_type\": \"concept\", \"id\": \"d60cabda-7060-5aff-ac98-96371606a738\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Income (Loss) from Continuing Operations, Net of Tax, Attributable to Parent\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncomeLossFromContinuingOperations\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:OperatingExpenses\", \"documentation\": \"Generally recurring costs associated with normal operations except for the portion of these expenses which can be clearly related to production and included in cost of sales or services. Includes selling, general and administrative expense.\", \"element_type\": \"concept\", \"id\": \"71fcdebb-7145-5f76-b5e0-b4ccbf2c29d2\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Operating Expenses\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:OperatingExpenses\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\", \"documentation\": \"Amount of income (loss) from continuing operations, including income (loss) from equity method investments, before deduction of income tax expense (benefit), and income (loss) attributable to noncontrolling interest.\", \"element_type\": \"concept\", \"id\": \"6b0b414f-0c76-54f0-8e51-cf53db59ca24\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Income (Loss) from Continuing Operations before Income Taxes, Noncontrolling Interest\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:GainsLossesOnExtinguishmentOfDebt\", \"documentation\": \"Difference between the fair value of payments made and the carrying amount of debt which is extinguished prior to maturity.\", \"element_type\": \"concept\", \"id\": \"020ba542-7b85-5388-98ea-f21cda46452b\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Gain (Loss) on Extinguishment of Debt\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:GainsLossesOnExtinguishmentOfDebt\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:OtherNonoperatingIncomeExpense\", \"documentation\": \"Amount of income (expense) related to nonoperating activities, classified as other.\", \"element_type\": \"concept\", \"id\": \"601cd531-efce-5e04-8e73-87a8ddfa39e7\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Other Nonoperating Income (Expense)\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:OtherNonoperatingIncomeExpense\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:DepreciationDepletionAndAmortization\", \"documentation\": \"The aggregate expense recognized in the current period that allocates the cost of tangible assets, intangible assets, or depleting assets to periods that benefit from use of the assets.\", \"element_type\": \"concept\", \"id\": \"189a099a-7512-5144-9215-65d837c2c3b5\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Depreciation, Depletion and Amortization\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:DepreciationDepletionAndAmortization\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:ResearchAndDevelopmentExpense\", \"documentation\": \"Amount of expense for research and development. Includes, but is not limited to, cost for computer software product to be sold, leased, or otherwise marketed and writeoff of research and development assets acquired in transaction other than business combination or joint venture formation or both. Excludes write-down of intangible asset acquired in business combination or from joint venture formation or both, used in research and development activity.\", \"element_type\": \"concept\", \"id\": \"9cb92b07-2629-5534-9959-58c3a963559e\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Research and Development Expense\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:ResearchAndDevelopmentExpense\"}], \"fact_set\": {\"entity_id\": \"entity_kg1a09d99ffade793a8fc3\", \"factset_type\": \"report\", \"id\": \"fs_01M2ESN4RKT456YTDGGPED2KD9\", \"period_end\": \"2026-08-31\", \"period_start\": \"2024-09-01\", \"provenance\": {\"arc_type\": null, \"mapping_id\": \"struct_01M2ESM2M35X8PGBWGBPFJ8PCS\", \"origin\": \"pivot\", \"period\": \"2024-09-01/2026-08-31\", \"posting_filter\": null}, \"report_id\": \"rpt_01M2ESN4NJ653NB5YSWP8C4MKQ\", \"structure_id\": \"47cd6544-03d1-5bc1-8c28-31c0cfa450f9\"}, \"facts\": [{\"element_id\": \"5ca0e51f-dff1-5c2b-94f5-26620852a5f9\", \"element_name\": \"Cost of Product and Service Sold\", \"element_qname\": \"rs-gaap:CostOfGoodsAndServicesSold\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2ESN4RKT456YTDGGPED2KD9\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2ESN4S6PF2ZYWZBS2REAQJZ\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 508000.0}, {\"element_id\": \"189a099a-7512-5144-9215-65d837c2c3b5\", \"element_name\": \"Depreciation, Depletion and Amortization\", \"element_qname\": \"rs-gaap:DepreciationDepletionAndAmortization\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2ESN4RKT456YTDGGPED2KD9\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2ESN4S6PF2ZYWZBS2REAQK1\"