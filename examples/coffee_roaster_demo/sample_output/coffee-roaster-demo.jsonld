uration\", \"unit\": \"USD\", \"value\": 84000.0}, {\"element_id\": \"6b0b414f-0c76-54f0-8e51-cf53db59ca24\", \"element_name\": \"Income (Loss) from Continuing Operations before Income Taxes, Noncontrolling Interest\", \"element_qname\": \"rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M1ZK0SSH5JQYNZFMQGX1CG0A\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M1ZK0SSTRHA2ZPTZ9AERQCYF\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 8785.7}, {\"element_id\": \"a92b3181-9fe7-543c-81d9-13ebd12bbefa\", \"element_name\": \"Gross Profit\", \"element_qname\": \"rs-gaap:GrossProfit\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M1ZK0SSH5JQYNZFMQGX1CG0A\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M1ZK0SSTRHA2ZPTZ9AERQCYG\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 105599.96}, {\"element_id\": \"16780828-0201-5609-b572-fbe3ebfcb177\", \"element_name\": \"Operating Income (Loss)\", \"element_qname\": \"rs-gaap:OperatingIncomeLoss\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M1ZK0SSH5JQYNZFMQGX1CG0A\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M1ZK0SSTRHA2ZPTZ9AERQCYH\", \"period_end\": \"2025-08-31\", \"period_start\": \"2024-09-01\", \"period_type\": \"duration\", \"unit\": \"USD\", \"value\": 8785.7}], \"id\": \"47cd6544-03d1-5bc1-8c28-31c0cfa450f9\", \"information_model\": {\"concept_arrangement\": \"arithmetic\", \"member_arrangement\": \"whole_part\"}, \"name\": \"rs-gaap \\u2014 Income Statement \\u2014 Multi-step\", \"rules\": [{\"id\": \"046e4f9b-1b4b-5288-a850-7375a746d858\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$Revenues = ($RevenueFromContractWithCustomerExcludingAssessedTax)\", \"rule_message\": \"Calculation rollup: rs-gaap:Revenues = \\u03a3 rs-gaap revenue leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"b26a6cd4-072f-5bf2-b5d3-ebf928150d6c\"}, \"rule_variables\": [{\"variable_name\": \"Revenues\", \"variable_qname\": \"rs-gaap:Revenues\"}, {\"variable_name\": \"RevenueFromContractWithCustomerExcludingAssessedTax\", \"variable_qname\": \"rs-gaap:RevenueFromContractWithCustomerExcludingAssessedTax\"}]}, {\"id\": \"3562e6a7-70dd-544f-9828-cc9cbbcca802\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$IncomeLossFromContinuingOperations = ($IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest - $IncomeTaxExpenseBenefit)\", \"rule_message\": \"Calculation rollup: rs-gaap:IncomeLossFromContinuingOperations = PreTax \\u2212 IncomeTaxExpenseBenefit\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"d60cabda-7060-5aff-ac98-96371606a738\"}, \"rule_variables\": [{\"variable_name\": \"IncomeLossFromContinuingOperations\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperations\"}, {\"variable_name\": \"IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\"}, {\"variable_name\": \"IncomeTaxExpenseBenefit\", \"variable_qname\": \"rs-gaap:IncomeTaxExpenseBenefit\"}]}, {\"id\": \"4fdf61ff-ec5d-5cb2-8bcd-aa584ad2e768\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NetIncomeLoss = ($IncomeLossFromContinuingOperations + $IncomeLossFromDiscontinuedOperationsNetOfTax)\", \"rule_message\": \"Calculation rollup: rs-gaap:NetIncomeLoss = ContinuingOps + DiscontinuedOps\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"27a05717-2370-51c2-a924-db5cbcb48219\"}, \"rule_variables\": [{\"variable_name\": \"NetIncomeLoss\", \"variable_qname\": \"rs-gaap:NetIncomeLoss\"}, {\"variable_name\": \"IncomeLossFromContinuingOperations\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperations\"}, {\"variable_name\": \"IncomeLossFromDiscontinuedOperationsNetOfTax\", \"variable_qname\": \"rs-gaap:IncomeLossFromDiscontinuedOperationsNetOfTax\"}]}, {\"id\": \"88fc21c3-fc0b-5260-a21e-1795409583c6\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$CostOfRevenue = ($CostOfGoodsAndServicesSold + $OtherCostOfOperatingRevenue)\", \"rule_message\": \"Calculation rollup: rs-gaap:CostOfRevenue = \\u03a3 rs-gaap COGS leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"12ab7417-5324-55d6-946e-2456adba47c5\"}, \"rule_variables\": [{\"variable_name\": \"CostOfRevenue\", \"variable_qname\": \"rs-gaap:CostOfRevenue\"}, {\"variable_name\": \"CostOfGoodsAndServicesSold\", \"variable_qname\": \"rs-gaap:CostOfGoodsAndServicesSold\"}, {\"variable_name\": \"OtherCostOfOperatingRevenue\", \"variable_qname\": \"rs-gaap:OtherCostOfOperatingRevenue\"}]}, {\"id\": \"91fdb039-2159-57e2-8132-8df360fb3ea5\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest = ($OperatingIncomeLoss + $NonoperatingIncomeExpense)\", \"rule_message\": \"Calculation rollup: rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxes... = OperatingIncomeLoss + NonoperatingIncomeExpense \\u2212 InterestExpense\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"6b0b414f-0c76-54f0-8e51-cf53db59ca24\"}, \"rule_variables\": [{\"variable_name\": \"IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\", \"variable_qname\": \"rs-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest\"}, {\"variable_name\": \"OperatingIncomeLoss\", \"variable_qname\": \"rs-gaap:OperatingIncomeLoss\"}, {\"variable_name\": \"NonoperatingIncomeExpense\", \"variable_qname\": \"rs-gaap:NonoperatingIncomeExpense\"}]}, {\"id\": \"9e6a9650-1c9d-5134-87a8-01b7b010f172\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$NonoperatingIncomeExpense = ($InvestmentIncomeInterest - $InterestExpense + $GainLossOnDispositionOfAssets + $OtherNonoperatingIncomeExpense + $ForeignCurrencyTransactionGainLossBeforeTax + $GainsLossesOnExtinguishmentOfDebt)\", \"rule_message\": \"Calculation rollup: rs-gaap:NonoperatingIncomeExpense = \\u03a3 rs-gaap nonoperating leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"45aae2c2-fa56-50c9-b381-df8079e7d33a\"}, \"rule_variables\": [{\"variable_name\": \"NonoperatingIncomeExpense\", \"variable_qname\": \"rs-gaap:NonoperatingIncomeExpense\"}, {\"variable_name\": \"InvestmentIncomeInterest\", \"variable_qname\": \"rs-gaap:InvestmentIncomeInterest\"}, {\"variable_name\": \"InterestExpense\", \"variable_qname\": \"rs-gaap:InterestExpense\"}, {\"variable_name\": \"GainLossOnDispositionOfAssets\", \"variable_qname\": \"rs-gaap:GainLossOnDispositionOfAssets\"}, {\"variable_name\": \"OtherNonoperatingIncomeExpense\", \"variable_qname\": \"rs-gaap:OtherNonoperatingIncomeExpense\"}, {\"variable_name\": \"ForeignCurrencyTransactionGainLossBeforeTax\", \"variable_qname\": \"rs-gaap:ForeignCurrencyTransactionGainLossBeforeTax\"}, {\"variable_name\": \"GainsLossesOnExtinguishmentOfDebt\", \"variable_qname\": \"rs-gaap:GainsLossesOnExtinguishmentOfDebt\"}]}, {\"id\": \"c72751c7-04e0-56d1-ac1e-af93c8028cc5\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$GrossProfit = ($Revenues - $CostOfRevenue)\", \"rule_message\": \"Calculation rollup: rs-gaap:GrossProfit = rs-gaap:Revenues \\u2212 rs-gaap:CostOfRevenue\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"a92b3181-9fe7-543c-81d9-13ebd12bbefa\"}, \"rule_variables\": [{\"variable_name\": \"GrossProfit\", \"variable_qname\": \"rs-gaap:GrossProfit\"}, {\"variable_name\": \"Revenues\", \"variable_qname\": \"rs-gaap:Revenues\"}, {\"variable_name\": \"CostOfRevenue\", \"variable_qname\": \"rs-gaap:CostOfRevenue\"}]}, {\"id\": \"d06306ef-6c51-54ac-874c-e1b069291e06\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$OperatingIncomeLoss = ($GrossProfit - $OperatingExpenses)\", \"rule_message\": \"Calculation rollup: rs-gaap:OperatingIncomeLoss = rs-gaap:GrossProfit \\u2212 rs-gaap:OperatingExpenses\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"16780828-0201-5609-b572-fbe3ebfcb177\"}, \"rule_variables\": [{\"variable_name\": \"OperatingIncomeLoss\", \"variable_qname\": \"rs-gaap:OperatingIncomeLoss\"}, {\"variable_name\": \"GrossProfit\", \"variable_qname\": \"rs-gaap:GrossProfit\"}, {\"variable_name\": \"OperatingExpenses\", \"variable_qname\": \"rs-gaap:OperatingExpenses\"}]}, {\"id\": \"d9e1d2da-f156-5655-a242-35308bb13755\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$OperatingExpenses = ($GeneralAndAdministrativeExpense + $SellingAndMarketingExpense + $ResearchAndDevelopmentExpense + $DepreciationDepletionAndAmortization + $OtherCostAndExpenseOperating + $RestructuringCharges + $AssetImpairmentCharges)\", \"rule_message\": \"Calculation rollup: rs-gaap:OperatingExpenses = \\u03a3 rs-gaap operating expense leaves\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"71fcdebb-7145-5f76-b5e0-b4ccbf2c29d2\"}, \"rule_variables\": [{\"variable_name\": \"OperatingExpenses\", \"variable_qname\": \"rs-gaap:OperatingExpenses\"}, {\"variable_name\": \"GeneralAndAdministrativeExpense\", \"variable_qname\": \"rs-gaap:GeneralAndAdministrativeExpense\"}, {\"variable_name\": \"SellingAndMarketingExpense\", \"variable_qname\": \"rs-gaap:SellingAndMarketingExpense\"}, {\"variable_name\": \"ResearchAndDevelopmentExpense\", \"variable_qname\": \"rs-gaap:ResearchAndDevelopmentExpense\"}, {\"variable_name\": \"DepreciationDepletionAndAmortization\", \"variable_qname\": \"rs-gaap:DepreciationDepletionAndAmortization\"}, {\"variable_name\": \"OtherCostAndExpenseOperating\", \"variable_qname\": \"rs-gaap:OtherCostAndExpenseOperating\"}, {\"variable_name\": \"RestructuringCharges\", \"variable_qname\": \"rs-gaap:RestructuringCharges\"}, {\"variable_name\": \"AssetImpairmentCharges\", \"variable_qname\": \"rs-gaap:AssetImpairmentCharges\"}]}, {\"id\": \"440b98ba-2c5e-5266-9781-5e0b71be060b\", \"rule_category\": \"ReportingSystemSpecificRule\", \"rule_expression\": \"$CostOfRevenue = ($Revenues * $CostOfRevenueRate)\", \"rule_message\": \"Cost of Revenue = Revenues x Cost of Revenue Rate\", \"rule_origin\": \"native\", \"rule_pattern\": \"Derive\", \"rule_severity\": \"info\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"12ab7417-5324-55d6-946e-2456adba47c5\"}, \"rule_variables\": [{\"variable_name\": \"CostOfRevenue\", \"variable_qname\": \"rs-gaap:CostOfRevenue\"}, {\"variable_name\": \"Revenues\", \"variable_qname\": \"rs-gaap:Revenues\"}, {\"variable_name\": \"CostOfRevenueRate\", \"variable_qname\": \"rs-driver:CostO