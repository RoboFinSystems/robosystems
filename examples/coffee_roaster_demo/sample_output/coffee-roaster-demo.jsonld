ttern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"30b2801e-e682-5298-82e6-3670e1d508f1\"}, \"rule_variables\": [{\"variable_name\": \"LiabilitiesAndStockholdersEquity\", \"variable_qname\": \"rs-gaap:LiabilitiesAndStockholdersEquity\"}, {\"variable_name\": \"Liabilities\", \"variable_qname\": \"rs-gaap:Liabilities\"}, {\"variable_name\": \"StockholdersEquity\", \"variable_qname\": \"rs-gaap:StockholdersEquity\"}]}, {\"id\": \"2c745272-55be-51d4-b05c-80ebb3ce574a\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$Assets = ($AssetsCurrent + $AssetsNoncurrent)\", \"rule_message\": \"Calculation rollup: rs-gaap:Assets = rs-gaap:AssetsCurrent + rs-gaap:AssetsNoncurrent\", \"rule_origin\": \"native\", \"rule_pattern\": \"RollUp\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"a1f04756-41d8-5d35-b821-23aa2f3b2fae\"}, \"rule_variables\": [{\"variable_name\": \"Assets\", \"variable_qname\": \"rs-gaap:Assets\"}, {\"variable_name\": \"AssetsCurrent\", \"variable_qname\": \"rs-gaap:AssetsCurrent\"}, {\"variable_name\": \"AssetsNoncurrent\", \"variable_qname\": \"rs-gaap:AssetsNoncurrent\"}]}, {\"id\": \"4a5869a9-039c-53f3-9b42-784ad506f054\", \"rule_category\": \"FundamentalAccountingConceptRelation\", \"rule_expression\": \"$Assets = $LiabilitiesAndEquity\", \"rule_message\": \"Balance Sheet balances: total Assets must equal total Liabilities and Equity.\", \"rule_origin\": \"forked\", \"rule_pattern\": \"EqualTo\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"element\", \"target_ref_id\": \"a1f04756-41d8-5d35-b821-23aa2f3b2fae\"}, \"rule_variables\": [{\"variable_name\": \"Assets\", \"variable_qname\": \"rs-gaap:Assets\"}, {\"variable_name\": \"LiabilitiesAndEquity\", \"variable_qname\": \"rs-gaap:LiabilitiesAndStockholdersEquity\"}]}, {\"id\": \"7632f998-65b0-5775-a060-6fc3bba1faa5\", \"rule_cate