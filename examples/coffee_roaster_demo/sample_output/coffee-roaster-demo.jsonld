    {
      "@id": "https://robosystems.ai/report/rpt_01M2KXVS863NQW3APAGZSZJ83R/ib/struct_01M2KXTKGE3SDD8NNDB6W3KZVJ",
      "@type": "rs:InformationBlock",
      "blockType": "regulatory_disclosure",
      "envelopeJson": {
        "@type": "https://robosystems.ai/datatype/v1/InformationBlockEnvelopeJSON",
        "@value": "{\"artifact\": {\"mechanics\": {\"kind\": \"statement_renderer\", \"period_comparisons\": 1, \"rollup_root_element_ids\": []}, \"topic\": \"Significant accounting policies \\u2014 inventory and COGS, revenue recognition, and depreciation \\u2014 bound from the company's policy documents.\"}, \"block_type\": \"regulatory_disclosure\", \"category\": \"Reporting\", \"connections\": [{\"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA2\", \"id\": \"assoc_01M2KXTKGFVZYPMGR1WFWEMK6J\", \"order_value\": 1.0, \"to_element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA3\"}, {\"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA2\", \"id\": \"assoc_01M2KXTKGFVZYPMGR1WFWEMK6K\", \"order_value\": 2.0, \"to_element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA4\"}, {\"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA2\", \"id\": \"assoc_01M2KXTKGFVZYPMGR1WFWEMK6M\", \"order_value\": 3.0, \"to_element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA5\"}], \"dimensions\": [], \"display_name\": \"Significant Accounting Policies\", \"elements\": [{\"balance_type\": \"debit\", \"element_type\": \"abstract\", \"id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA2\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Significant Accounting Policies\", \"period_type\": \"duration\", \"qname\": \"driftline:SignificantAccountingPoliciesAbstract\"}, {\"balance_type\": \"debit\", \"element_type\": \"concept\", \"id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA3\", \"is_abstract\": false, \"is_monetary\": false, \"item_type\": \"text_block\", \"name\": \"Inventory and Cost of Goods Sold Policy\", \"period_type\": \"duration\", \"qname\": \"driftline:InventoryPolicyTextBlock\"}, {\"balance_type\": \"debit\", \"element_type\": \"concept\", \"id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA4\", \"is_abstract\": false, \"is_monetary\": false, \"item_type\": \"text_block\", \"name\": \"Revenue Recognition Policy\", \"period_type\": \"duration\", \"qname\": \"driftline:RevenueRecognitionPolicyTextBlock\"}, {\"balance_type\": \"debit\", \"element_type\": \"concept\", \"id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA5\", \"is_abstract\": false, \"is_monetary\": false, \"item_type\": \"text_block\", \"name\": \"Depreciation and Prepaid Policy\", \"period_type\": \"duration\", \"qname\": \"driftline:DepreciationPolicyTextBlock\"}], \"fact_set\": {\"entity_id\": \"entity_kg1a09d99ffade793a8fc3\", \"factset_type\": \"report\", \"id\": \"fs_01M2KXVSBSFDGG3ZFWSZMZR0HH\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"provenance\": {\"asserted_by\": \"user_01M2ESGM33C6DPTPQJPZ4VTSVE\", \"content_hash\": \"02d52c9d6cee91d17053e7b384681341dd9fb47fb77a34747b435df80e9473d1\", \"document_id\": \"doc_01M2KXTJX0REZ306YZ45NFM3EM\", \"origin\": \"document\", \"section_id\": null}, \"report_id\": \"rpt_01M2KXVS863NQW3APAGZSZJ83R\", \"structure_id\": \"struct_01M2KXTKGE3SDD8NNDB6W3KZVJ\"}, \"facts\": [{\"content_type\": \"text/markdown\", \"element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA4\", \"element_name\": \"Revenue Recognition Policy\", \"element_qname\": \"driftline:RevenueRecognitionPolicyTextBlock\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXVSBSFDGG3ZFWSZMZR0HH\", \"fact_type\": \"Nonnumeric\", \"id\": \"fact_01M2KXVSBXA733SVBGWH3ZARM2\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"text_value\": \"# Revenue Recognition Policy \\u2014 Driftline Coffee Roasters\\n\\n## Standard\\nRevenue is recognized under ASC 606 as control of the coffee transfers to the customer.\\n\\n## Channels\\n\\n| Channel | Account | Recognition Timing | Cash Timing |\\n|---|---|---|---|\\n| DTC Subscriptions | Subscription Revenue \\u2014 DTC (4000) | Ratably as each month's coffee ships | **Prepaid** \\u2014 billed a quarter ahead into Deferred Subscription Revenue (2300) |\\n| DTC Single Orders | Single-Order Revenue \\u2014 DTC (4200) | On shipment | Immediate (card at checkout) |\\n| Wholesale | Wholesale Revenue (4100) | On delivery to the grocer/caf\\u00e9 | **Net 30** \\u2014 builds Accounts Receivable (1100) |\\n\\n## Deferred Subscription Revenue\\nSubscriber prepayments are a liability until the coffee ships. Each month:\\n- DR Deferred Subscription Revenue (2300) / CR Subscription Revenue \\u2014 DTC (4000) for the month earned.\\n- The deferred balance is cash already collected for future shipments \\u2014 a source of working capital.\\n\\n## Wholesale Accounts Receivable\\nWholesale sells on net-30 terms. Receivables that age past 60 days, or that concentrate in a single large account, are a working-capital and credit risk \\u2014 review the AR aging by customer every close.\", \"unit\": \"USD\"}, {\"content_type\": \"text/markdown\", \"element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA3\", \"element_name\": \"Inventory and Cost of Goods Sold Policy\", \"element_qname\": \"driftline:InventoryPolicyTextBlock\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXVSBSFDGG3ZFWSZMZR0HH\", \"fact_type\": \"Nonnumeric\", \"id\": \"fact_01M2KXVSBXA733SVBGWH3ZARM3\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"text_value\": \"# Inventory & Cost of Goods Sold Policy \\u2014 Driftline Coffee Roasters\\n\\n## Method\\nInventory is carried at cost (FIFO). Green coffee is purchased in bulk from the importer ahead of demand, roasted, and sold through DTC and wholesale channels.\\n\\n## Lifecycle\\n1. **Purchase** \\u2014 green coffee received from the importer: DR Inventory \\u2014 Green Coffee (1400) / CR Cash or Accounts Payable (2000). Cash leaves the business when the coffee is bought, not when it is sold.\\n2. **Sale / consumption** \\u2014 when finished coffee is sold, recognize cost of goods sold: DR Cost of Goods Sold (5000) / CR Inventory \\u2014 Green Coffee (1400).\\n\\n## Watch-out: the cash trap\\nBuying green coffee ahead of a wholesale launch or the holiday season builds the Inventory asset and drains cash *before* the corresponding revenue and COGS are recognized. A month can show strong gross profit while operating cash falls \\u2014 the difference is sitting in inventory. During close, compare the change in inventory to the change in cash.\\n\\n## Gross Margin\\nTarget blended gross margin \\u2248 55%. Investigate months where COGS as a share of revenue moves materially off trend.\", \"unit\": \"USD\"}, {\"content_type\": \"text/markdown\", \"element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA5\", \"element_name\": \"Depreciation and Prepaid Policy\", \"element_qname\": \"driftline:DepreciationPolicyTextBlock\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2KXVSBSFDGG3ZFWSZMZR0HH\", \"fact_type\": \"Nonnumeric\", \"id\": \"fact_01M2KXVSBXA733SVBGWH3ZARM4\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"duration\", \"text_value\": \"# Depreciation & Prepaid Policy \\u2014 Driftline Coffee Roasters\\n\\n## Depreciation\\nStraight-line, no salvage value unless specified. Entry: DR Depreciation Expense (7000) / CR Accumulated Depreciation (1550).\\n\\n| Asset | Cost | Useful Life | Monthly |\\n|---|---|---|---|\\n| Roasting & Packaging Equipment | $90,000.00 | 84 months | $1,071.43 |\\n| Automated Packaging Line | $24,000.00 | 60 months | $400.00 |\\n\\n## Prepaid Expense Amortization\\nPurchases with a term greater than one month are capitalized and amortized straight-line. Entry: DR expense / CR prepaid account.\\n\\n| Item | Cost | Term | Monthly | Debit | Credit |\\n|---|---|---|---|---|---|\\n| Business Insurance | $12,000.00 | 12 months | $1,000.00 | Insurance (6500) | Prepaid Insurance (1200) |\\n| Annual Platform Prepay | $6,000.00 | 12 months | $500.00 | Software & Subscriptions (6400) | Prepaid Software (1210) |\\n\\nDuring each close, review prepaid and fixed-asset accounts for new purchases that lack a schedule, and create one.\", \"unit\": \"USD\"}], \"id\": \"struct_01M2KXTKGE3SDD8NNDB6W3KZVJ\", \"information_model\": {\"concept_arrangement\": \"text_block\", \"member_arrangement\": \"whole_part\"}, \"name\": \"Significant Accounting Policies\", \"rules\": [{\"id\": \"rule_01M2KXTKGJYF5C918DY8SA4ZFC\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"NoCycles\", \"rule_expression\": \"\", \"rule_message\": \"The structure must contain no cycles.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M2KXTKGE3SDD8NNDB6W3KZVJ\"}, \"rule_variables\": []}, {\"id\": \"rule_01M2KXTKGJYF5C918DY8SA4ZFD\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"NoOrphanArcs\", \"rule_expression\": \"\", \"rule_message\": \"Every arc endpoint must reference a declared element.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M2KXTKGE3SDD8NNDB6W3KZVJ\"}, \"rule_variables\": []}, {\"id\": \"rule_01M2KXTKGJYF5C918DY8SA4ZFE\", \"rule_category\": \"ReportLevelModelStructureRule\", \"rule_check_kind\": \"ParentBeforeChild\", \"rule_expression\": \"\", \"rule_message\": \"Parent elements must precede their children in ordering.\", \"rule_origin\": \"auto\", \"rule_severity\": \"error\", \"rule_target\": {\"target_kind\": \"structure\", \"target_ref_id\": \"struct_01M2KXTKGE3SDD8NNDB6W3KZVJ\"}, \"rule_variables\": []}], \"taxonomy_id\": \"tax_01M2KXTKG5HEN6EN27HAW7DG83\", \"taxonomy_name\": \"Driftline Policy Notes\", \"verification_results\": [], \"view\": {\"rendering\": {\"periods\": [{\"end\": \"2026-08-31\", \"start\": \"2025-09-01\"}], \"rows\": [{\"depth\": 0, \"element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA3\", \"element_name\": \"Inventory and Cost of Goods Sold Policy\", \"element_qname\": \"driftline:InventoryPolicyTextBlock\", \"is_subtotal\": false, \"text_value\": \"# Inventory & Cost of Goods Sold Policy \\u2014 Driftline Coffee Roasters\\n\\n## Method\\nInventory is carried at cost (FIFO). Green coffee is purchased in bulk from the importer ahead of demand, roasted, and sold through DTC and wholesale channels.\\n\\n## Lifecycle\\n1. **Purchase** \\u2014 green coffee received from the importer: DR Inventory \\u2014 Green Coffee (1400) / CR Cash or Accounts Payable (2000). Cash leaves the business when the coffee is bought, not when it is sold.\\n2. **Sale / consumption** \\u2014 when finished coffee is sold, recognize cost of goods sold: DR Cost of Goods Sold (5000) / CR Inventory \\u2014 Green Coffee (1400).\\n\\n## Watch-out: the cash trap\\nBuying green coffee ahead of a wholesale launch or the holiday season builds the Inventory asset and drains cash *before* the corresponding revenue and COGS are recognized. A month can show strong gross profit while operating cash falls \\u2014 the difference is sitting in inventory. During close, compare the change in inventory to the change in cash.\\n\\n## Gross Margin\\nTarget blended gross margin \\u2248 55%. Investigate months where COGS as a share of revenue moves materially off trend.\", \"values\": []}, {\"depth\": 0, \"element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA4\", \"element_name\": \"Revenue Recognition Policy\", \"element_qname\": \"driftline:RevenueRecognitionPolicyTextBlock\", \"is_subtotal\": false, \"text_value\": \"# Revenue Recognition Policy \\u2014 Driftline Coffee Roasters\\n\\n## Standard\\nRevenue is recognized under ASC 606 as control of the coffee transfers to the customer.\\n\\n## Channels\\n\\n| Channel | Account | Recognition Timing | Cash Timing |\\n|---|---|---|---|\\n| DTC Subscriptions | Subscription Revenue \\u2014 DTC (4000) | Ratably as each month's coffee ships | **Prepaid** \\u2014 billed a quarter ahead into Deferred Subscription Revenue (2300) |\\n| DTC Single Orders | Single-Order Revenue \\u2014 DTC (4200) | On shipment | Immediate (card at checkout) |\\n| Wholesale | Wholesale Revenue (4100) | On delivery to the grocer/caf\\u00e9 | **Net 30** \\u2014 builds Accounts Receivable (1100) |\\n\\n## Deferred Subscription Revenue\\nSubscriber prepayments are a liability until the coffee ships. Each month:\\n- DR Deferred Subscription Revenue (2300) / CR Subscription Revenue \\u2014 DTC (4000) for the month earned.\\n- The deferred balance is cash already collected for future shipments \\u2014 a source of working capital.\\n\\n## Wholesale Accounts Receivable\\nWholesale sells on net-30 terms. Receivables that age past 60 days, or that concentrate in a single large account, are a working-capital and credit risk \\u2014 review the AR aging by customer every close.\", \"values\": []}, {\"depth\": 0, \"element_id\": \"elem_01M2KXTKG9GMXDW8Y02FGPBNA5\", \"element_name\": \"Depreciation and Prepaid Policy\", \"element_qname\": \"driftline:DepreciationPolicyTextBlock\", \"is_subtotal\": false, \"text_value\": \"# Depreciation & Prepaid Policy \\u2014 Driftline Coffee Roasters\\n\\n## Depreciation\\nStraight-line, no salvage value unless specified. Entry: DR Depreciation Expense (7000) / CR Accumulated Depreciation (1550).\\n\\n| Asset | Cost | Useful Life | Monthly |\\n|---|---|---|---|\\n| Roasting & Packaging Equipment | $90,000.00 | 84 months | $1,071.43 |\\n| Automated Packaging Line | $24,000.00 | 60 months | $400.00 |\\n\\n## Prepaid Expense Amortization\\nPurchases with a term greater than one month are capitalized and amortized straight-line. Entry: DR expense / CR prepaid account.\\n\\n| Item | Cost | Term | Monthly | Debit | Credit |\\n|---|---|---|---|---|---|\\n| Business Insurance | $12,000.00 | 12 months | $1,000.00 | Insurance (6500) | Prepaid Insurance (1200) |\\n| Annual Platform Prepay | $6,000.00 | 12 months | $500.00 | Software & Subscriptions (6400) | Prepaid Software (1210) |\\n\\nDuring each close, review prepaid and fixed-asset accounts for new purchases that lack a schedule, and create one.\", \"values\": []}], \"unmapped_count\": 0}}}"
      },
