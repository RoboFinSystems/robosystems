lement_id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\", \"id\": \"978d0ba3-b8a3-5691-9fdc-24a7cfbf936c\", \"order_value\": 30160.0, \"to_element_id\": \"dc7408c9-cba5-5697-8254-32ac46485214\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\", \"id\": \"306e5d8b-4f31-5437-904d-dbb4eaa5d33d\", \"order_value\": 30190.0, \"to_element_id\": \"a64c15d0-988b-5110-8d04-dd3da12da445\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"811f1cf5-836c-575f-9f3f-cd7fa477e4e5\", \"id\": \"ec9ed494-37d2-5fa4-b83b-d13cde9b01bb\", \"order_value\": 30320.0, \"to_element_id\": \"1802f6ae-7d95-5029-af7a-b36015b2c525\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"69b82be1-1145-5686-8613-31da9eb04a72\", \"id\": \"d3ddcc5e-5581-5320-9157-3dfc39e28060\", \"order_value\": 30210.0, \"to_element_id\": \"ff101489-15f4-573d-967b-24f75e0fc0f6\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"69b82be1-1145-5686-8613-31da9eb04a72\", \"id\": \"db3c11d2-3118-50b8-a481-4657176233b5\", \"order_value\": 30250.0, \"to_element_id\": \"cd6af9f1-caad-5432-afb1-e7aa935ecd46\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"353f790f-1ed1-5b91-880d-8029b4b687cf\", \"id\": \"566cae0e-05d4-53d5-8500-d5aaf111db89\", \"order_value\": 30300.0, \"to_element_id\": \"811f1cf5-836c-575f-9f3f-cd7fa477e4e5\"}], \"dimensions\": [], \"disclosure_id\": \"disclosures:CashFlowStatement\", \"display_name\": \"Cash Flow Statement\", \"elements\": [{\"balance_type\": \"credit\", \"code\": \"rs-gaap:IncreaseDecreaseInAccountsReceivable\", \"documentation\": \"The increase (decrease) during the reporting period in amount due within one year (or one business cycle) from customers for the credit sale of goods and services.\", \"element_type\": \"concept\", \"id\": \"93175d59-983c-5012-910f-3dfbf07ce327\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Increase (Decrease) in Accounts Receivable\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncreaseDecreaseInAccountsReceivable\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:NetIncomeLoss\", \"documentation\": \"The portion of profit or loss for the period, net of income taxes, which is attributable to the parent.\", \"element_type\": \"concept\", \"id\": \"27a05717-2370-51c2-a924-db5cbcb48219\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Net Income (Loss) Attributable to Parent\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:NetIncomeLoss\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PaymentsToAcquireIntangibleAssets\", \"documentation\": \"The cash outflow to acquire asset without physical form usually arising from contractual or other legal rights, excluding goodwill.\", \"element_type\": \"concept\", \"id\": \"cd6af9f1-caad-5432-afb1-e7aa935ecd46\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Payments to Acquire Intangible Assets\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:PaymentsToAcquireIntangibleAssets\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PaymentsForRepurchaseOfCommonStock\", \"documentation\": \"The cash outflow to reacquire common stock during the period.\", \"element_type\": \"concept\", \"id\": \"d5420297-3894-53c5-8499-00d5cd096c6a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Payments for Repurchase of Common Stock\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:PaymentsForRepurchaseOfCommonStock\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:ProceedsFromSaleOfPropertyPlantAndEquipment\", \"documentation\": \"The cash inflow from the sale of long-lived, physical assets that are used in the normal conduct of business to produce goods and services and not intended for resale.\", \"element_type\": \"concept\", \"id\": \"b283f3f5-b755-540c-be3c-08004b9a9503\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Proceeds from Sale of Property, Plant, and Equipment\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:ProceedsFromSaleOfPropertyPlantAndEquipment\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:IncreaseDecreaseInPrepaidExpense\", \"documentation\": \"The increase (decrease) during the reporting period in the amount of outstanding money paid in advance for goods or services that bring economic benefits for future periods.\", \"element_type\": \"concept\", \"id\": \"550bb6e5-53d0-5267-adb1-baf78093a0b0\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Increase (Decrease) in Prepaid Expense\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncreaseDecreaseInPrepaidExpense\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:IncreaseDecreaseInAccruedIncomeTaxesPayable\", \"documentation\": \"The increase (decrease) during the period in the amount due for taxes based on the reporting entity's earnings or attributable to the entity's income earning process (business presence) within a given jurisdiction.\", \"element_type\": \"concept\", \"id\": \"a64c15d0-988b-5110-8d04-dd3da12da445\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Increase (Decrease) in Income Taxes Payable\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncreaseDecreaseInAccruedIncomeTaxesPayable\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PaymentsToAcquirePropertyPlantAndEquipment\", \"documentation\": \"The cash outflow associated with the acquisition of long-lived, physical assets that are used in the normal conduct of business to produce goods and services and not intended for resale; includes cash outflows to pay for construction of self-constructed assets.\", \"element_type\": \"concept\", \"id\": \"ff101489-15f4-573d-967b-24f75e0fc0f6\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Payments to Acquire Property, Plant, and Equipment\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:PaymentsToAcquirePropertyPlantAndEquipment\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PaymentsToAcquireInvestments\", \"documentation\": \"The cash outflow associated with the purchase of all investments (debt, security, other) during the period.\", \"element_type\": \"concept\", \"id\": \"7b583473-c66a-52ca-a999-200db98332b5\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Payments to Acquire Investments\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:PaymentsToAcquireInvestments\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:IncreaseDecreaseInOtherOperatingCapitalNet\", \"documentation\": \"Amount of increase (decrease) in operating assets after deduction of operating liabilities classified as other.\", \"element_type\": \"concept\", \"id\": \"a3227fb2-202b-51db-9574-4e60db03c04f\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Increase (Decrease) in Other Operating Assets and Liabilities, Net\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncreaseDecreaseInOtherOperatingCapitalNet\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:IncreaseDecreaseInAccruedLiabilities\", \"documentation\": \"The increase (decrease) during the reporting period in the aggregate amount of expenses incurred but not yet paid.\", \"element_type\": \"concept\", \"id\": \"e92e6488-dcc7-5877-ad4b-f2498bdf7bae\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Increase (Decrease) in Accrued Liabilities\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncreaseDecreaseInAccruedLiabilities\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:EffectOfExchangeRateOnCash\", \"documentation\": \"Amount of effect of exchange rate changes on cash balances held in foreign currencies. Excludes cash equivalents.\", \"element_type\": \"concept\", \"id\": \"f400dec7-3c08-52ac-8291-23b302f40d6c\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Effect of Exchange Rate on Cash\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:EffectOfExchangeRateOnCash\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:IncreaseDecreaseInAccountsPayableAndAccruedLiabilities\", \"documentation\": \"The increase (decrease) during the reporting period in the amounts payable to vendors for goods and services received and the amount of obligations and expenses incurred but not paid.\", \"element_type\": \"concept\", \"id\": \"dc7408c9-cba5-5697-8254-32ac46485214\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Increase (Decrease) in Accounts Payable and Accrued Liabilities\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncreaseDecreaseInAccountsPayableAndAccruedLiabilities\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:ProceedsFromSaleMaturityAndCollectionsOfInvestments\", \"documentation\": \"The cash inflow associated with the sale, maturity and collection of all investments such as debt, security and so forth during the period.\", \"element_type\": \"concept\", \"id\": \"7c35013f-3cf2-569a-86b6-ba5643c9e5cd\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Proceeds from Sale, Maturity and Collection of Investments\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:ProceedsFromSaleMaturityAndCollectionsOfInvestments\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:NetCashProvidedByUsedInOperatingActivities\", \"documentation\": \"Amount of cash inflow (outflow) from operating activity, including, but not limited to, discontinued operation. Operating activity includes, but is not limited to, transaction, adjustment, and change in value not defined as investing or financing activity.\", \"element_type\": \"concept\", \"id\": \"57ccbf45-c970-5bcd-a381-44d96b6b6d94\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Cash Provided by (Used in) Operating Activity, Including Discontinued Operation\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:NetCashProvidedByUsedInOperatingActivities\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:NetCashProvidedByUsedInInvestingActivities\", \"documentation\": \"Amount of cash inflow (outflow) from investing activity, including, but not limited to, discontinued operation. Investing activity includes, but is not limited to, making and collecting loan, acquiring and disposing of debt and equity instruments, property, plant, and equipment, and other productive assets.\", \"element_type\": \"concept\", \"id\": \"69b82be1-1145-5686-8613-31da9eb04a72\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Cash Provided by (Used in) Investing Activity, Including Discontinued Operation\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:NetCashProvidedByUsedInInvestingActivities\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:NetCashProvidedByUsedInFinancingActivities\", \"documentation\": \"Amount of cash inflow (outflow) from financing activity, including, but not limited to, discontinued operation. Financing activity includes, but is not limited to, obtaining resource from owner and providing return on, and return of, their investment; borrowing money and repaying amount borrowed, or settling obligation; and obtaining and paying for other resource obtained from creditor on long-term credit.\", \"element_type\": \"concept\", \"id\": \"811f1cf5-836c-575f-9f3f-cd7fa477e4e5\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Cash Provided by (Used in) Financing Activity, Including Discontinued Operation\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:NetCashProvidedByUsedInFinancingActivities\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:RepaymentsOfLongTermDebt\", \"documentation\": \"The cash outflow for debt initially having maturity due after one year or beyond the normal operating cycle, if longer.\", \"element_type\": \"concept\", \"id\": \"85890c87-aac7-5702-8f69-b1a14139dc41\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Repayments of Long-Term Debt\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:RepaymentsOfLongTermDebt\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:ProceedsFromIssuanceOfLongTermDebt\", \"documentation\": \"The cash inflow from a debt initially having maturity due after one year or beyond the operating cycle, if longer.\", \"element_type\": \"concept\", \"id\": \"1802f6ae-7d95-5029-af7a-b36015b2c525\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Proceeds from Issuance of Long-Term Debt\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:ProceedsFromIssuanceOfLongTermDebt\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:IncreaseDecreaseInInventories\", \"documentation\": \"The increase (decrease) during the reporting period in the aggregate value of all inventory held by the reporting entity, associated with underlying transactions that are classified as operating activities.\", \"element_type\": \"concept\", \"id\": \"c8b0722b-7993-592f-8ef1-5b0964ac8a10\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Increase (Decrease) in Inventories\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:IncreaseDecreaseInInventories\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:DepreciationDepletionAndAmortization\", \"documentation\": \"The aggregate expense recognized in the current period that allocates the cost of tangible assets, intangible assets, or depleting assets to periods that benefit from use of the assets.\", \"element_type\": \"concept\", \"id\": \"189a099a-7512-5144-9215-65d837c2c3b5\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Depreciation, Depletion and Amortization\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:DepreciationDepletionAndAmortization\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:ProceedsFromSaleOfIntangibleAssets\", \"documentation\": \"The cash inflow from disposal of asset without physical form usually arising from contractual or other legal rights, excluding goodwill.\", \"element_type\": \"concept\", \"id\": \"af7f60d9-8e98-5fa3-ac68-8f5ab528aa8f\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Proceeds from Sale of Intangible Assets\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:ProceedsFromSaleOfIntangibleAssets\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:ProceedsFromIssuanceOfCommonStock\", \"documentation\": \"The cash inflow from the additional capital contribution to the entity.\", \"element_type\": \"concept\", \"id\": \"2eb72b5f-d7e3-5bd5-bf93-be38b6d21820\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Proceeds from Issuance of Common Stock\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:ProceedsFromIssuanceOfCommonStock\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease\", \"documentation\": \"Amount of increase (decrease) in cash and cash equivalents. Cash and cash equivalents are the amount of currency on hand as well as demand deposits with banks or financial institutions. Includes other kinds of accounts that have the general characteristics of demand deposits. Also includes short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates. Includes effect from exchange rate changes.\", \"element_type\": \"concept\", \"id\": \"353f790f-1ed1-5b91-880d-8029b4b687cf\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Cash and Cash Equivalents, Period Increase (Decrease)\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease\"}], \"fa