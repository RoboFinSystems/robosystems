      "@id": "https://robosystems.ai/report/rpt_01M1ZK0SQY3Y6K7RJFQZE651Z8/report-meta/rpt_01M1ZK0SQY3Y6K7RJFQZE651Z8",
      "filingStatus": "draft",
      "generationCount": "1",
      "reportId": "rpt_01M1ZK0SQY3Y6K7RJFQZE651Z8"
    },
