201-9899-5b7b-9477-659550ba8e68\", \"id\": \"05eee850-2d98-5b12-9df9-cee9eec5cf0c\", \"order_value\": 20460.0, \"to_element_id\": \"f6d5fee3-1a7c-5aba-8abb-d284dd53060a\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"e3796201-9899-5b7b-9477-659550ba8e68\", \"id\": \"008f23b6-eef8-5a56-a5c4-f5f892c4e660\", \"order_value\": 20410.0, \"to_element_id\": \"2fc1b539-b3bd-59e7-a3d6-23e24fbd36a9\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"0fc9ab7e-c5ce-5277-9530-344cc127fe26\", \"id\": \"fb266eaa-9585-5bf8-aef7-de183e8e4e97\", \"order_value\": 20150.0, \"to_element_id\": \"488ac9be-588e-5ffa-92c9-a06d71f3d759\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"841cedeb-4cb0-532a-b0bd-c34846a13a8c\", \"id\": \"d99114bb-7b55-5fb5-92ef-9f1d7dc13b39\", \"order_value\": 20240.0, \"to_element_id\": \"dd95756e-eeb1-57d9-b311-5c47f6ce7510\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"efb036ff-3f30-5deb-bee9-1af4cd4b9800\", \"id\": \"36c5af79-de4f-5365-89b0-954e6fa5607b\", \"order_value\": 20312.0, \"to_element_id\": \"76b2489a-b8a5-57d4-8f48-34fab49ce605\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"f41fe34d-88ea-5e20-a781-2d3e256a6abf\", \"id\": \"7f239113-e412-5694-8db7-a6f9b93cbf4d\", \"order_value\": 20323.0, \"to_element_id\": \"303a2035-1ca8-526b-88c7-629d8f8dfbc7\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"efb036ff-3f30-5deb-bee9-1af4cd4b9800\", \"id\": \"5c84f7f3-26b4-5363-88a6-53f9ea17f7cb\", \"order_value\": 20312.5, \"to_element_id\": \"cb601c1e-10a6-571b-bcd9-6e40a6a80bd6\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"30b2801e-e682-5298-82e6-3670e1d508f1\", \"id\": \"7201bb16-311f-5cd9-86d3-0e43d65c8a2e\", \"order_value\": 20400.0, \"to_element_id\": \"e3796201-9899-5b7b-9477-659550ba8e68\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"e3796201-9899-5b7b-9477-659550ba8e68\", \"id\": \"8b16b3e3-facb-5d9d-8936-ad660002b3a0\", \"order_value\": 20440.0, \"to_element_id\": \"a9c87d60-a1e5-506b-a27e-cbf9e14e5113\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"f41fe34d-88ea-5e20-a781-2d3e256a6abf\", \"id\": \"2863b005-c1a9-5fb2-9730-80974ee08faf\", \"order_value\": 20321.0, \"to_element_id\": \"091373d9-8a82-51bd-adf8-d09b73beb32e\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"efb036ff-3f30-5deb-bee9-1af4cd4b9800\", \"id\": \"9b10a9e7-4274-579b-b9ae-27420265a5a6\", \"order_value\": 20311.5, \"to_element_id\": \"4decfae2-2ca3-5dd3-8c06-88557583c13d\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"0fc9ab7e-c5ce-5277-9530-344cc127fe26\", \"id\": \"3b0ff8c8-d8d4-57d7-ba21-0b8d2d5515b2\", \"order_value\": 20130.0, \"to_element_id\": \"4afa5950-85ac-5a85-a9cb-01c387c6ab08\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"841cedeb-4cb0-532a-b0bd-c34846a13a8c\", \"id\": \"07d72def-2528-5928-94f3-9a6b9cecd4d5\", \"order_value\": 20250.0, \"to_element_id\": \"84e44859-bd30-57c7-aec8-5f4a8a11f88a\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"f41fe34d-88ea-5e20-a781-2d3e256a6abf\", \"id\": \"6cf76077-abd3-54dc-9c17-2583aa70f875\", \"order_value\": 20322.0, \"to_element_id\": \"a47dbfaa-167a-5cf0-8608-b8bbf8333b65\"}, {\"arcrole\": \"http://www.xbrl.org/2003/arcrole/parent-child\", \"association_type\": \"presentation\", \"classifications\": [], \"from_element_id\": \"841cedeb-4cb0-532a-b0bd-c34846a13a8c\", \"id\": \"e672a6bc-653e-5f76-867a-2454c4ad1561\", \"order_value\": 20210.0, \"to_element_id\": \"288099af-5cbb-5f78-8f8a-1a85675fb661\"}], \"dimensions\": [], \"disclosure_id\": \"disclosures:BalanceSheet\", \"display_name\": \"Balance Sheet\", \"elements\": [{\"balance_type\": \"debit\", \"code\": \"rs-gaap:OtherAssetsNoncurrent\", \"documentation\": \"Amount of noncurrent assets classified as other.\", \"element_type\": \"concept\", \"id\": \"95f54ff6-b946-53a0-8384-079de593429a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Other Assets, Noncurrent\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:OtherAssetsNoncurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:OtherAssetsCurrent\", \"documentation\": \"Amount of current assets classified as other.\", \"element_type\": \"concept\", \"id\": \"eeaa96db-a6d8-5772-a874-d6e294cb80fe\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Other Assets, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:OtherAssetsCurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:Liabilities\", \"documentation\": \"Amount of liability recognized for present obligation requiring transfer or otherwise providing economic benefit to others.\", \"element_type\": \"concept\", \"id\": \"7af273ac-1cba-5fb3-a1c9-5c5d8fdb9bdf\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Liabilities\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:Liabilities\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:DeferredRevenueCurrent\", \"documentation\": \"Amount of deferred income and obligation to transfer product and service to customer for which consideration has been received or is receivable, classified as current.\", \"element_type\": \"concept\", \"id\": \"f35c2b3a-01eb-50c8-96e3-4c07cc2a0fee\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Deferred Revenue, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:DeferredRevenueCurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:AdditionalPaidInCapital\", \"documentation\": \"Amount of excess of issue price over par or stated value of stock and from other transaction involving stock or stockholder. Includes, but is not limited to, additional paid-in capital (APIC) for common and preferred stock.\", \"element_type\": \"concept\", \"id\": \"6146605c-0d63-51e1-a523-3450d6abaca3\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Additional Paid in Capital\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:AdditionalPaidInCapital\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:OperatingLeaseLiabilityNoncurrent\", \"documentation\": \"Present value of lessee's discounted obligation for lease payments from operating lease, classified as noncurrent.\", \"element_type\": \"concept\", \"id\": \"9f9fdbd0-a5d5-57ba-882f-2a907f9cf125\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Operating Lease, Liability, Noncurrent\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:OperatingLeaseLiabilityNoncurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:LongTermDebtAndCapitalLeaseObligations\", \"documentation\": \"Amount of long-term debt and lease obligation, classified as noncurrent.\", \"element_type\": \"concept\", \"id\": \"091373d9-8a82-51bd-adf8-d09b73beb32e\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Long-Term Debt and Lease Obligation\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:LongTermDebtAndCapitalLeaseObligations\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:RetainedEarningsAccumulatedDeficit\", \"documentation\": \"Amount of accumulated undistributed earnings (deficit).\", \"element_type\": \"concept\", \"id\": \"a9c87d60-a1e5-506b-a27e-cbf9e14e5113\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Retained Earnings (Accumulated Deficit)\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:RetainedEarningsAccumulatedDeficit\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:LiabilitiesNoncurrent\", \"documentation\": \"Amount of obligation due after one year or beyond the normal operating cycle, if longer.\", \"element_type\": \"concept\", \"id\": \"f41fe34d-88ea-5e20-a781-2d3e256a6abf\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Liabilities, Noncurrent\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:LiabilitiesNoncurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:LiabilitiesAndStockholdersEquity\", \"documentation\": \"Amount of liabilities and equity items, including the portion of equity attributable to noncontrolling interests, if any.\", \"element_type\": \"concept\", \"id\": \"30b2801e-e682-5298-82e6-3670e1d508f1\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Liabilities and Equity\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:LiabilitiesAndStockholdersEquity\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:InventoryNetOfAllowancesCustomerAdvancesAndProgressBillings\", \"documentation\": \"Amount, after deduction of valuation reserves, other allowances, and customer advances received on long-term contracts or programs, of inventory expected to be converted to cash, sold or exchanged within the normal operating cycle.\", \"element_type\": \"concept\", \"id\": \"4afa5950-85ac-5a85-a9cb-01c387c6ab08\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Inventory, Net of Allowances, Customer Advances and Progress Billings\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:InventoryNetOfAllowancesCustomerAdvancesAndProgressBillings\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:DeferredRevenueNoncurrent\", \"documentation\": \"Amount of deferred income and obligation to transfer product and service to customer for which consideration has been received or is receivable, classified as noncurrent.\", \"element_type\": \"concept\", \"id\": \"303a2035-1ca8-526b-88c7-629d8f8dfbc7\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Deferred Revenue, Noncurrent\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:DeferredRevenueNoncurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:OtherLiabilitiesCurrent\", \"documentation\": \"Amount of liabilities classified as other, due within one year or the normal operating cycle, if longer.\", \"element_type\": \"concept\", \"id\": \"4b315aa2-896d-5478-9f09-afb8f8c6e146\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Other Liabilities, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:OtherLiabilitiesCurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:PrepaidExpenseCurrent\", \"documentation\": \"Amount of asset related to consideration paid in advance for costs that provide economic benefits within a future period of one year or the normal operating cycle, if longer.\", \"element_type\": \"concept\", \"id\": \"2225e348-90bd-53cb-9784-8b5d54980a69\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Prepaid Expense, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:PrepaidExpenseCurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:AssetsCurrent\", \"documentation\": \"Amount of asset recognized for present right to economic benefit, classified as current.\", \"element_type\": \"concept\", \"id\": \"0fc9ab7e-c5ce-5277-9530-344cc127fe26\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Assets, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:AssetsCurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:IntangibleAssetsNetExcludingGoodwill\", \"documentation\": \"Amount, after accumulated amortization, of finite- and indefinite-lived intangible assets and capitalized cost for software to be sold, leased, or marketed. Excludes goodwill.\", \"element_type\": \"concept\", \"id\": \"878b3c6c-0e57-5ad3-a65c-bab2e2630129\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Intangible Assets, Net (Excluding Goodwill)\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:IntangibleAssetsNetExcludingGoodwill\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:CashAndCashEquivalentsAtCarryingValue\", \"documentation\": \"Amount of cash and cash equivalent. Cash includes, but is not limited to, currency on hand, demand deposit with financial institution, and account with general characteristic of demand deposit. Cash equivalent includes, but is not limited to, short-term, highly liquid investment that is both readily convertible to known amount of cash and so near maturity that it presents insignificant risk of change in value because of change in interest rate.\", \"element_type\": \"concept\", \"id\": \"20a6586b-880a-5745-94db-e23d397eb5e1\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Cash and Cash Equivalents, at Carrying Value\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:CashAndCashEquivalentsAtCarryingValue\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:OperatingLeaseRightOfUseAsset\", \"documentation\": \"Amount of lessee's right to use underlying asset under operating lease.\", \"element_type\": \"concept\", \"id\": \"dd95756e-eeb1-57d9-b311-5c47f6ce7510\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Operating Lease, Right-of-Use Asset\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:OperatingLeaseRightOfUseAsset\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:AccruedLiabilitiesCurrent\", \"documentation\": \"Carrying value as of the balance sheet date of obligations incurred and payable, pertaining to costs that are statutory in nature, are incurred on contractual obligations, or accumulate over time and for which invoices have not yet been received or will not be rendered. Examples include taxes, interest, rent and utilities. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer).\", \"element_type\": \"concept\", \"id\": \"4decfae2-2ca3-5dd3-8c06-88557583c13d\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Accrued Liabilities, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:AccruedLiabilitiesCurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:DeferredIncomeTaxLiabilitiesNet\", \"documentation\": \"Amount, after deferred tax asset, of deferred tax liability attributable to taxable differences with jurisdictional netting.\", \"element_type\": \"concept\", \"id\": \"a47dbfaa-167a-5cf0-8608-b8bbf8333b65\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Deferred Income Tax Liabilities, Net\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:DeferredIncomeTaxLiabilitiesNet\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:LiabilitiesCurrent\", \"documentation\": \"Total obligations incurred as part of normal operations that are expected to be paid during the following twelve months or within one business cycle, if longer.\", \"element_type\": \"concept\", \"id\": \"efb036ff-3f30-5deb-bee9-1af4cd4b9800\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Liabilities, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:LiabilitiesCurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:CommonStockValue\", \"documentation\": \"Aggregate par or stated value of issued nonredeemable common stock (or common stock redeemable solely at the option of the issuer). This item includes treasury stock repurchased by the entity. Note: elements for number of nonredeemable common shares, par value and other disclosure concepts are in another section within stockholders' equity.\", \"element_type\": \"concept\", \"id\": \"2fc1b539-b3bd-59e7-a3d6-23e24fbd36a9\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Common Stock, Value, Issued\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:CommonStockValue\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:Goodwill\", \"documentation\": \"Amount, after accumulated impairment loss, of asset representing future economic benefit arising from other asset acquired in business combination or from joint venture formation or both, that is not individually identified and separately recognized.\", \"element_type\": \"concept\", \"id\": \"6d87c413-efcf-56c9-ba04-c52024e5ddff\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Goodwill\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:Goodwill\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:ShortTermInvestments\", \"documentation\": \"Amount of investments including trading securities, available-for-sale securities, held-to-maturity securities, and short-term investments classified as other and current.\", \"element_type\": \"concept\", \"id\": \"a5d9e653-bf32-5bd6-8fca-c4508f3ac84e\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Short-Term Investments\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:ShortTermInvestments\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PreferredStockValue\", \"documentation\": \"Aggregate par or stated value of issued nonredeemable preferred stock (or preferred stock redeemable solely at the option of the issuer). This item includes treasury stock repurchased by the entity. Note: elements for number of nonredeemable preferred shares, par value and other disclosure concepts are in another section within stockholders' equity.\", \"element_type\": \"concept\", \"id\": \"e5159a0a-cb39-5b8e-a467-d9a4b2653a6a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Preferred Stock, Value, Issued\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:PreferredStockValue\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:LongTermDebtCurrent\", \"documentation\": \"Amount, after deduction of unamortized premium (discount) and debt issuance cost, of long-term debt classified as current. Excludes lease obligation.\", \"element_type\": \"concept\", \"id\": \"cb601c1e-10a6-571b-bcd9-6e40a6a80bd6\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Long-Term Debt, Current Maturities\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:LongTermDebtCurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:RestrictedCashAndInvestmentsCurrent\", \"documentation\": \"The current cash, cash equivalents and investments that are restricted as to withdrawal or usage. Restrictions may include legally restricted deposits held as compensating balances against short-term borrowing arrangements, contracts entered into with others, or entity statements of intention with regard to particular deposits; however, time deposits and short-term certificates of deposit are not generally included in legally restricted deposits. Excludes compensating balance arrangements that are not agreements which legally restrict the use of cash amounts shown on the balance sheet. Includes current cash equivalents and investments that are similarly restricted as to withdrawal, usage or disposal.\", \"element_type\": \"concept\", \"id\": \"488ac9be-588e-5ffa-92c9-a06d71f3d759\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Restricted Cash and Investments, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:RestrictedCashAndInvestmentsCurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:FinanceLeaseRightOfUseAsset\", \"documentation\": \"Amount, after accumulated amortization, of right-of-use asset from finance lease.\", \"element_type\": \"concept\", \"id\": \"84e44859-bd30-57c7-aec8-5f4a8a11f88a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Finance Lease, Right-of-Use Asset, after Accumulated Amortization\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:FinanceLeaseRightOfUseAsset\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:OtherLiabilitiesNoncurrent\", \"documentation\": \"Amount of liabilities classified as other, due after one year or the normal operating cycle, if longer.\", \"element_type\": \"concept\", \"id\": \"bccf56dc-f0b8-5388-9777-49147f6c1a41\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Other Liabilities, Noncurrent\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:OtherLiabilitiesNoncurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:FinanceLeaseLiabilityCurrent\", \"documentation\": \"Present value of lessee's discounted obligation for lease payments from finance lease, classified as current.\", \"element_type\": \"concept\", \"id\": \"326daf36-397c-523d-89cd-c3e209ee84d2\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Finance Lease, Liability, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:FinanceLeaseLiabilityCurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:AccumulatedOtherComprehensiveIncomeLossNetOfTax\", \"documentation\": \"Amount, after tax, of accumulated increase (decrease) in equity from transaction and other event and circumstance from nonowner source.\", \"element_type\": \"concept\", \"id\": \"9c1ec90c-fe3a-5ef7-95e2-a0c689e2acd9\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Accumulated Other Comprehensive Income (Loss), Net of Tax\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:AccumulatedOtherComprehensiveIncomeLossNetOfTax\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:ReceivablesNetCurrent\", \"documentation\": \"The total amount due to the entity within one year of the balance sheet date (or one operating cycle, if longer) from outside sources, including trade accounts receivable, notes and loans receivable, as well as any other types of receivables, net of allowances established for the purpose of reducing such receivables to an amount that approximates their net realizable value.\", \"element_type\": \"concept\", \"id\": \"44686df3-3871-5c1f-8a08-fc542d69dfa0\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Receivables, Net, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:ReceivablesNetCurrent\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:StockholdersEquity\", \"documentation\": \"Amount of equity (deficit) attributable to parent. Excludes temporary equity and equity attributable to noncontrolling interest.\", \"element_type\": \"concept\", \"id\": \"e3796201-9899-5b7b-9477-659550ba8e68\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Stockholders' Equity Attributable to Parent\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:StockholdersEquity\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:AssetsNoncurrent\", \"documentation\": \"Sum of the carrying amounts as of the balance sheet date of all assets that are expected to be realized in cash, sold or consumed after one year or beyond the normal operating cycle, if longer.\", \"element_type\": \"concept\", \"id\": \"841cedeb-4cb0-532a-b0bd-c34846a13a8c\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Assets, Noncurrent\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:AssetsNoncurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:LongTermInvestmentsAndReceivablesNet\", \"documentation\": \"The total amount of investments that are intended to be held for an extended period of time (longer than one operating cycle) and amount due to the Entity from outside sources, including trade accounts receivable, notes and loans receivable, as well as any other types of receivables, net of allowances established for the purpose of reducing such investments and receivables to an amount that approximates their net realizable value.\", \"element_type\": \"concept\", \"id\": \"a9141c4d-0113-5095-91c3-5d69385fb89c\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Long-Term Investments and Receivables, Net\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:LongTermInvestmentsAndReceivablesNet\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:PropertyPlantAndEquipmentNet\", \"documentation\": \"Amount, after accumulated depreciation, depletion, and amortization, of property, plant, and equipment. Includes, but is not limited to, land and land improvement; building; machinery and equipment; furniture and fixture; and work of art, historical treasure, or similar asset classified as collection.\", \"element_type\": \"concept\", \"id\": \"288099af-5cbb-5f78-8f8a-1a85675fb661\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Property, Plant and Equipment, Net\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:PropertyPlantAndEquipmentNet\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:AccountsPayableCurrent\", \"documentation\": \"Carrying value as of the balance sheet date of liabilities incurred (and for which invoices have typically been received) and payable to vendors for goods and services received that are used in an entity's business. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer).\", \"element_type\": \"concept\", \"id\": \"9ddbc9d7-c769-5800-8f65-1089d476e5c9\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Accounts Payable, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:AccountsPayableCurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:Assets\", \"documentation\": \"Amount of asset recognized for present right to economic benefit.\", \"element_type\": \"concept\", \"id\": \"a1f04756-41d8-5d35-b821-23aa2f3b2fae\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Assets\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:Assets\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:DebtCurrent\", \"documentation\": \"Amount of debt and lease obligation, classified as current.\", \"element_type\": \"concept\", \"id\": \"76b2489a-b8a5-57d4-8f48-34fab49ce605\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Debt, Current\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:DebtCurrent\"}, {\"balance_type\": \"debit\", \"code\": \"rs-gaap:TreasuryStockValue\", \"documentation\": \"The amount allocated to treasury stock. Treasury stock is common and preferred shares of an entity that were issued, repurchased by the entity, and are held in its treasury.\", \"element_type\": \"concept\", \"id\": \"f6d5fee3-1a7c-5aba-8abb-d284dd53060a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Treasury Stock, Value\", \"period_type\": \"instant\", \"qname\": \"rs-gaap:TreasuryStockValue\"}], \"fact_set\": {\"entity_id\": \"entity_kg1a09d99ffade793a8fc3\", \"factset_type\": \"report\", \"id\": \"fs_01M2ESN4RKT456YTDGGPED2KD8\", \"period_end\": \"2026-08-31\", \"period_start\": \"2024-09-01\", \"provenance\": {\"arc_type\": null, \"mapping_id\": \"struct_01M2ESM2M35X8PGBWGBPFJ8PCS\", \"origin\": \"pivot\", \"period\": \"2024-09-01/2026-08-31\", \"posting_filter\": null}, \"report_id\": \"rpt_01M2ESN4NJ653NB5YSWP8C4MKQ\", \"structure_id\": \"b6dfb8d2-8ee9-5597-9a3b-8aeee625ff0d\"}, \"facts\": [{\"element_id\": \"9ddbc9d7-c769-5800-8f65-1089d476e5c9\", \"element_name\": \"Accounts Payable, Current\", \"element_qname\": \"rs-gaap:AccountsPayableCurrent\", \"fact_scope\": \"in_scope\", \"fact_set_id\": \"fs_01M2ESN4RKT456YTDGGPED2KD8\", \"fact_type\": \"Numeric\", \"id\": \"fact_01M2ESN4S6PF2ZYWZBS2REAQJW\", \"period_end\": \"2026-08-31\", \"period_start\": \"2025-09-01\", \"period_type\": \"instant\", \"unit\": \"USD\", \"value\": 0.0}, {\"element_id\": \"6146