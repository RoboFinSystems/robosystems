fications\": [], \"from_element_id\": \"e3796201-9899-5b7b-9477-659550ba8e68\", \"id\": \"2cdef3d9-e89f-52a9-9618-673ca30df582\", \"order_value\": 40200.0, \"to_element_id\": \"3a26f076-d6ea-55b2-a2a9-c02059a383f9\"}], \"dimensions\": [], \"disclosure_id\": \"disclosures:StatementOfChangesInEquity\", \"display_name\": \"Equity Statement\", \"elements\": [{\"balance_type\": \"credit\", \"code\": \"rs-gaap:NetIncomeLoss\", \"documentation\": \"The portion of profit or loss for the period, net of income taxes, which is attributable to the parent.\", \"element_type\": \"concept\", \"id\": \"27a05717-2370-51c2-a924-db5cbcb48219\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Net Income (Loss) Attributable to Parent\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:NetIncomeLoss\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PaymentsOfDividends\", \"documentation\": \"Cash outflow in the form of capital distributions and dividends to common shareholders, preferred shareholders and noncontrolling interests.\", \"element_type\": \"concept\", \"id\": \"2c1770d4-5f7d-5081-9e1b-59bc87d25efc\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Payments of Dividends\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:PaymentsOfDividends\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:PaymentsForRepurchaseOfCommonStock\", \"documentation\": \"The cash outflow to reacquire common stock during the period.\", \"element_type\": \"concept\", \"id\": \"d5420297-3894-53c5-8499-00d5cd096c6a\", \"is_abstract\": false, \"is_monetary\": true, \"name\": \"Payments for Repurchase of Common Stock\", \"period_type\": \"duration\", \"qname\": \"rs-gaap:PaymentsForRepurchaseOfCommonStock\"}, {\"balance_type\": \"credit\", \"code\": \"rs-gaap:OtherComprehensiveIncomeLossNetOfTax\", \"documentation\": \"Amount after tax and reclassification adjustments of other comprehensive income (loss).\", \"element_type\": \"concept\", \"id\": \"3a26f076-d6ea-55b2-a