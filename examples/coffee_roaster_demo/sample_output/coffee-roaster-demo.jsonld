      ],
      "internalId": "struct_01M2ESMEHA4VCDAQKDA18FGVZF",
      "prefLabel": "Significant Accounting Policies",
      "roleUri": "https://driftlinecoffee.example.com/roles/disclosures/AccountingPolicies",
