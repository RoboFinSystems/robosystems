  "standard": "fac-calculations",
  "version": "v1",
  "namespace_uri": "http://www.xbrlsite.com/fac/calculations/",
  "taxonomy_type": "mapping",
  "description": "FAC's BS/IS/CF accounting identity rules rendered as XBRL calculation arcs. 22 identities (BS1-5, IS1-11, CF1-6), each materialized as a Structure + reified summation arcs from the aggregate head to each signed constituent. arcWeight carries +1/-1; arcRoleUri binds each arc to its identity's structure so overlapping heads (Assets in BS2+BS3, OperatingIncomeLoss in IS2+IS11) stay separable.",
  "@graph": [
    {
      "@id": "_:fac-calc-bs1",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/BS1",
      "structureName": "FAC BS1 — Equity = Parent + Noncontrolling",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-bs2",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/BS2",
      "structureName": "FAC BS2 — Assets = Liabilities + Equity",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-bs3",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/BS3",
      "structureName": "FAC BS3 — Assets = Current + Noncurrent (classified BS)",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-bs4",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/BS4",
      "structureName": "FAC BS4 — Liabilities = Current + Noncurrent (classified BS)",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-bs5",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/BS5",
      "structureName": "FAC BS5 — L+E = Liabilities + Commitments + Temp. Equity + Equity",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is1",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS1",
      "structureName": "FAC IS1 — Gross Profit = Revenues − Cost of Revenue (multi-step)",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is2",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS2",
      "structureName": "FAC IS2 — Operating Income = Gross Profit − Operating Exp. + Other Operating (multi-step)",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is3",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS3",
      "structureName": "FAC IS3 — Income Before Equity-Method Investments = Operating + Nonoperating − Interest & Debt",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is4",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS4",
      "structureName": "FAC IS4 — Income from Continuing Ops Before Tax = Before Equity-Method + Equity-Method Investments",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is5",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS5",
      "structureName": "FAC IS5 — Income from Continuing Ops After Tax = Before Tax − Income Tax Expense",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is6",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS6",
      "structureName": "FAC IS6 — Net Income = Continuing (After Tax) + Discontinued (Net of Tax)",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is7",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS7",
      "structureName": "FAC IS7 — Net Income = Parent + Noncontrolling",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is8",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS8",
      "structureName": "FAC IS8 — NI Available to Common (Basic) = Parent − Preferred Dividends & Other",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is9",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS9",
      "structureName": "FAC IS9 — Comprehensive Income = Parent + Noncontrolling",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is10",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS10",
      "structureName": "FAC IS10 — Comprehensive Income = Net Income + Other Comprehensive Income",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-is11",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/IS11",
      "structureName": "FAC IS11 — Operating Income = Revenues − Costs&Expenses + Other Operating (single-step)",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-cf1",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/CF1",
      "structureName": "FAC CF1 — Net Cash Flow = Operating + Investing + Financing + Exchange Gain/Loss",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-cf2",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/CF2",
      "structureName": "FAC CF2 — Net Cash Flows Continuing = Operating + Investing + Financing (Continuing)",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-cf3",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/CF3",
      "structureName": "FAC CF3 — Net Cash Flows Discontinued = Operating + Investing + Financing (Discontinued)",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-cf4",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/CF4",
      "structureName": "FAC CF4 — Operating Net Cash Flow = Continuing + Discontinued",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-cf5",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/CF5",
      "structureName": "FAC CF5 — Investing Net Cash Flow = Continuing + Discontinued",
      "blockType": "validation_rules"
    },
    {
      "@id": "_:fac-calc-cf6",
      "roleUri": "http://www.xbrlsite.com/seattlemethod/conceptual-model/cm-roles/roles/fac-calculations/CF6",
      "structureName": "FAC CF6 — Financing Net Cash Flow = Continuing + Discontinued",
      "blockType": "validation_rules"
    },
