        {
          "@language": "en-US",
          "@value": "Amount of payable due to an entity that is affiliated with the reporting entity by means of direct or indirect ownership. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer)."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToAffiliateNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Affiliate, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of receivables owed to an entity that is affiliated with the reporting entity by means of direct or indirect ownership, which are usually due after one year (or one business cycle, if longer)."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToEmployeesCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Employees, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amounts due to employees, not to include stockholders or officers. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer)."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToEmployeesNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Employees, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amounts due to Employee, not to include stockholders or officers, which are due after one year (or one business cycle)."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToOfficersOrStockholdersCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Officers or Stockholders, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amounts due to recorded owners or owners with a beneficial interest of more than 10 percent of the voting interests or officers of the company. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer)."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToOfficersOrStockholdersNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Officers or Stockholders, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amounts due to recorded owners or owners with a beneficial interest of more than 10 percent of the voting interests or officers of the company, which are due after one year (or one business cycle)."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToOtherRelatedPartiesClassifiedCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Other Related Parties, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount payable to related parties classified as other, due within one year or the normal operating cycle, if longer."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToOtherRelatedPartiesNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Other Related Parties, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount payable from related parties classified as other, due after one year or the normal operating cycle, if longer."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToRelatedPartiesCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Related Parties, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Carrying amount as of the balance sheet date of obligations due all related parties. For classified balance sheets, represents the current portion of such liabilities (due within one year or within the normal operating cycle if longer)."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nc212cb4d11b843308cec37f89a158b4c"
        }
      ]
    },
    {
      "@id": "rs-gaap:DueToRelatedPartiesNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Due to Related Parties, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Portion of the carrying amount as of the balance sheet date of obligations due all related parties that is payable after one year or beyond the normal operating cycle if longer."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nc8fa189a42d945ebaa9d56a73027ceff"
        }
      ]
    },
    {
      "@id": "rs-gaap:EffectOfExchangeRateOnCash",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Effect of Exchange Rate on Cash"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of effect of exchange rate changes on cash balances held in foreign currencies. Excludes cash equivalents."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nad7049b44e3e41baa6bf680120ae4806"
        }
      ]
    },
    {
      "@id": "rs-gaap:EffectOfExchangeRateOnCashAndCashEquivalents",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Effect of Exchange Rate on Cash and Cash Equivalents"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of increase (decrease) from the effect of exchange rate changes on cash and cash equivalent balances held in foreign currencies."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Ncc057c1fdac54fd9acae986bf72b8a49"
        }
      ]
    },
    {
      "@id": "rs-gaap:EffectOfExchangeRateOnCashAndCashEquivalentsContinuingOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Effect of Exchange Rate on Cash and Cash Equivalents, Continuing Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The effect of exchange rate changes on cash balances in continuing operations held in foreign currencies."
        }
      ]
    },
    {
      "@id": "rs-gaap:EffectOfExchangeRateOnCashAndCashEquivalentsDiscontinuedOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Effect of Exchange Rate on Cash and Cash Equivalents, Discontinued Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The effect of exchange rate changes on cash balances in discontinuing operations held in foreign currencies."
        }
      ]
    },
    {
      "@id": "rs-gaap:EffectOfExchangeRateOnCashContinuingOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Effect of Exchange Rate on Cash, Continuing Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of effect of exchange rate changes on cash balances in continuing operations held in foreign currencies. Excludes cash equivalents."
        }
      ]
    },
    {
      "@id": "rs-gaap:ElectricDomesticRegulatedRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Electric Domestic Regulated Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue derived from the regulated (by a federal, state, or local government or agency) generation, transmission and distribution of electricity."
        }
      ]
    },
    {
      "@id": "rs-gaap:ElectricUtilityRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Electric Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate revenue, whether regulated or unregulated, derived from the generation, transmission and distribution of electricity."
        }
      ]
    },
    {
      "@id": "rs-gaap:ElectricalGenerationRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Electrical Generation Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from generation of electricity, a process of producing electric energy by transforming other forms of energy such as nuclear, fossil fuel, solar, geothermal, hydro, and wind."
        }
      ]
    },
    {
      "@id": "rs-gaap:ElectricalTransmissionAndDistributionRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Electrical Transmission and Distribution Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from (1) electrical transmission, which is the bulk transport of high voltage power, typically over longer distances, between generating plants and distribution systems, and (2) electrical distribution, which is the delivery of electricity to a retail customer's home or business through distribution wires or facilities of regulated public utilities."
        }
      ]
    },
    {
      "@id": "rs-gaap:EmployeeBenefitsAndShareBasedCompensation",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Employee Benefits and Share-based Compensation"
        }
      ]
    },
