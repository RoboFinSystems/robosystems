        {
          "@id": "_:N6ec94f1298d54eb9b9563870c88c5565"
        }
      ]
    },
    {
      "@id": "rs-gaap:ConstructionLoanNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Long-term Construction Loan, Noncurrent"
        }
      ]
    },
    {
      "@id": "rs-gaap:ConstructionMaterialsRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Construction Materials Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from sale of construction products and materials, including clay and brick products, ceramic floor and wall tile, framing structures and doors, insulation, roofing, wallboard, and other construction products."
        }
      ]
    },
    {
      "@id": "rs-gaap:ContractReceivableDueAfterOneYear",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N39fda2c930514f52b7e9efdc25d47f79"
        }
      ]
    },
    {
      "@id": "rs-gaap:ContractRevenueCost",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Contract Revenue Cost (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Costs incurred and are directly related to generating contract revenues."
        }
      ]
    },
    {
      "@id": "rs-gaap:ContractWithCustomerAssetNetCurrent",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Ncda02950bd9648068d0b99734a5ef6a6"
        }
      ]
    },
    {
      "@id": "rs-gaap:ContractWithCustomerAssetNetNoncurrent",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N56bbb2297964499796832d9f41d1e7b2"
        }
      ]
    },
    {
      "@id": "rs-gaap:ContractsRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Contracts Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of revenue earned from products sold or services provided under the terms of a contract, including, but not limited to, government contracts and construction contracts, classified as other."
        }
      ]
    },
    {
      "@id": "rs-gaap:ContractuallySpecifiedServicingFeesLateFeesAndAncillaryFeesEarnedInExchangeForServicingFinancialAssets",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nc2dc81fb2c9c4a2a9d731ee6fbd7c6be"
        }
      ]
    },
    {
      "@id": "rs-gaap:CorporateAndOtherMember",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Corporate and Other [Member]"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Component of an entity that provides financial and operational oversight and administrative support for other segments and other segments not separately reported due to size or nature of business activities. Excludes intersegment elimination and reconciling items."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfGoldProductsAndServices",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Gold Products and Services (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Cost incurred related to exploration, development, mining, processing and providing mining support activities related to gold."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfGoodsAndServicesSold",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Goods and Services Sold"
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nfce034f86f1648a1851e73b79fdd3451"
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfGoodsAndServicesSoldDepreciationAndAmortization",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N5a84d18a49044457bb5e091eeb36c927"
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfGoodsSold",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Goods Sold (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Total costs related to goods produced and sold during the reporting period."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfGoodsSoldDirectMaterials",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Goods Sold, Direct Materials (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Cost of materials used in goods produced and sold during the reporting period."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfGoodsSoldElectric",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Goods Sold, Electric (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Total costs related to electricity produced and sold during the reporting period."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfGoodsSoldExcludingDepreciationDepletionAndAmortization",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Goods Sold, Excluding Depreciation, Depletion, and Amortization (Deprecated 2019-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate cost of goods produced and sold during the reporting period, excluding depreciation, depletion, and amortization."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfGoodsSoldOilAndGas",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Goods Sold, Oil and Gas (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Total costs related to oil and gas produced and sold during the reporting period."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfMerchandiseSalesBuyingAndOccupancyCosts",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Merchandise Sales, Buying and Occupancy Costs (Deprecated 2019-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate of buying and occupancy costs reported during the period related to merchandise sold. Costs could include, but not be limited to, inbound and outbound freight; costs of operating distribution centers; payroll, benefits, and travel costs directly associated with buying inventory; systems costs related to the buying and tracking of inventory; rent; depreciation; property taxes; and facility operations."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfNaturalGasPurchases",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Natural Gas Purchases (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Cost of natural gas purchased and associated transportation and storage costs during the period."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfRealEstateRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Real Estate Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "This element represents the total of the costs related to real estate revenues, including management, leasing, and development services."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfRealEstateSales",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Real Estate Sales (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Reflects for the period the total of the carrying amount of the commercial, industrial and residential land and buildings sold plus certain overhead and other costs incurred to place the real estate in saleable condition, capitalized interest costs in the properties sold, and inventory impairment losses recognized. This element would most likely be used by an entity whose principal activities involve real estate or which has significant real estate operations."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfRevenue",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N500c344632b24e74bcc6dbb31b464e99"
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfServices",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Services (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Total costs related to services rendered by an entity during the reporting period."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfServicesExcludingDepreciationDepletionAndAmortization",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Services, Excluding Depreciation, Depletion, and Amortization (Deprecated 2019-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate cost of services rendered during the reporting period, excluding depreciation, depletion and amortization."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostOfServicesOilAndGas",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cost of Services, Oil and Gas (Deprecated 2019-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Costs of generating revenue from oil and gas-related services including well services (such as drilling, rigs and analytic evaluations), transportation, and other supporting contractor services, during the reporting period."
        }
      ]
    },
    {
      "@id": "rs-gaap:CostsAndExpenses",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nd1bd4e173530456198c657307b184921"
        }
      ]
    },
    {
      "@id": "rs-gaap:CreditAndDebitCardReceivablesAtCarryingValue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Credit and Debit Card Receivables, at Carrying Value"
        }
      ]
    },
    {
      "@id": "rs-gaap:CreditDefaultSwapMember",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "A type of swap transaction used as a credit derivative in which one party makes periodic payments to the other and receives the promise of a pay-off if a third party defaults."
        }
      ]
    },
    {
      "@id": "rs-gaap:CurrentIncomeTaxExpenseBenefit",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Ndf3333d7a53a4bb5b9cadc1ca0bc4c95"
        }
      ]
    },
    {
      "@id": "rs-gaap:DebtCurrent",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of short-term debt and current maturity of long-term debt and capital lease obligations due within one year or the normal operating cycle, if longer."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N0b31d13f458343f8909e3b076fdfc638"
        }
      ]
    },
    {
      "@id": "rs-gaap:DeferredCompensationCashBasedArrangementsLiabilityCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
