      "@id": "rs-gaap:RepaymentsOfLongTermDebtAndCapitalSecurities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Repayment of Long-term Debt, Long-term Lease Obligation, and Capital Security"
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nb603797c91eb403b8691d302c1fe535d"
        }
      ]
    },
    {
      "@id": "rs-gaap:RepaymentsOfLongTermLinesOfCredit",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Repayments of Long-term Lines of Credit"
        }
      ]
    },
    {
      "@id": "rs-gaap:RepaymentsOfLongtermLoansFromVendors",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Repayments of Long-term Loans from Vendors"
        }
      ]
    },
    {
      "@id": "rs-gaap:RepaymentsOfMediumTermNotes",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Repayments of Medium-term Notes"
        }
      ]
    },
    {
      "@id": "rs-gaap:RepaymentsOfOtherLongTermDebt",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Repayments of Other Long-term Debt"
        }
      ]
    },
    {
      "@id": "rs-gaap:RepaymentsOfOtherShortTermDebt",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Repayments of Other Short-term Debt"
        }
      ]
    },
    {
      "@id": "rs-gaap:RepaymentsOfSeniorDebt",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N632747fa3e844a68a56485e9c70978f8"
        }
      ]
    },
    {
      "@id": "rs-gaap:RepaymentsOfSubordinatedDebt",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N612f9e307cbe4638bb12c8ca7ec43449"
        }
      ]
    },
    {
      "@id": "rs-gaap:RepaymentsOfSubordinatedShortTermDebt",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Repayments of Subordinated Short-term Debt"
        }
      ]
    },
    {
      "@id": "rs-gaap:ResearchAndDevelopmentAssetAcquiredOtherThanThroughBusinessCombinationWrittenOff",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Research and Development Asset Acquired Other than Through Business Combination, Written-off"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The amount of the write-off for research and development assets that were acquired in a transaction other than a business combination."
        }
      ]
    },
    {
      "@id": "rs-gaap:ResearchAndDevelopmentExpense",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate costs incurred (1) in a planned search or critical investigation aimed at discovery of new knowledge with the hope that such knowledge will be useful in developing a new product or service, a new process or technique, or in bringing about a significant improvement to an existing product or process; or (2) to translate research findings or other knowledge into a plan or design for a new product or process or for a significant improvement to an existing product or process whether intended for sale or the entity's use, during the reporting period charged to research and development projects, including the costs of developing computer software up to the point in time of achieving technological feasibility, and costs allocated in accounting for a business combination to in-process projects deemed to have no alternative future use."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N9943acc780de42ea8c0d9f7e88f2068f"
        }
      ]
    },
    {
      "@id": "rs-gaap:ResearchAndDevelopmentExpenseExcludingAcquiredInProcessCost",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The costs incurred in a planned search or critical investigation aimed at discovery of new knowledge with the hope that such knowledge will be useful in developing a new product or service, a new process or technique, or in bringing about a significant improvement to an existing product or process; or to translate research findings or other knowledge into a plan or design for a new product or process or for a significant improvement to an existing product or process whether intended for sale or the entity's use, during the reporting period charged to research and development projects, excluding in-process research and development acquired in a business combination consummated during the period. Excludes software research and development, which has a separate concept."
        }
      ]
    },
    {
      "@id": "rs-gaap:ResearchAndDevelopmentInProcess",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Research and Development in Process"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The amount of purchased research and development assets that are acquired in a business combination have no alternative future use and are therefore written off in the period of acquisition."
        }
      ]
    },
    {
      "@id": "rs-gaap:RestrictedCashAndCashEquivalentsAtCarryingValue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Restricted Cash and Cash Equivalents, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash and cash equivalents restricted as to withdrawal or usage, classified as current. Cash includes, but is not limited to, currency on hand, demand deposits with banks or financial institutions, and other accounts with general characteristics of demand deposits. Cash equivalents include, but are not limited to, short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N9127f9d872694295bfcd91befda93e18"
        }
      ]
    },
    {
      "@id": "rs-gaap:RestrictedCashAndCashEquivalentsNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Restricted Cash and Cash Equivalents, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash and cash equivalents restricted as to withdrawal or usage, classified as noncurrent. Cash includes, but is not limited to, currency on hand, demand deposits with banks or financial institutions, and other accounts with general characteristics of demand deposits. Cash equivalents include, but are not limited to, short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N8d5ca771aa594299b328ec0553651070"
        }
      ]
    },
    {
      "@id": "rs-gaap:RestrictedCashAndInvestmentsCurrent",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N585f60c2c60e4f7e8e2134a6cdd23caf"
        }
      ]
    },
    {
      "@id": "rs-gaap:RestrictedCashAndInvestmentsNoncurrent",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N614288737a004ea49decf573d3ac88b1"
        }
      ]
    },
    {
      "@id": "rs-gaap:RestrictedCashEquivalentsCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Restricted Cash Equivalents, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash equivalents restricted as to withdrawal or usage, classified as current. Cash equivalents include, but are not limited to, short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates."
        }
      ]
    },
    {
      "@id": "rs-gaap:RestrictedCashEquivalentsNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Restricted Cash Equivalents, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash equivalents restricted as to withdrawal or usage, classified as noncurrent. Cash equivalents include, but are not limited to, short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates."
        }
      ]
    },
    {
      "@id": "rs-gaap:RestructuringCharges",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N92b1f703d695449abe9f44e64282c774"
        }
      ]
    },
    {
      "@id": "rs-gaap:RestructuringCosts",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N672924626c8a458cb9b5826060ffb53f"
        }
      ]
    },
    {
      "@id": "rs-gaap:RestructuringCostsAndAssetImpairmentCharges",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N76873faafa814c9995851d4e65a398c7"
        }
      ]
    },
    {
      "@id": "rs-gaap:RestructuringSettlementAndImpairmentProvisions",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N90fd8688839547eca7cc7d9f50996d32"
        }
      ]
    },
    {
      "@id": "rs-gaap:ResultsOfOperationsGeneralAndAdministrativeRelatedToOilAndGasProducingActivities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Results of Operations, General and Administrative Related to Oil and Gas Producing Activities"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "General and administrative costs from oil & gas producing activities."
        }
      ]
    },
    {
      "@id": "rs-gaap:RetailRelatedInventory",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N8bdacc4cd5db42268041edca1b7454f8"
        }
      ]
    },
    {
      "@id": "rs-gaap:RetailRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Retail Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "This element represents revenues generated by or derived from a hotel's, or cruise line's, owned retail store operations."
        }
      ]
    },
    {
      "@id": "rs-gaap:RetainedEarningsAccumulatedDeficit",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The cumulative amount of the reporting entity's undistributed earnings or deficit."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N4bccaca869e94699b853238d4edb6e10"
        },
        {
          "@id": "_:Nab2b4bac1cb14801b105572493bd2621"
        },
        {
          "@id": "_:Ne1e1e2a8bffd4ff3afc7b8ed3e1bcb97"
        }
      ]
    },
    {
      "@id": "rs-gaap:RetainedEarningsAppropriated",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "A segregation of retained earnings which is unavailable for dividend distribution. Includes also retained earnings appropriated for loss contingencies."
        }
      ]
    },
    {
      "@id": "rs-gaap:RetainedEarningsUnappropriated",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "A segregation of retained earnings which is available for dividend distribution. Earnings not paid out as dividends but instead reinvested in the core business or used to pay off debt. Unappropriated profit is part of shareholder equity. Also called cumulative distributions or earned surplus or accumulated earnings or unappropriated profit."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueFromEnrollmentAndRegistrationFeesExcludingHospitalityEnterprises",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue from Enrollment and Registration Fees, Excluding Hospitality Enterprises (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue earned during the period from enrollment, registration and customer start up fees. Commonly used in health and fitness clubs and other membership clubs, but excluding hotel, cruise lines, casinos, and other hospitality concerns which are included in Facility Membership and Operations Revenue."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueFromGrants",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue from Grants (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue earned during the period from non-repayable sum of money awarded to an entity to carry out a specific purpose as provided in grant agreements."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueFromLeasedAndOwnedHotels",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue from Hotels (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount, net of promotional allowances, of revenue from managing and operating hotels, including, but not limited to, revenue from occupancy, casino, food and beverage, and retail. Excludes operating lease income."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueFromPurchasedOilAndGas",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue from Purchased Oil and Gas (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from sale of oil and gas purchased from other sources."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueFromRelatedParties",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue from Related Parties"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of revenue, fees and commissions earned from transactions between (a) a parent company and its subsidiaries; (b) subsidiaries of a common parent; (c) an entity and trusts for the benefit of employees, for example, but not limited to, pension and profit-sharing trusts that are managed by or under the trusteeship of the entity's management; (d) an entity and its principal, owners, management, or members of their immediate families; and (e) affiliates."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueMineralSales",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue Mineral Sales (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Aggregate revenue from the sale of minerals and related products, and from rendering services such as exploration, development, mining, processing and providing mining support activities."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueOilAndGasServices",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue, Oil and Gas Services (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from oil and gas-related services including well services (such as drilling, rigs and analytic evaluations), transportation, and other supporting contractor services, during the reporting period."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueOtherManufacturedProducts",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue Other Manufactured Products (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of revenue from the sale of manufactured products, classified as other."
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenueSteamProductsAndServices",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue Steam Products and Services (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue generated from providing steam products and services to various industries. Steam is used in oil refineries, pulp and paper mills, chemical production (such as ethylene and ammonia), food and grain processing, and textiles. Steam is also used in the heating and cooling of urban commercial and residential buildings."
        }
      ]
    },
    {
      "@id": "rs-gaap:Revenues",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N65a479fd236b4ae09eabb8f1c8553de9"
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenuesExcludingInterestAndDividends",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N257b5a9d1616478d9ff6803e847df8c3"
        }
      ]
    },
    {
      "@id": "rs-gaap:RevenuesNetOfInterestExpense",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nbbbe6caa99f34ac9b64b886b4982a8f7"
        }
      ]
    },
    {
      "@id": "rs-gaap:RoyaltyRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Royalty Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue earned during the period from the leasing or otherwise lending to a third party the entity's rights or title to certain property. Royalty revenue is derived from a percentage or stated amount of sales proceeds or revenue generated by the third party using the entity's property. Examples of property from which royalties may be derived include patents and oil and mineral rights."
        }
      ]
    },
    {
      "@id": "rs-gaap:SalariesWagesAndOfficersCompensation",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nb9196bf99e924acf9d89af917944827a"
        }
      ]
    },
    {
      "@id": "rs-gaap:SalesOfOilAndGasProspects",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Sales of Oil and Gas Prospects (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue derived from sale of oil and gas exploratory and developmental prospects."
        }
      ]
    },
    {
      "@id": "rs-gaap:SalesOfRealEstate",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Sales of Real Estate (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from the sale of commercial, industrial, or residential property during the period. This element is more likely than not relevant to an entity for which real estate operations are a principal activity. If real estate operations are not a principal activity, the reporting entity would likely use a gain (loss) on sale of property, plant, or equipment type element."
        }
      ]
    },
    {
      "@id": "rs-gaap:SalesRevenueEnergyServices",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Sales Revenue, Energy Services (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue derived from energy-related services such as supplying various forms of energy from the operation of on-site facilities or cogeneration plants and procurement services provided to energy purchasers."
        }
      ]
    },
    {
      "@id": "rs-gaap:SalesRevenueFromEnergyCommoditiesAndServices",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Sales Revenue from Energy Commodities and Services (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue derived from energy-related services such supplying various forms of energy (such as steam, electricity and chilled water from the operation of on-site facilities or cogeneration plants), procurement services provided to energy purchasers, and the marketing and trading of energy commodities and derivatives."
        }
      ]
    },
    {
      "@id": "rs-gaap:SalesRevenueGoodsNet",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Sales Revenue, Goods, Net (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Aggregate revenue during the period from the sale of goods in the normal course of business, after deducting returns, allowances and discounts."
        }
      ]
    },
    {
      "@id": "rs-gaap:SalesRevenueNet",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Revenue, Net (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Total revenue from sale of goods and services rendered during the reporting period, in the normal course of business, reduced by sales returns and allowances, and sales discounts."
        }
      ]
    },
    {
      "@id": "rs-gaap:SalesRevenueServicesNet",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Sales Revenue, Services, Net (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Aggregate revenue during the period from services rendered in the normal course of business, after deducting allowances and discounts."
        }
      ]
