      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N1aca6a3b2ea147af98eb709e327c904d"
        }
      ]
    },
    {
      "@id": "rs-gaap:ComprehensiveIncomeNetOfTaxAttributableToNoncontrollingInterest",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nf9b30511200b40bfad4781272a2c2ed3"
        }
      ]
    },
    {
      "@id": "rs-gaap:ComprehensiveIncomeNetOfTaxIncludingPortionAttributableToNoncontrollingInterest",
