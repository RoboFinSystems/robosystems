      ]
    },
    {
      "@id": "rs-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Stockholders' Equity, Including Portion Attributable to Noncontrolling Interest"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of stockholders' equity (deficit), net of receivables from officers, directors, owners, and affiliates of the entity, attributable to both the parent and noncontrolling interests. Amount excludes temporary equity. Alternate caption for the concept is permanent equity."
        }
      ],
