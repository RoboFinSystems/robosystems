          "@value": "Amounts due from owners or owners with a beneficial interest of more than 10 percent of the voting interests or officers of the company, which are usually due within 1 year (or 1 business cycle)."
        }
      ]
    },
    {
      "@id": "rs-gaap:DueFromOfficersOrStockholdersNoncurrent",
