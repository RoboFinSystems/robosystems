    {
      "@id": "rs-gaap:AccountsPayableRelatedPartiesCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Accounts Payable, Related Parties, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount for accounts payable to related parties. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer)."
        }
      ]
    },
