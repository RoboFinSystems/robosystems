        }
      ]
    },
    {
      "@id": "rs-gaap:FederalIncomeTaxExpenseBenefitContinuingOperations",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of current and deferred federal income tax expense (benefit) attributable to income (loss) from continuing operations."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N3d4ae2cc1b074c448f347c392864a378"
        }
      ]
    },
    {
      "@id": "rs-gaap:FeesAndCommissions",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Fees and Commissions (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of fees and commissions from financial services and banking activities and correspondent clearing. Includes fees from depositor accounts, credit cards, merchant discounts, and fiduciary and trust activities, guarantee fees, investment advisory, management, and administrative fees, transfer agent fees, and insurance commissions."
        }
      ]
    },
    {
      "@id": "rs-gaap:FinanceLeaseRightOfUseAsset",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Ned2ea74e27e046dfa625513e463dcddc"
        }
      ]
    },
    {
      "@id": "rs-gaap:FinancialServicesCosts",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Financial Services Costs (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate costs incurred during the reporting period related to financial services rendered by an entity."
        }
      ]
    },
    {
      "@id": "rs-gaap:FinancialServicesRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Financial Services Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate financial services revenue and operating interest income earned during the reporting period."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nc3a2c9958e6f43f18102f30c116f21fa"
        }
      ]
    },
    {
      "@id": "rs-gaap:FiniteLivedCustomerListsGross",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Gross carrying amount before accumulated amortization as of the balance sheet date of an asset comprised of customer information, acquired in a business combination or other transaction, having a finite beneficial life."
        }
      ]
    },
    {
      "@id": "rs-gaap:FiniteLivedCustomerRelationshipsGross",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Gross carrying amount before accumulated amortization as of the balance sheet date to an asset acquired in a business combination representing a favorable existing relationship with customers having a finite beneficial life."
        }
      ]
    },
    {
      "@id": "rs-gaap:FiniteLivedIntangibleAssetOffMarketLeaseFavorableGross",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Finite-Lived Intangible Asset, Off-market Lease, Favorable, Gross"
        }
      ]
    },
    {
      "@id": "rs-gaap:FiniteLivedIntangibleAssetsAccumulatedAmortization",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Finite-Lived Intangible Assets, Accumulated Amortization"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Accumulated amount of amortization of assets, excluding financial assets and goodwill, lacking physical substance with a finite life."
        }
      ]
    },
    {
      "@id": "rs-gaap:FiniteLivedIntangibleAssetsGross",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Finite-Lived Intangible Assets, Gross"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount before amortization of assets, excluding financial assets and goodwill, lacking physical substance with a finite life."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nf3cef7ce3d714aacada75a13f96c7ee7"
        }
      ]
    },
    {
      "@id": "rs-gaap:FiniteLivedIntangibleAssetsNet",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Finite-Lived Intangible Assets, Net"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount after amortization of assets, excluding financial assets and goodwill, lacking physical substance with a finite life."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N00bb04200cee4f23bd357469b3fb7204"
