      "@id": "rs-gaap:AccumulatedOtherComprehensiveIncomeLossForeignCurrencyTranslationAdjustmentNetOfTax",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Accumulated Other Comprehensive Income (Loss), Foreign Currency Translation Adjustment, Net of Tax"
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N212071b8e16442ac933e454eb37a3a5b"
        },
        {
          "@id": "_:N91efd1cbff8141679828aaad678fe531"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccumulatedOtherComprehensiveIncomeLossNetOfTax",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Accumulated change in equity from transactions and other events and circumstances from non-owner sources, net of tax effect, at period end. Excludes Net Income (Loss), and accumulated changes in equity from transactions resulting from investments by owners and distributions to owners. Includes foreign currency translation items, certain pension adjustments, unrealized gains and losses on certain investments in debt and equity securities, other than temporary impairment (OTTI) losses related to factors other than credit losses on available-for-sale and held-to-maturity debt securities that an entity does not intend to sell and it is not more likely than not that the entity will be required to sell before recovery of the amortized cost basis, as well as changes in the fair value of derivatives related to the effective portion of a designated cash flow hedge."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N8561e78969ae4fd298992f40cf4ea90e"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccumulatedOtherComprehensiveIncomeLossOtherThanTemporaryImpairmentNotCreditLossNetOfTaxAvailableforsaleDebtSecurities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Accumulated Other Comprehensive Income (Loss), Other than Temporary Impairment, Not Credit Loss, Net of Tax, Available-for-sale, Debt Securities"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccumulatedOtherComprehensiveIncomeLossOtherThanTemporaryImpairmentNotCreditLossNetOfTaxDebtSecurities",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N7ee9d6423a1b4514899d3e7dcefc48fb"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccumulatedOtherComprehensiveIncomeLossOtherThanTemporaryImpairmentNotCreditLossNetOfTaxHeldtomaturityDebtSecurities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Accumulated Other Comprehensive Income (Loss), Other than Temporary Impairment, Not Credit Loss, Net of Tax, Held-to-maturity, Debt Securities"
        }
      ]
    },
    {
      "@id": "rs-gaap:AdditionalPaidInCapital",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Excess of issue price over par or stated value of the entity's capital stock and amounts received from other transactions involving the entity's stock or stockholders. Includes adjustments to additional paid in capital. Some examples of such adjustments include recording the issuance of debt with a beneficial conversion feature and certain tax consequences of equity instruments awarded to employees. Use this element for the aggregate amount of additional paid-in capital associated with common and preferred stock. For additional paid-in capital associated with only common stock, use the element additional paid in capital, common stock. For additional paid-in capital associated with only preferred stock, use the element additional paid in capital, preferred stock."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N7e3088d9e5e2445599f5d9bc5c0efcbe"
        },
        {
          "@id": "_:Nd85a0c7e0e474d1f998d37743348ef5d"
        },
        {
          "@id": "_:Nf7c25a8804914bc6a62e9173b6092f5a"
        }
      ]
    },
    {
      "@id": "rs-gaap:AdditionalPaidInCapitalCommonStock",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N679cd08317d74940abe4dc37086bb617"
        },
        {
          "@id": "_:N859eb960c2a04027b0342ead344c9962"
        }
      ]
    },
    {
      "@id": "rs-gaap:AdditionalPaidInCapitalPreferredStock",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N6a87738f0f2d4745a429a18756487106"
        },
        {
          "@id": "_:Ne28d113c98f0440fb7c8c5ad98538ea0"
        }
      ]
    },
    {
      "@id": "rs-gaap:AdjustmentForAmortization",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N38d40eb7d29640959c1997e3b32d191e"
        }
      ]
    },
    {
      "@id": "rs-gaap:AdjustmentsNoncashItemsToReconcileNetIncomeLossToCashProvidedByUsedInOperatingActivities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Adjustments, Noncash Items, to Reconcile Net Income (Loss) to Cash Provided by (Used in) Operating Activities"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate amount of adjustments to net income or loss necessary to remove the effects of all items whose cash effects are investing or financing cash flows. The aggregate amount also includes all noncash expenses and income items which reduce or increase net income and are thus added back or deducted when calculating cash provided by or used in operating activities."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nc64525adf6d04a9485f506fc90164e9a"
        }
      ]
    },
    {
      "@id": "rs-gaap:AdjustmentsToReconcileNetIncomeLossToCashProvidedByUsedInOperatingActivities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Adjustments to Reconcile Net Income (Loss) to Cash Provided by (Used in) Operating Activities"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The sum of adjustments which are added to or deducted from net income or loss, including the portion attributable to noncontrolling interest, to reflect cash provided by or used in operating activities, in accordance with the indirect cash flow method."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N5d11310f5b5745aeb044fe29befc6d0a"
        }
      ]
    },
    {
      "@id": "rs-gaap:AdministrativeFeesExpense",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of expense for administrative services provided to the limited liability company (LLC) or limited partnership (LP) by the managing member or general partner, affiliate of managing member or general partner, or affiliate of LLC or LP, for example, but not limited to, salaries, rent, or overhead costs."
        }
      ]
    },
    {
      "@id": "rs-gaap:AdmissionsRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Admissions Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from  admissions (for example, tickets to parks, rides and attractions, theaters, sporting events, and movies), as well as patient admissions."
        }
      ]
    },
    {
      "@id": "rs-gaap:AdvertisingRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Advertising Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from the sale of advertising time (such as television and radio) or space (newspaper or magazine pages). May also include advertising, marketing and promotional services rendered during the reporting period."
        }
      ]
    },
    {
      "@id": "rs-gaap:AffordableHousingProjectInvestmentWriteDownAmount",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Affordable Housing Project Investment, Write-down, Amount"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of write-down from impairment of an investment in a qualified affordable housing project."
        }
      ]
    },
    {
      "@id": "rs-gaap:AgriculturalRelatedInventory",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nd4fc2254ad8e4a6a890663c0294ae675"
        }
      ]
    },
    {
      "@id": "rs-gaap:AircraftRental",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Aircraft Rental"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Expenses incurred related to the lease of aircraft from outside third parties that are used in the entity's business operations."
        }
      ]
    },
    {
      "@id": "rs-gaap:AircraftRentalAndLandingFees",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Aircraft Rental and Landing Fees"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Expenses incurred related to the lease of aircraft from outside third parties that are used in the entity's business operations and direct costs incurred at airports primarily consisting of fees paid to the airport authority for takeoff and landing, gate and facility fees, and other related fees."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Ned057d653e2444d3922b30e736d8d388"
        }
      ]
    },
    {
      "@id": "rs-gaap:AirlineRelatedInventory",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Airline Related Inventory, Gross"
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Ndc5e9e9a82c74e018bd2313b0f95dd14"
        }
      ]
    },
    {
      "@id": "rs-gaap:AllOtherSegmentsMember",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Other Segments [Member]"
        }
      ]
    },
    {
      "@id": "rs-gaap:AllocatedShareBasedCompensationExpense",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Share-based Payment Arrangement, Expense"
        }
      ]
    },
    {
      "@id": "rs-gaap:AllowanceForDoubtfulOtherReceivablesCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Allowance for Doubtful Other Receivables, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of valuation allowance for receivables classified as other, due within one year or the normal operating cycle, if longer."
        }
      ]
    },
    {
      "@id": "rs-gaap:AmortizationMethodQualifiedAffordableHousingProjectInvestments",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Amortization Method Qualified Affordable Housing Project Investments"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of investment in qualified affordable housing projects."
        }
      ]
    },
    {
      "@id": "rs-gaap:AmortizationOfDeferredCharges",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N070e98d011834b979a067f3b709e0971"
        }
      ]
    },
    {
      "@id": "rs-gaap:AmortizationOfFinancingCostsAndDiscounts",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nc21a23a4e7454b85b52f4ee69327373f"
        }
      ]
    },
    {
      "@id": "rs-gaap:AmortizationOfIntangibleAssets",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Amortization of Intangible Assets"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The aggregate expense charged against earnings to allocate the cost of intangible assets (nonphysical assets not used in production) in a systematic and rational manner to the periods expected to benefit from such assets. As a noncash expense, this element is added back to net income when calculating cash provided by or used in operations using the indirect method."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Ncf9a63730eac4b12a654ad311e3360c7"
        }
      ]
    },
    {
      "@id": "rs-gaap:AmortizationOfLeaseIncentives",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Amortization of Lease Incentives"
        }
      ]
    },
    {
      "@id": "rs-gaap:AmortizationOfNuclearFuelLease",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Amortization of Nuclear Fuel Lease"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The expense charged against earnings for the periodic recognition of capitalized nuclear fuel leases."
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetBackedSecuritiesAtCarryingValue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Asset-Backed Securities, at Carrying Value"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetImpairmentCharges",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Asset Impairment Charges"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of write-down of assets recognized in the income statement. Includes, but is not limited to, losses from tangible assets, intangible assets and goodwill."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nf5fd0494718c4d8f909368566c97256f"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetManagementFees1",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Asset Management Fees (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of fixed fee revenue for the management of an investment fund portfolio. Excludes investment advisory, distribution and servicing, and performance fees."
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetRetirementObligationCurrent",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N25cae92faa534abb84b5ce939c97a5fb"
        },
        {
          "@id": "_:N64cccaa3a17c42308ff6f7ba905adcd0"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetRetirementObligationsNoncurrent",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N1983a00485c64d5cba78e8e58e1b3f4a"
        }
      ]
    },
    {
      "@id": "rs-gaap:Assets",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Sum of the carrying amounts as of the balance sheet date of all assets that are recognized. Assets are probable future economic benefits obtained or controlled by an entity as a result of past transactions or events."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N29eea620d2c2491cb7a58fd404f1f22b"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetsCurrent",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Sum of the carrying amounts as of the balance sheet date of all assets that are expected to be realized in cash, sold, or consumed within one year (or the normal operating cycle, if longer). Assets are probable future economic benefits obtained or controlled by an entity as a result of past transactions or events."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N1941130ce1d142f194bf939682168f7c"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetsHeldForSaleNotPartOfDisposalGroupCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Assets Held-for-sale, Not Part of Disposal Group, Current"
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N479cb5b6929945d0b37b86443721f1b6"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetsHeldForSaleNotPartOfDisposalGroupCurrentOther",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Assets Held-for-sale, Not Part of Disposal Group, Current, Other"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetsHeldInTrustCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Assets Held-in-trust, Current"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetsHeldInTrustNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Assets Held-in-trust, Noncurrent"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetsNoncurrent",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nd20fc13fd6774e7e81cba136e7c0a02d"
        }
      ]
    },
    {
      "@id": "rs-gaap:AssetsOfDisposalGroupIncludingDiscontinuedOperationCurrent",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N929c85f909984b94b8ceb5d9de0aeb60"
        }
      ]
    },
    {
      "@id": "rs-gaap:BasisSwapMember",
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Interest-rate swap contract where both rates are variable but are tied to different index rates. For example, but not limited to, one party's rate indexed to three-month London Interbank Offered Rate (LIBOR) while the other party's rate is indexed to six-month LIBOR."
        }
      ]
    },
    {
      "@id": "rs-gaap:BenefitsLossesAndExpenses",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N91bebab38974435b9d63553868ece85a"
        }
      ]
    },
    {
      "@id": "rs-gaap:BuildingsAndImprovementsGross",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N00da1c1845264320be9556ea2eedd6a9"
        }
      ]
    },
    {
      "@id": "rs-gaap:BusinessCombinationAcquisitionRelatedCosts",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Business Combination, Acquisition Related Costs"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "This element represents acquisition-related costs incurred to effect a business combination which costs have been expensed during the period. Such costs include finder's fees; advisory, legal, accounting, valuation, and other professional or consulting fees; general administrative costs, including the costs of maintaining an internal acquisitions department; and may include costs of registering and issuing debt and equity securities."
        }
      ]
    },
    {
      "@id": "rs-gaap:BusinessCombinationContingentConsiderationArrangementsChangeInAmountOfContingentConsiderationAsset1",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Business Combination, Contingent Consideration Arrangements, Change in Amount of Contingent Consideration, Asset"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of increase (decrease) in the value of right to a contingent consideration asset."
        }
      ]
    },
    {
      "@id": "rs-gaap:BusinessCombinationContingentConsiderationArrangementsChangeInAmountOfContingentConsiderationLiability1",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Business Combination, Contingent Consideration Arrangements, Change in Amount of Contingent Consideration, Liability"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of increase (decrease) in the value of a contingent consideration liability, including, but not limited to, differences arising upon settlement."
        }
      ]
    },
    {
      "@id": "rs-gaap:BusinessCombinationIntegrationRelatedCosts",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Business Combination, Integration Related Costs"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Costs incurred to effect a business combination which have been expensed during the period. Such costs could include business integration costs, systems integration and conversion costs, and severance and other employee-related costs."
        }
      ]
    },
    {
      "@id": "rs-gaap:CapitalizedComputerSoftwareGross",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Capitalized Computer Software, Gross"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount before accumulated amortization of capitalized costs for computer software, including but not limited to, acquired and internally developed computer software."
        }
      ]
    },
    {
      "@id": "rs-gaap:CapitalizedSoftwareDevelopmentCostsForSoftwareSoldToCustomers",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Capitalized Software Development Costs for Software Sold to Customers"
        }
      ]
    },
    {
      "@id": "rs-gaap:CargoAndFreightRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cargo and Freight Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from transporting cargo and freight between locations."
        }
      ]
    },
    {
      "@id": "rs-gaap:Cash",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N32dd145611af4f978cfa6d5e299ba605"
        },
        {
          "@id": "_:Na4322dd788e04549adce7095270fcda9"
        }
      ]
    },
    {
      "@id": "rs-gaap:CashAndCashEquivalentsAtCarryingValue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cash and Cash Equivalents, at Carrying Value"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of currency on hand as well as demand deposits with banks or financial institutions. Includes other kinds of accounts that have the general characteristics of demand deposits. Also includes short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates. Excludes cash and cash equivalents within disposal group and discontinued operation."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N8168600204a341959f90c499fa0043a2"
        },
        {
          "@id": "_:Nbe3e98a1085b4a4ab326c9cc27b86688"
        },
        {
          "@id": "_:Nf39d2fcb00df46d9b792ee462d9ac60d"
        }
      ]
    },
    {
      "@id": "rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecrease",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cash and Cash Equivalents, Period Increase (Decrease)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of increase (decrease) in cash and cash equivalents. Cash and cash equivalents are the amount of currency on hand as well as demand deposits with banks or financial institutions. Includes other kinds of accounts that have the general characteristics of demand deposits. Also includes short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates. Includes effect from exchange rate changes."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N471bc3e3328a4f98b3b5cdbd3eddb036"
        }
      ]
    },
    {
      "@id": "rs-gaap:CashAndCashEquivalentsPeriodIncreaseDecreaseExcludingExchangeRateEffect",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cash and Cash Equivalents, Period Increase (Decrease), Excluding Exchange Rate Effect"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of increase (decrease) in cash and cash equivalents. Cash and cash equivalents are the amount of currency on hand as well as demand deposits with banks or financial institutions. Includes other kinds of accounts that have the general characteristics of demand deposits. Also includes short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates. Excludes effect from exchange rate changes."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N539d098d6cad450a8c9d29f44bada9a6"
        }
      ]
    },
    {
      "@id": "rs-gaap:CashAndDueFromBanks",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Na6d05b4b59dc4d61ac7db899522a6cfa"
        }
      ]
    },
    {
      "@id": "rs-gaap:CashCashEquivalentsAndShortTermInvestments",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cash, Cash Equivalents, and Short-term Investments"
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N3dae6a5ad34846c2b635a60b28eb60b1"
        }
      ]
    },
    {
      "@id": "rs-gaap:CashEquivalentsAtCarryingValue",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N90d48d91ab0e476f8a0428f8ac9fbe35"
        }
      ]
    },
    {
      "@id": "rs-gaap:CashPeriodIncreaseDecrease",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cash, Period Increase (Decrease)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of increase (decrease) in cash. Cash is the amount of currency on hand as well as demand deposits with banks or financial institutions. Includes other kinds of accounts that have the general characteristics of demand deposits. Includes effect from exchange rate changes."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N762ec5098f1646348ce51dcc9cc0caec"
        }
      ]
    },
    {
      "@id": "rs-gaap:CashProvidedByUsedInFinancingActivitiesDiscontinuedOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cash Provided by (Used in) Financing Activities, Discontinued Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) of financing activities of discontinued operations. Financing activity cash flows include obtaining resources from owners and providing them with a return on, and a return of, their investment; borrowing money and repaying amounts borrowed, or settling the obligation; and obtaining and paying for other resources obtained from creditors on long-term credit."
        }
      ]
    },
    {
      "@id": "rs-gaap:CashProvidedByUsedInInvestingActivitiesDiscontinuedOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cash Provided by (Used in) Investing Activities, Discontinued Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) of investing activities of discontinued operations. Investing activity cash flows include making and collecting loans and acquiring and disposing of debt or equity instruments and property, plant, and equipment and other productive assets."
        }
      ]
    },
    {
      "@id": "rs-gaap:CashProvidedByUsedInOperatingActivitiesDiscontinuedOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Cash Provided by (Used in) Operating Activities, Discontinued Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) of operating activities of discontinued operations. Operating activity cash flows include transactions, adjustments, and changes in value not defined as investing or financing activities."
        }
      ]
    },
    {
      "@id": "rs-gaap:CertificatesOfDepositAtCarryingValue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Certificates of Deposit, at Carrying Value"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "A savings certificate entitling the Entity (that is, bearer) to receive interest at an established maturity date, based upon a fixed interest rate.  A certificate of deposit may be issued in any denomination. Certificates of deposit are generally issued by commercial banks and, therefore, insured by the FDIC (up to the prescribed limit).  Certificates of deposit generally restrict holders from withdrawing funds on demand without the incurrence of penalties.  Generally, only certificates of deposit with original maturities of three months or less qualify as cash equivalents. Original maturity means original maturity to the entity holding the investment. As a related example, both a three-month US Treasury bill and a three-year Treasury note purchased three months from maturity qualify as cash equivalents. However, a Treasury note purchased three-years ago does not become a cash equivalent when its remaining maturity is three months."
        }
      ]
    },
    {
      "@id": "rs-gaap:ClearingFeesRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Clearing Fees Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from clearing fees. Clearing fees are charged by an exchange for each contract and trade cleared. There are also clearing fees associated with deliveries, creation of a futures position resulting from an option exercise or assignment, Exchange for Physicals (EFP), block trades, transfer trades and adjustments."
        }
      ]
    },
    {
      "@id": "rs-gaap:CoalProductsAndServicesRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Coal Products and Services Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue derived from sale of coal and related products. Also includes rendering of services and selling of products for exploration, development, mining, and processing, as well as supporting activities."
        }
      ]
    },
    {
      "@id": "rs-gaap:CommercialPaperAtCarryingValue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Commercial Paper, at Carrying Value"
        }
      ]
    },
    {
      "@id": "rs-gaap:CommercialPaperNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Long-term Commercial Paper, Noncurrent"
        }
      ]
    },
