    {
      "@id": "rs-gaap:MediumtermNotesCurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Medium-term Notes, Current"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Carrying value at the balance sheet date of the current portion of a financial instrument used to receive debt funding on a regular basis with original maturities ranging from 5-10 years."
        }
      ]
    },
    {
      "@id": "rs-gaap:MediumtermNotesNoncurrent",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Medium-term Notes, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Carrying value at the balance sheet date of the noncurrent portion of a financial instrument used to receive debt funding on a regular basis with original maturities ranging from 5-10 years."
        }
      ]
    },
    {
      "@id": "rs-gaap:MembersEquity",
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nb4f2f8d060e34b8db07154abac5d4454"
        }
      ]
    },
    {
      "@id": "rs-gaap:MembershipDuesRevenueOnGoing",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Membership Dues Revenue, On-going (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue earned during the period from periodic fees charged to existing members of an association or club. An example would be the monthly/annual dues paid to a gym or workout facility. This element excludes the initial membership fees received on enrollment or registration."
        }
      ]
    },
    {
      "@id": "rs-gaap:MinorityInterest",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Stockholders' Equity Attributable to Noncontrolling Interest"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Total of all stockholders' equity (deficit) items, net of receivables from officers, directors, owners, and affiliates of the entity which is directly or indirectly attributable to that ownership interest in subsidiary equity which is not attributable to the parent (that is, noncontrolling interest, previously referred to as minority interest)."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N38a783b36c6c45cfa018e4d4df0c8f3c"
        },
        {
          "@id": "_:Nb30db98742434f75ba94e93a05b22254"
        },
        {
          "@id": "_:Nc562def8d1b8418ebbb8bae868c611f6"
        }
      ]
    },
    {
      "@id": "rs-gaap:MoneyMarketFundsAtCarryingValue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Money Market Funds, at Carrying Value"
        }
      ]
    },
    {
      "@id": "rs-gaap:MunicipalDebtSecuritiesAtCarryingValue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Municipal Debt Securities, at Carrying Value"
        }
      ]
    },
    {
      "@id": "rs-gaap:NaturalGasProductionRevenue",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Natural Gas Production Revenue (Deprecated 2018-01-31)"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Revenue from natural gas production during the reporting period. Natural gas consists largely of the hydrocarbon methane, and is found in underground formations either by itself or with crude oil."
        }
      ]
    },
    {
      "@id": "rs-gaap:NetCashProvidedByUsedInContinuingOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Net Cash Provided by (Used in) Continuing Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "The increase (decrease) in cash associated with the entity's continuing operating, investing, and financing activities. While for technical reasons this element has no balance attribute, the default assumption is a debit balance consistent with its label."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N2d1837f2c44849349b6c362b05714e5c"
        }
      ]
    },
    {
      "@id": "rs-gaap:NetCashProvidedByUsedInDiscontinuedOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Net Cash Provided by (Used in) Discontinued Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Increase (decrease) in cash associated with the entity's discontinued operations."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N5bb3ef6e25a2411c9280a63221312d70"
        }
      ]
    },
    {
      "@id": "rs-gaap:NetCashProvidedByUsedInFinancingActivities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Net Cash Provided by (Used in) Financing Activities"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) from financing activities, including discontinued operations. Financing activity cash flows include obtaining resources from owners and providing them with a return on, and a return of, their investment; borrowing money and repaying amounts borrowed, or settling the obligation; and obtaining and paying for other resources obtained from creditors on long-term credit."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N7bf215254f5b45118d8ae82d60181952"
        }
      ]
    },
    {
      "@id": "rs-gaap:NetCashProvidedByUsedInFinancingActivitiesContinuingOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Net Cash Provided by (Used in) Financing Activities, Continuing Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) of financing activities, excluding discontinued operations. Financing activity cash flows include obtaining resources from owners and providing them with a return on, and a return of, their investment; borrowing money and repaying amounts borrowed, or settling the obligation; and obtaining and paying for other resources obtained from creditors on long-term credit."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N7d94947050b94ae5ac0de213cb1bdb82"
        }
      ]
    },
    {
      "@id": "rs-gaap:NetCashProvidedByUsedInInvestingActivities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Net Cash Provided by (Used in) Investing Activities"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) from investing activities, including discontinued operations. Investing activity cash flows include making and collecting loans and acquiring and disposing of debt or equity instruments and property, plant, and equipment and other productive assets."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nbf1da7071e4244acb47ce20e3a86ed1a"
        }
      ]
    },
    {
      "@id": "rs-gaap:NetCashProvidedByUsedInInvestingActivitiesContinuingOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Net Cash Provided by (Used in) Investing Activities, Continuing Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) of investing activities, excluding discontinued operations. Investing activity cash flows include making and collecting loans and acquiring and disposing of debt or equity instruments and property, plant, and equipment and other productive assets."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N78993161e8b34a28a16749b396f38ffe"
        }
      ]
    },
    {
      "@id": "rs-gaap:NetCashProvidedByUsedInOperatingActivities",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Net Cash Provided by (Used in) Operating Activities"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) from operating activities, including discontinued operations. Operating activity cash flows include transactions, adjustments, and changes in value not defined as investing or financing activities."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:N621da7edd8ae42889119d05c06dd75c4"
        }
      ]
    },
    {
      "@id": "rs-gaap:NetCashProvidedByUsedInOperatingActivitiesContinuingOperations",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@language": "en-US",
          "@value": "Net Cash Provided by (Used in) Operating Activities, Continuing Operations"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Amount of cash inflow (outflow) from operating activities, excluding discontinued operations. Operating activity cash flows include transactions, adjustments, and changes in value not defined as investing or financing activities."
        }
      ],
      "https://robosystems.ai/vocab/labelRole": [
        {
          "@id": "_:Nf88a570bd443479784104c068ea46a5c"
        }
      ]
    },
