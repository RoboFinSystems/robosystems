        {
          "@language": "en-US",
          "@value": "Long-term Transition Bond, Noncurrent"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Long-Term transition bonds are bonds under the Competition Act in which the proceeds of Transition Bonds are required to be used principally to reduce qualified stranded costs and the related capitalization of the utility.  This represents the noncurrent portion."
        }
      ]
    },
    {
      "@id": "rs-gaap:LongtermFederalHomeLoanBankAdvancesNoncurrent",
