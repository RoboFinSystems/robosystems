  "standard": "rs-gaap-disclosures",
  "version": "v1",
  "taxonomy_type": "reporting_extension",
  "namespace_uri": "https://robosystems.ai/taxonomy/rs-gaap/disclosures/v1/",
  "origin": "native",
  "created_at": "2026-05-10",
  "description": "RoboSystems-authored named Disclosures for the rs-gaap reporting framework. Each disclosure is an abstract qname-addressable element (so DM rule arcs can reference it as arcFrom/arcTo) and also a Structure with conceptArrangementPattern + secType metadata (so the renderer can dispatch by CAP). Composes with rs-gaap-disclosure-mechanics for structural rules and bridges/rs-gaap-disclosures-to-rs-gaap-textblocks for SEC text-block equivalence. Mirrors the layered vocabulary from Charlie Hoffman's Seattle Method (Disclosure topic + Concept Arrangement Pattern + SEC Type) but anchored to rs-gaap concepts rather than us-gaap.",
  "@graph": [
    {
      "@id": "disclosures:BalanceSheet",
      "label": "Balance Sheet",
      "elementType": "abstract",
      "periodType": "duration",
      "abstract": true,
      "roleUri": "https://robosystems.ai/seattle/cm-roles/roles/disclosures/BalanceSheet",
      "structureName": "Balance Sheet",
      "blockType": "balance_sheet",
      "conceptArrangementPattern": "set",
      "secType": "statement"
    },
