  "standard": "rs-gaap-calculations",
  "version": "v1",
  "taxonomy_type": "mapping",
  "namespace_uri": "https://robosystems.ai/taxonomy/rs-gaap/calculations/",
  "origin": "native",
  "created_at": "2026-05-14",
  "description": "RoboSystems calculation arcs for rs-gaap. Pure rs-gaap-on-rs-gaap: every parent and every child is a rs-gaap concept. Defines the reporting-layer calc DAG that turns mapped leaves into curated subtotals and the final NetIncomeLoss / Assets = LiabilitiesAndStockholdersEquity bottom lines. FAC structural anchors are out of the reporting layer; FAC's role is CoA classification only.",
  "@graph": [
    {
      "@id": "_:rs-gaap-calc-is-rev",
      "roleUri": "https://robosystems.ai/seattle/cm-roles/roles/rs-gaap-calculations/IS-Rev",
      "structureName": "rs-gaap calc IS-Rev — rs-gaap:Revenues = Σ rs-gaap revenue leaves",
      "blockType": "validation_rules",
      "conceptArrangementPattern": "arithmetic"
    },
    {
      "@id": "_:rs-gaap-calc-is-rev-arc-2",
      "from": {
        "@id": "rs-gaap:Revenues"
      },
      "to": {
        "@id": "rs-gaap:RevenueFromContractWithCustomerExcludingAssessedTax"
      },
      "associationType": "calculation",
      "role": "https://robosystems.ai/seattle/cm-roles/roles/rs-gaap-calculations/IS-Rev",
      "weight": 1.0,
      "order": 100.0,
      "@type": "rs:Association",
      "arcrole": "http://www.xbrl.org/2003/arcrole/summation-item"
    },
    {
      "@id": "_:rs-gaap-calc-is-cor",
      "roleUri": "https://robosystems.ai/seattle/cm-roles/roles/rs-gaap-calculations/IS-COR",
      "structureName": "rs-gaap calc IS-COR — rs-gaap:CostOfRevenue = Σ rs-gaap COGS leaves",
      "blockType": "validation_rules",
      "conceptArrangementPattern": "arithmetic"
    },
