      "ruleCategory": "FundamentalAccountingConceptRelation",
      "rulePattern": "RollUp",
      "ruleExpression": "$CostOfRevenue = ($CostOfGoodsSold + $CostOfGoodsSoldExcludingDepreciationDepletionAndAmortization + $OtherCostOfOperatingRevenue)",
