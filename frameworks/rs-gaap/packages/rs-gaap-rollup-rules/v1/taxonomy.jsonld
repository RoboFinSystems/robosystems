    {
      "@id": "_:rs-gaap-rollup-is-grossprofit",
      "ruleCategory": "FundamentalAccountingConceptRelation",
      "rulePattern": "RollUp",
      "ruleExpression": "$GrossProfit = ($Revenues - $CostOfRevenue)",
      "ruleTarget": {
        "targetKind": "element",
        "targetRef": "rs-gaap:GrossProfit"
      },
      "ruleVariables": [
