        },
        {
          "variableName": "GainLossOnDispositionOfAssets",
          "variableQname": "rs-gaap:GainLossOnDispositionOfAssets"
        },
        {
          "variableName": "OtherNonoperatingIncomeExpense",
          "variableQname": "rs-gaap:OtherNonoperatingIncomeExpense"
        }
