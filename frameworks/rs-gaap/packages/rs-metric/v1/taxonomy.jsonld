      "@id": "https://robosystems.ai/vocab/ruleVariables",
      "@container": "@list"
    },
    "variableName": {
      "@id": "https://robosystems.ai/vocab/variableName"
    },
    "variableQname": {
      "@id": "https://robosystems.ai/vocab/variableQname"
    },
    "ruleMessage": {
      "@id": "https://robosystems.ai/vocab/ruleMessage"
    },
    "ruleSeverity": {
