      "@id": "link:order",
      "@type": "xsd:decimal"
    },
    "associationType": {
      "@id": "https://robosystems.ai/vocab/associationType"
    },
    "label": "rdfs:label",
    "documentation": "rdfs:comment",
    "structureName": {
      "@id": "https://robosystems.ai/vocab/structureName"
    },
