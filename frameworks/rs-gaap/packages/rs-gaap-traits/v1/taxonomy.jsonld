  "standard": "rs-gaap-traits",
  "version": "v1",
  "taxonomy_type": "trait-assignment",
  "namespace_uri": "https://robosystems.ai/taxonomy/rs-gaap-traits/v1/",
  "origin": "native",
  "created_at": "2026-04-20",
  "description": "Per-element trait bindings for rs-gaap — seeds the `element_traits` junction by linking each rs-gaap concept to one or more trait members from the universal `fac-traits/v1` vocabulary. Built from FASB traitConcept arcs, propagated transitively through the classSubclass hierarchy so that descendants inherit anchor traits (e.g. CashAndCashEquivalents inherits elementsOfFinancialStatements=asset from its ancestor Assets). Future peer frameworks (rs-ifrs, rs-call-report, rs-statutory) each ship their own `*-traits/v1` package binding their own elements to the same fac-traits vocabulary.",
  "@graph": [
    {
      "@id": "rs-gaap:AccountsNotesAndLoansReceivableNetCurrent",
      "https://robosystems.ai/vocab/hasTrait": [
        {
          "@id": "trait:activityType/operatingActivity"
        },
