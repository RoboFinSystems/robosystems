      ],
      "rdfs:comment": [
        {
          "@value": "The change in cash during the period due to the net increase or decrease in outstanding checks, the liability that represents checks that have been issued but that have not cleared. The entity may classify these cash flows as financing or operating activities. Another element, Increase (Decrease) in Outstanding Checks, Financing Activities, represents cash flows from outstanding checks classified as financing activities.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:IncreaseDecreaseInOverEnergyRecovery",
