      "rdfs:label": [
        {
          "@value": "Proceeds from Repayment of Loans by Employee Stock Ownership Plans",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "The cash inflow from the financed defined contribution plan to acquire shares of the entity. The plan initially holds the shares in a suspense account, which is collateral for the loan. As the plan makes payment on the debt, the shares are released from the suspense account and become available to be allocated to participant accounts.",
          "@language": "en"
        }
      ]
    },
