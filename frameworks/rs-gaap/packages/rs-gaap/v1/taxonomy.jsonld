    {
      "@id": "rs-gaap:DecommissioningFundInvestments",
      "balance": [
        {
          "@value": "debit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
