    {
      "@id": "rs-gaap:ElectricityGenerationMember",
      "http://purl.org/dc/terms/references": [
        {
          "@id": "_:N404ff548ebd542d2b01586988182f369"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@language": "en-US",
          "@value": "Process of producing electric energy by transforming other forms of energy, including, but not limited to, nuclear, fossil fuel, solar, geothermal, hydro and wind."
