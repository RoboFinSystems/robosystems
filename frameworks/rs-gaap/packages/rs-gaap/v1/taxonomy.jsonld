      ],
      "rdfs:label": [
        {
          "@value": "Separated Host Financial Instrument, Fair Value Option [Member]",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "This element represents a host financial instrument resulting from the separation of an embedded nonfinancial derivative instrument from a nonfinancial hybrid instrument (as defined) (for example, an instrument in which the value of the bifurcated embedded derivative is payable in cash, services, or merchandise but the debt host is payable only in cash).",
          "@language": "en"
        }
      ]
    },
