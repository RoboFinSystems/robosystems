      ],
      "rdfs:comment": [
        {
          "@value": "Borrowing with the highest claim on the assets of the entity in event of bankruptcy or liquidation.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:SeniorLongTermNotes",
