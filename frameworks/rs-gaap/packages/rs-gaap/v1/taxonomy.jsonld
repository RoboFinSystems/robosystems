    {
      "@id": "rs-gaap:RestrictedCashAndInvestmentsCurrent",
      "balance": [
        {
          "@value": "debit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
