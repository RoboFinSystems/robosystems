      ],
      "rdfs:label": [
        {
          "@value": "Deferred Costs, Current",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Sum of the carrying amounts as of the balance sheet date of deferred costs capitalized at the end of the reporting period that are expected to be charged against earnings within one year or the normal operating cycle, if longer.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:DeferredCostsLeasingNetCurrent",
      "balance": [
        {
          "@value": "debit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
