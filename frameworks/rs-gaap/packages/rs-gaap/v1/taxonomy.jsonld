          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount of increase (decrease) in direct negative costs incurred in the physical production of a film. Examples include, but are not limited to, costs of story and scenario, compensation, set construction and postproduction costs.",
          "@language": "en"
        }
      ]
    },
