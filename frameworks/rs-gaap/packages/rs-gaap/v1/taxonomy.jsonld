      "rdfs:label": [
        {
          "@value": "Deconsolidation, Gain (Loss), Amount",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount of gain (loss) from deconsolidation of subsidiary and derecognition of group of assets constituting transfer of business or nonprofit activity, excluding conveyance of oil and gas mineral rights and transfer of good or service in contract with customer.",
          "@language": "en"
        }
      ]
    },
