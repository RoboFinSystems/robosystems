      ],
      "rdfs:label": [
        {
          "@value": "Cash Provided by (Used in) Financing Activity, Discontinued Operation",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount of cash inflow (outflow) from financing activity attributable to discontinued operation. Financing activity includes, but is not limited to, obtaining resource from owner and providing return on, and return of, their investment; borrowing money and repaying amount borrowed, or settling obligation; and obtaining and paying for other resource obtained from creditor on long-term credit.",
          "@language": "en"
        }
      ]
    },
    {
