  "standard": "rs-gaap",
  "version": "v1",
  "taxonomy_type": "reporting_standard",
  "namespace_uri": "https://robosystems.ai/taxonomy/rs-gaap/v1/",
  "forked_from": {
    "author": "FASB us-gaap 2026 (XBRL-intrinsic attributes only); bootstrapped 2026-04-19 from Charlie Hoffman's FAC→us-gaap mapping",
    "url": "http://fasb.org/us-gaap/2026",
    "format": "XBRL taxonomy (FASB authoritative)"
  },
  "forked_at": "2026-04-20",
  "description": "rs-gaap v1 — RoboSystems canonical reporting taxonomy. ~2,000 elements curated from FASB us-gaap 2026. Each concept carries only XBRL-intrinsic attributes (balance, periodType, abstract, monetary, elementType, substitutionGroup) plus labels, documentation, and deprecation status. Trait vocabulary lives in fac-traits/v1/ (inherited via the framework's depends_on); per-element trait bindings live in rs-gaap-traits/v1/; hierarchy in rs-gaap-hierarchy/v1/.",
  "@graph": [
    {
      "@id": "rs-gaap:AccountsNotesAndLoansReceivableNetCurrent",
      "balance": [
        {
          "@value": "debit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/substitutionGroup": [
        {
          "@id": "xbrli:item"
        }
      ],
      "https://robosystems.ai/vocab/source": [
        {
          "@value": "rs-gaap"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Accounts and Financing Receivable, after Allowance for Credit Loss, Current",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount, after allowance for credit loss, of accounts and financing receivables, classified as current. Includes, but is not limited to, notes and loan receivable.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccountsPayableAndAccruedLiabilitiesCurrent",
      "balance": [
        {
          "@value": "credit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/substitutionGroup": [
        {
          "@id": "xbrli:item"
        }
      ],
      "https://robosystems.ai/vocab/source": [
        {
          "@value": "rs-gaap"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Accounts Payable and Accrued Liabilities, Current",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Sum of the carrying values as of the balance sheet date of obligations incurred through that date and due within one year (or the operating cycle, if longer), including liabilities incurred (and for which invoices have typically been received) and payable to vendors for goods and services received, taxes, interest, rent and utilities, accrued salaries and bonuses, payroll taxes and fringe benefits.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccountsPayableAndAccruedLiabilitiesCurrentAndNoncurrent",
      "balance": [
        {
          "@value": "credit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/substitutionGroup": [
        {
          "@id": "xbrli:item"
        }
      ],
      "https://robosystems.ai/vocab/source": [
        {
          "@value": "rs-gaap"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Accounts Payable and Accrued Liabilities",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Sum of the carrying values as of the balance sheet date of obligations incurred through that date, including liabilities incurred and payable to vendors for goods and services received, taxes, interest, rent and utilities, compensation costs, payroll taxes and fringe benefits (other than pension and postretirement obligations), contractual rights and obligations, and statutory obligations.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccountsPayableAndAccruedLiabilitiesNoncurrent",
      "balance": [
        {
          "@value": "credit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/substitutionGroup": [
        {
          "@id": "xbrli:item"
        }
      ],
      "https://robosystems.ai/vocab/source": [
        {
          "@value": "rs-gaap"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Accounts Payable and Accrued Liabilities, Noncurrent",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Sum of the carrying values as of the balance sheet date of obligations incurred through that date and due after one year (or beyond the operating cycle if longer), including liabilities for compensation costs, fringe benefits other than pension and postretirement obligations, rent, contractual rights and obligations, and statutory obligations.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccountsPayableCurrent",
      "balance": [
        {
          "@value": "credit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/substitutionGroup": [
        {
          "@id": "xbrli:item"
        }
      ],
      "https://robosystems.ai/vocab/source": [
        {
          "@value": "rs-gaap"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Accounts Payable, Current",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Carrying value as of the balance sheet date of liabilities incurred (and for which invoices have typically been received) and payable to vendors for goods and services received that are used in an entity's business. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer).",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccountsPayableInterestBearingCurrent",
      "balance": [
        {
          "@value": "credit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
        {
          "@value": "concept"
        }
      ],
      "https://robosystems.ai/vocab/substitutionGroup": [
        {
          "@id": "xbrli:item"
        }
      ],
      "https://robosystems.ai/vocab/source": [
        {
          "@value": "rs-gaap"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Accounts Payable, Interest-Bearing, Current",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Carrying value as of the balance sheet date of obligations incurred and payable to vendors that bear interest at either a stated or an imputed rate. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer).",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:AccountsPayableInterestBearingNoncurrent",
