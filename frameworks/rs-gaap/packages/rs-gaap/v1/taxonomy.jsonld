    {
      "@id": "rs-gaap:FairValueOptionOtherEligibleItemsMember",
      "periodType": [
        {
          "@value": "duration"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
