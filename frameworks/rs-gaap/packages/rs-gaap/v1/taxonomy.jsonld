      "rdfs:label": [
        {
          "@value": "Accounts Payable, Interest-Bearing, Noncurrent",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Carrying value as of the balance sheet date of obligations incurred and due after one year (or beyond the operating cycle if longer) to vendors that bear interest at either a stated or an imputed rate.",
          "@language": "en"
        }
      ]
    },
