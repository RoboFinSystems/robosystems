    {
      "@id": "rs-gaap:TemporaryEquityCarryingAmountAttributableToParent",
      "balance": [
        {
          "@value": "credit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
        {
          "@type": "xsd:boolean",
          "@value": false
        }
      ],
      "https://robosystems.ai/vocab/monetary": [
        {
          "@type": "xsd:boolean",
          "@value": true
        }
      ],
      "https://robosystems.ai/vocab/elementType": [
