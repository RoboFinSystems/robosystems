      "rdfs:label": [
        {
          "@value": "Cash Provided by (Used in) Operating Activity, Discontinued Operation",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount of cash inflow (outflow) from operating activity attributable to discontinued operation. Operating activity includes, but is not limited to, transaction, adjustment, and change in value not defined as investing or financing activity.",
          "@language": "en"
        }
      ]
    },
