        {
          "@value": "Increase (Decrease) in Payable to Broker-Dealer and Clearing Organization",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "The increase (decrease) during the reporting period in the aggregate amount of obligations incurred arising from transactions with broker-dealers, such as amounts due on margin and unsettled cash transactions; includes payables to brokers, dealers and clearing organizations.",
          "@language": "en"
        }
      ]
    },
    {
