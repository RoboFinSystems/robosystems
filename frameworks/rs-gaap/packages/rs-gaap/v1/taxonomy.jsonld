      "rdfs:label": [
        {
          "@value": "Asset Retirement Obligation, Current",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Current portion of the carrying amount of a liability for an asset retirement obligation. An asset retirement obligation is a legal obligation associated with the disposal or retirement of a tangible long-lived asset that results from the acquisition, construction or development, or the normal operations of a long-lived asset, except for certain obligations of lessees.",
          "@language": "en"
        }
      ]
    },
