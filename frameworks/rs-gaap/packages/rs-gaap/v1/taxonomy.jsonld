          "@value": "Asset Retirement Obligation, Accretion Expense",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount of accretion expense recognized during the period that is associated with an asset retirement obligation. Accretion expense measures and incorporates changes due to the passage of time into the carrying amount of the liability.",
          "@language": "en"
        }
      ]
    },
    {
