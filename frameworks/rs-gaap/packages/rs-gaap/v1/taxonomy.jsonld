      ],
      "rdfs:label": [
        {
          "@value": "Cash Equivalent, Credit and Debit Card Receivables, Carrying Value",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount due the Entity as a result of customers utilizing point of sale debit or credit cards in exchange transactions with the entity which are short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates. Generally, only investments with original maturities of three months or less qualify under that definition.",
          "@language": "en"
        }
      ]
    },
