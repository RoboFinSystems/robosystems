      "rdfs:comment": [
        {
          "@value": "Carrying value as of the balance sheet date of long-term unsecured obligations issued by corporations and other borrowers to investors (with maturities initially due after one year or beyond the operating cycle if longer), excluding current portion.",
          "@language": "en"
        }
      ]
