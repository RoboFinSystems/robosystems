        {
          "@value": "Interest Payable, Current",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Carrying value as of the balance sheet date of [accrued] interest payable on all forms of debt, including trade payables, that has been incurred and is unpaid. Used to reflect the current portion of the liabilities (due within one year or within the normal operating cycle if longer).",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:InterestRateCapMember",
      "periodType": [
        {
          "@value": "duration"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
