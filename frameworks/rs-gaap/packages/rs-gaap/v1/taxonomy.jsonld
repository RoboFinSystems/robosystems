      "rdfs:label": [
        {
          "@value": "Cash Provided by (Used in) Investing Activity, Discontinued Operation",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount of cash inflow (outflow) from investing activity attributable to discontinued operation. Investing activity includes, but is not limited to, making and collecting loan, acquiring and disposing of debt and equity instruments, property, plant, and equipment, and other productive assets.",
          "@language": "en"
        }
      ]
    },
