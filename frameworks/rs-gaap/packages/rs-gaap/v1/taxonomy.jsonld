        }
      ],
      "rdfs:label": [
        {
          "@value": "Special Assessment Bond, Current",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "The current portion of the carrying value as of the balance sheet date of a type of municipal bond typically used to fund a development project. Also called special assessment limited liability bond, special district bond, special purpose bond, special tax bond and community development obligation. Interest owed to lenders is paid by taxes levied on the community benefiting from the particular bond-funded project. For example, if a bond of this sort was issued to pay for sidewalks to be repaved in a certain community, an additional tax would be levied on homeowners in the area benefiting from this project.",
          "@language": "en"
        }
      ]
    },
