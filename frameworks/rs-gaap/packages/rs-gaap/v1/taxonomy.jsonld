          "@value": "rs-gaap"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Commercial Paper",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Carrying value as of the balance sheet date of short-term borrowings using unsecured obligations issued by banks, corporations and other borrowers to investors. The maturities of these money market securities generally do not exceed 270 days.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:CommercialPaperAtCarryingValue",
      "balance": [
        {
          "@value": "debit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
