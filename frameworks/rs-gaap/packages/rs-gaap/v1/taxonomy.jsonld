      "rdfs:label": [
        {
          "@value": "Amortization of Regulatory Asset",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "The expense charged against earnings during the period to allocate the capitalized costs of regulatory assets over the periods expected to benefit from such costs.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "rs-gaap:AmortizationOfValueOfBusinessAcquiredVOBA",
      "balance": [
        {
          "@value": "debit"
        }
      ],
      "periodType": [
        {
          "@value": "duration"
        }
      ],
