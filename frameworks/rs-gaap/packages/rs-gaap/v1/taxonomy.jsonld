      "rdfs:label": [
        {
          "@value": "Unsolicited Tender Offer Costs",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Costs incurred in connection with an unsolicited tender offer (one where the Entity being sought has not requested the offer). These would include costs relating to evaluation and dissemination of information regarding an unsolicited tender offer. A tender offer is a broad solicitation by an Entity or a third party to purchase a substantial percentage of another entity's shares or units for a limited period of time. The offer is at a fixed price, usually at a premium over the current market price, and is contingent on shareholders' tendering a fixed number of their shares or units.",
          "@language": "en"
        }
      ]
    },
