      "rdfs:label": [
        {
          "@value": "Amortization and Depreciation of Decontaminating and Decommissioning Assets",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "The current period expense charged against earnings on decontaminating and decommissioning of facilities used in the normal conduct of business and not intended for resale to allocate or recognize the cost of the assets over their useful lives.",
          "@language": "en"
        }
      ]
    },
