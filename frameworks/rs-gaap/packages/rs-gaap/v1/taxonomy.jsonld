    {
      "@id": "rs-gaap:LinesOfCreditCurrent",
      "balance": [
        {
          "@value": "credit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
