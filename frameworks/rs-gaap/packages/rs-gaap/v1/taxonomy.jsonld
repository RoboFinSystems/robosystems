    {
      "@id": "rs-gaap:CertificatesOfDepositAtCarryingValue",
      "balance": [
        {
          "@value": "debit"
        }
      ],
      "periodType": [
        {
          "@value": "instant"
        }
      ],
      "https://robosystems.ai/vocab/abstract": [
