        }
      ],
      "rdfs:label": [
        {
          "@value": "Mortgage Servicing Rights (MSR) Impairment (Recovery)",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "The adjustment to the carrying value of the rights retained or purchased to service mortgages. These adjustments are made when the estimate of the fair value is changed. This element is a noncash adjustment to net income when calculating net cash generated by operating activities using the indirect method.",
          "@language": "en"
        }
      ]
    },
