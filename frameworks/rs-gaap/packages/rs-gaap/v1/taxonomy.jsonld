      "rdfs:comment": [
        {
          "@value": "The periodic expense to reduce the value of the rate deferral asset that is created when utilities under bill customers during periods of rate increases by deferring rate increases. These customers eventually pay higher rates to repay the utility for the rate deferral.",
          "@language": "en"
        }
      ]
    },
    {
