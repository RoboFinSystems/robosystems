      "rdfs:comment": [
        {
          "@value": "The remaining balance of debt issuance expenses that were capitalized and are being amortized against income over the lives of the respective bond issues. This does not include the amounts capitalized as part of the cost of the utility plant or asset.",
          "@language": "en"
        }
      ]
