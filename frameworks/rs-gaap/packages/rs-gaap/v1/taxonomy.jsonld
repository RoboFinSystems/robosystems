      "rdfs:label": [
        {
          "@value": "Investment, Proportional Amortization Method, Elected, Amount",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount of investment that generates income tax credit and other income tax benefit under tax credit program elected to be accounted for using proportional amortization method. Includes, but is not limited to, investment under program not meeting condition for accounting under proportional amortization method.",
          "@language": "en"
        }
      ]
    },
