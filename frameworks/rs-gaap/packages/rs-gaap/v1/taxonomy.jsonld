          "@value": "Securities Loaned",
          "@language": "en"
        }
      ],
      "rdfs:comment": [
        {
          "@value": "Amount, after the effects of master netting arrangements, of securities loaned to entities in exchange for collateral. Includes liabilities not subject to a master netting arrangement and not elected to be offset.",
          "@language": "en"
        }
      ]
    },
    {
